{
  "name": "aisworg",
  "version": "1.0.0",
  "description": "AI SEU Platform",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/app.js",
    "dev": "tsx watch src/app.js",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:seu": "tsx src/dblayer/migrations/run.ts",
    "seed:seu": "tsx src/dblayer/seed/seedSeu.ts",
    "pack:validate": "tsx src/dblayer/seed/pack-sdk-cli.ts validate",
    "pack:publish": "tsx src/dblayer/seed/pack-sdk-cli.ts publish",
    "test": "NODE_ENV=test node --import tsx --test tests/**/*.test.js tests/**/*.test.ts",
    "test:spec": "NODE_ENV=test node --import tsx --test --test-reporter=spec tests/**/*.test.js tests/**/*.test.ts",
    "test:junit": "NODE_ENV=test node --import tsx --test --test-reporter=junit --test-reporter-destination=test-results.xml tests/**/*.test.js tests/**/*.test.ts",
    "test:mocha": "NODE_ENV=test mocha tests/**/*.test.js",
    "test:coverage": "NODE_ENV=test c8 node --import tsx --test tests/**/*.test.js tests/**/*.test.ts"
  },
  "keywords": [],
  "author": "Sudha Manimaran",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "compromise": "^14.15.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "fetch-cookie": "^3.2.0",
    "marked": "^18.0.4",
    "msedge-tts": "^2.0.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.19.0",
    "sanitize-html": "^2.17.4",
    "scrollama": "^3.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.3",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
