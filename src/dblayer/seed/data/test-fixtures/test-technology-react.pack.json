            "configurableKey": "type",
            "configurableValue": "required"
          },
          {
            "statement": "Create a separate folder for routes for a specific page and import all components and map them with the routes.",
            "group": "Routing & Project Structure",
            "configurableKey": "type",
            "configurableValue": "required"
