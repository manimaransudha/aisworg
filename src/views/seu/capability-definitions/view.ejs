<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .role-group { border-top: 2px solid #6c757d; }
    .role-group tr:not(:last-child) > td:not([rowspan]) { border-bottom-style: dashed; border-bottom-color: #ced4da; }
  </style>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <%
      var _label = function (map, code) { return map[code] || code; };
      var _roles = capability.roles || [];
    %>

    <div class="mb-2">
      <a href="/aisworg/seu/capability-definitions" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>All Capabilities</a>
    </div>

    <div class="mb-4">
      <h2 class="h3 mb-2 text-dark fw-bold">Capability Definition: <%= capability.default_label %></h2>
      <div class="d-flex align-items-center gap-2">
        <span class="state-badge state-<%= capability.status %>"><%= capability.status %></span>
        <code class="text-muted"><%= capability.code %></code>
      </div>
      <% if (locals.activeServiceId) { %>
        <div class="mt-2"><a href="/aisworg/seu/service-definitions/<%= activeServiceId %>" class="small text-decoration-none"><i class="bi bi-box-seam me-1"></i>View the Service offered</a></div>
      <% } %>
    </div>

    <div class="section-card">
      <div class="section-header"><span class="lp-toggle-title">Details</span></div>
      <div class="p-3">
        <div class="mb-3">
          <div class="small text-muted">Category</div>
          <div><%= _label(labels.category, capability.category) %></div>
        </div>
        <div>
          <div class="small text-muted">Description</div>
          <div><%= capability.description || '—' %></div>
        </div>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header"><span class="lp-toggle-title">Roles and Worktypes</span></div>
      <% if (_roles.length === 0) { %>
        <div class="p-3 small text-muted">This Capability has no Roles.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr><th scope="col" style="width: 50%;">Role</th><th scope="col">Worktype</th></tr>
            </thead>
              <% _roles.forEach(function (role) { %>
                <% var _wts = role.worktypes && role.worktypes.length ? role.worktypes : [null]; %>
                <tbody class="role-group">
                <% _wts.forEach(function (wt, i) { %>
                  <tr>
                    <% if (i === 0) { %>
                      <td rowspan="<%= _wts.length %>">
                        <div><%= _label(labels.roles, role.name) %></div>
                        <div class="small text-muted"><%= role.name %></div>
                      </td>
                    <% } %>
                    <td>
                      <% if (wt) { %>
                        <div><%= _label(labels.worktypes, wt) %></div>
                        <div class="small text-muted"><%= wt %></div>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
                </tbody>
              <% }) %>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
