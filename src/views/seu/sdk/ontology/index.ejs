<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Ontology Management</h2>
      <p class="text-muted small mb-0">
        The vocabulary every write checks against (Ch.18). <strong>Platform</strong> concepts are canonical and
        visible to everyone; your own additions land in <strong>your tenant's</strong> vocabulary alongside them —
        <%= locals.isRoot ? "as root, you're adding to Platform's shared set." : "nobody else's vocabulary is affected, and nobody else can retire yours." %>
        Add or <strong>retire</strong> (soft — never delete): a retired concept stays and existing data keeps working,
        it just drops out of new pickers. New codes are <strong>lowercase, hyphenated, no spaces</strong>
        (e.g. <code>capability-name</code>).
      </p>
    </div>

    <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
    <%- include('../../../partials/verticalTabs', { tabs: conceptTypes.map(function (ct) { return { key: ct, label: ct, href: '/aisworg/seu/sdk/ontology?type=' + encodeURIComponent(ct) }; }), active: activeType }) %>
    <div class="flex-grow-1" style="min-width: 0;">

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <form method="POST" action="/aisworg/seu/sdk/ontology/add" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-sm-3">
            <label class="form-label small mb-1">Concept type</label>
            <input name="conceptType" class="form-control form-control-sm" value="<%= activeType %>" placeholder="capability-name" required>
            <div class="form-text small">Existing type, or type a new one to start it.</div>
          </div>
          <div class="col-sm-3"><label class="form-label small mb-1">Code</label><input name="code" class="form-control form-control-sm" placeholder="requirements-analysis" required></div>
          <div class="col-sm-4"><label class="form-label small mb-1">Label</label><input name="defaultLabel" class="form-control form-control-sm" placeholder="Requirements Analysis" required></div>
          <div class="col-sm-2 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add concept</button></div>
          <div class="col-12">
            <label class="form-label small mb-1">Description <span class="text-muted fw-normal">(optional — "when to use this", shown as guidance wherever this concept is picked)</span></label>
            <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="e.g. Template for creating software for a web application that has enterprise wide impact; use this when..."></textarea>
          </div>
        </form>
      </div>
    </div>

    <% if (activeType) { %>
      <%- include('../../../partials/listControls', { list: list, listBasePath: listBasePath, searchPlaceholder: 'Search' }) %>

      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Code', 'code', list, listBasePath) %></th>
                <th><%- sortLink('Label', 'label', list, listBasePath) %></th>
                <th><%- sortLink('Owner', 'tenant', list, listBasePath) %></th>
                <th><%- sortLink('Status', 'active', list, listBasePath) %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (list.total === 0) { %><tr><td colspan="5" class="text-muted small text-center py-3"><%= list.q ? 'No concepts match your search.' : 'No concepts for this type yet.' %></td></tr><% } %>
              <% list.items.forEach(function(c) { %>
                <% var canRetireThis = locals.isRoot || !c.isPlatform; %>
                <tr class="<%= c.isActive ? '' : 'text-muted' %>">
                  <td><code><%= c.code %></code></td>
                  <td class="small">
                    <%= c.label %>
                    <% if (c.description) { %><div class="text-muted small fst-italic mt-1" style="max-width: 32rem;"><%= c.description %></div><% } %>
                  </td>
                  <td><% if (c.isPlatform) { %><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Platform</span><% } else { %><span class="badge bg-light text-dark border">Your tenant</span><% } %></td>
                  <td><% if (c.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span><% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired</span><% } %></td>
                  <td class="text-end">
                    <% if (c.isActive && canRetireThis) { %>
                      <form method="POST" action="/aisworg/seu/sdk/ontology/retire" onsubmit="return confirm('Retire concept <%= c.code %>? Existing data is unaffected; it just won\'t be offered for new items.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="conceptType" value="<%= activeType %>">
                        <input type="hidden" name="code" value="<%= c.code %>">
                        <input type="hidden" name="tenantId" value="<%= c.tenantId %>">
                        <button class="btn btn-sm btn-outline-secondary">Retire</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
