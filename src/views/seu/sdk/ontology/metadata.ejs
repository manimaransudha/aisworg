<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Ontology Metadata</h2>
      <p class="text-muted small mb-0">
        <strong>Text type</strong> and <strong>UI grouping</strong> (Ch.18/CR-096), managed here as ONE page across
        every concept category — deliberately kept separate from the concept-browsing pages themselves, so a code's
        grouping is set from a single authoritative place instead of drifting to slightly different labels edited
        independently inside each category. UI grouping collapses a set of concept_types into one navbar/tab entry
        (e.g. <code>ai-provider-preference</code>, <code>development-methodology</code> etc. as "SEU Configurations");
        text type decides whether a concept's description renders as plain text or markdown.
      </p>
    </div>

    <div class="card border-0 shadow-sm mb-4" id="setMetaCard">
      <div class="card-body">
        <h3 class="h6 fw-bold mb-3">Set metadata on a concept</h3>
        <form method="POST" action="/aisworg/seu/sdk/ontology/update-meta" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <!-- No tenant selector, same simplification the Add-concept form already
               makes: root curates Platform's canonical rows, everyone else their
               own tenant's — never a picker of arbitrary other tenants. -->
          <input type="hidden" name="tenantId" value="<%= defaultTenantId %>">
          <div class="col-sm-3">
            <label class="form-label small mb-1">Concept type</label>
            <select name="conceptType" id="metaConceptType" class="form-select form-select-sm" required>
              <option value="" disabled selected>Choose…</option>
              <% conceptTypes.forEach(function (ct) { %><option value="<%= ct %>"><%= ct %></option><% }) %>
            </select>
          </div>
          <div class="col-sm-3">
            <label class="form-label small mb-1">Code</label>
            <select name="code" id="metaCode" class="form-select form-select-sm" required disabled>
              <option value="" disabled selected>Choose a concept type first…</option>
            </select>
          </div>
          <div class="col-sm-3">
            <label class="form-label small mb-1">Group <span class="text-muted fw-normal">(existing shown below, or type a new one — blank clears it)</span></label>
            <input name="uiGrouping" id="metaUiGrouping" class="form-control form-control-sm" list="existingGroupLabels" placeholder="e.g. SEU Configurations" autocomplete="off">
            <datalist id="existingGroupLabels">
              <% (locals.existingGroupLabels || []).forEach(function (g) { %><option value="<%= g %>"><% }) %>
            </datalist>
          </div>
          <div class="col-sm-2">
            <label class="form-label small mb-1">Text type</label>
            <select name="textType" id="metaTextType" class="form-select form-select-sm">
              <option value="markdown">Markdown</option>
              <option value="text">Plain text</option>
            </select>
          </div>
          <div class="col-sm-1 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-check-lg"></i></button></div>
        </form>
      </div>
    </div>

    <div class="mb-3">
      <h3 class="h6 fw-bold mb-2">All concepts</h3>
      <%- include('../../../partials/listControls', { list: list, listBasePath: listBasePath, searchPlaceholder: 'Search concept type, code, label, or group' }) %>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th><%- sortLink('Concept type', 'conceptType', list, listBasePath) %></th>
              <th><%- sortLink('Code', 'code', list, listBasePath) %></th>
              <th><%- sortLink('Label', 'label', list, listBasePath) %></th>
              <th><%- sortLink('Group', 'group', list, listBasePath) %></th>
              <th><%- sortLink('Text type', 'textType', list, listBasePath) %></th>
              <th><%- sortLink('Owner', 'tenant', list, listBasePath) %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="7" class="text-muted small text-center py-3">No concept matches your search.</td></tr>
            <% } %>
            <% list.items.forEach(function (m) { %>
              <tr>
                <td><code><%= m.conceptType %></code></td>
                <td><code><%= m.code %></code></td>
                <td class="small"><%= m.label %></td>
                <td><% if (m.groupLabel) { %><i class="bi bi-diagram-2 me-1 text-muted"></i><%= m.groupLabel %><% } else { %><span class="text-muted">—</span><% } %></td>
                <td class="small"><%= m.textType %></td>
                <td><% if (m.isPlatform) { %><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Platform</span><% } else { %><span class="badge bg-light text-dark border">Tenant</span><% } %></td>
                <td class="text-end">
                  <div class="d-flex gap-1 justify-content-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-edit-meta"
                      data-concept-type="<%= m.conceptType %>" data-code="<%= m.code %>" data-text-type="<%= m.textType %>" data-ui-grouping="<%= m.groupLabel || '' %>">
                      <i class="bi bi-pencil me-1"></i>Edit
                    </button>
                    <form method="POST" action="/aisworg/seu/sdk/ontology/quick-retire" onsubmit="return confirm('Retire concept <%= m.code %>? Existing data is unaffected; it just won\'t be offered for new items.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="conceptType" value="<%= m.conceptType %>">
                      <input type="hidden" name="code" value="<%= m.code %>">
                      <input type="hidden" name="tenantId" value="<%= m.tenantId %>">
                      <button class="btn btn-sm btn-outline-secondary">Retire</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <%- include('../../../partials/footer') %>
  <script>
    (function () {
      var conceptsByType = <%- JSON.stringify(locals.conceptsByType || {}) %>;
      var typeSel = document.getElementById('metaConceptType');
      var codeSel = document.getElementById('metaCode');
      var textTypeSel = document.getElementById('metaTextType');
      var uiGroupingInput = document.getElementById('metaUiGrouping');
      if (!typeSel || !codeSel) return;

      function syncCodes(selectedCode) {
        var options = conceptsByType[typeSel.value] || [];
        codeSel.innerHTML = '';
        if (!options.length) {
          codeSel.disabled = true;
          var opt = document.createElement('option');
          opt.value = ''; opt.textContent = 'No concepts of this type yet'; opt.disabled = true; opt.selected = true;
          codeSel.appendChild(opt);
          return;
        }
        codeSel.disabled = false;
        options.forEach(function (o) {
          var opt = document.createElement('option');
          opt.value = o.code;
          opt.textContent = o.code + ' — ' + o.label;
          if (selectedCode && o.code === selectedCode) opt.selected = true;
          codeSel.appendChild(opt);
        });
      }
      typeSel.addEventListener('change', function () { syncCodes(); });
      if (typeSel.value) syncCodes();

      // "Edit" button on a Current groupings row — pre-fills the Set
      // metadata form above with this row's own values (owner: "Edit is
      // missing" on this page) instead of re-picking type/code from scratch.
      document.querySelectorAll('.js-edit-meta').forEach(function (btn) {
        btn.addEventListener('click', function () {
          typeSel.value = btn.getAttribute('data-concept-type') || '';
          syncCodes(btn.getAttribute('data-code') || '');
          if (textTypeSel) textTypeSel.value = btn.getAttribute('data-text-type') || 'markdown';
          if (uiGroupingInput) uiGroupingInput.value = btn.getAttribute('data-ui-grouping') || '';
          var card = document.getElementById('setMetaCard');
          if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    })();
  </script>
</body>
</html>
