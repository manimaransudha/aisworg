<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <header><%- include('../../../partials/navbar') %></header>

  <%# Sticky action bar (owner: "inconvenient to scroll all the way down to
      click something") — the generated form can run long, so Save/Cancel/
      Validate live in a bar fixed to the bottom of the viewport, always
      reachable regardless of scroll position. pb-authoring-actions on <main>
      keeps the bar from covering the last of the page's real content. %>
  <style>
    .authoring-action-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1020;
      background: #fff;
      border-top: 1px solid rgba(0, 0, 0, .08);
      box-shadow: 0 -2px 10px rgba(0, 0, 0, .06);
      padding: 0.6rem 0;
    }
    .pb-authoring-actions { padding-bottom: 4.5rem; }
  </style>

  <%# Owner: "Review Gates form is pathetic... this is looking like a
      mainframe screen" — root cause was /css/style.css 404ing (no public/
      directory existed at all); now fixed site-wide by public/css/style.css,
      which carries this page's own .referential-list-group rules too (moved
      there from a page-local <style> block that used to live here). %>

  <%# Owner: "There is so much of margin on the left and the right of the
      actual content. that is all wasted space" — this inline max-width was
      CAPPING Bootstrap's own, wider natural .container sizing (1140px at
      the xl breakpoint, 1320px at xxl) down to a flat 1000px on every
      screen, losing 140-320px of real width on any normal desktop viewport
      — exactly the "columns squeezed for no reason" feeling, on a page that
      already spends ~230-260px of that budget on the section sidebar.
      Removed outright: plain .container already does the right,
      breakpoint-responsive thing without an override. %>
  <main class="container py-5 pb-authoring-actions">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% var isNew = !locals.draft; %>
    <div class="mb-4 d-flex justify-content-between align-items-start">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold"><%= kindLabel %> Definition</h2>
        <% if (!isNew && draft.purpose) { %>
          <%# CR-023 (owner: "In view mode, show this as a sub text under the
              title") — Template's `purpose`, wherever it has a real value
              (blank/absent for Pack/Profile, which have no purpose field). %>
          <p class="mb-1"><%= draft.purpose %></p>
        <% } %>
        <p class="text-muted small mb-0">
          Generated from <code>schema_definitions</code>, not a hand-built form.
          <a href="/aisworg/seu/sdk/<%= slug %>">&larr; All <%= kindLabel %>s</a>
          <% if (!isNew) { %> · <span class="text-muted">Draft <code><%= draft.code %></code></span><% } %>
        </p>
      </div>
      <% if (!isNew) { %><span class="state-badge state-<%= draft.status.replace(/\s+/g,'') %> align-self-center"><%= draft.status %></span><% } %>
    </div>

    <% if (locals.errors && errors.length) { %>
      <div class="alert alert-danger border-0 shadow-sm mb-4">
        <strong>Could not proceed:</strong>
        <ul class="mb-0"><% errors.forEach(function(e) { %><li><%= e %></li><% }) %></ul>
      </div>
    <% } %>

    <%
      // One hop at a time (separation of duties) — the button names the
      // VERB this actor's own authority is about to exercise ("Validate Pack",
      // "Publish Pack", "Activate Pack", …), not a blanket "Publish"; a
      // different verb-holder takes the next step.
      var verbLabel = nextVerb ? nextVerb.charAt(0).toUpperCase() + nextVerb.slice(1) : '';
    %>
    <% if (isNew && locals.inheritableTemplates && inheritableTemplates.length > 0) { %>
      <%# CR-026 Template Inheritance (Ch.6 §9, owner: "show a dropdown of
          codes (Platform published + tenant published). Give a button to
          inherit."). A plain GET reload of this same page with
          ?parentTemplateId= — the form below then arrives pre-filled from
          the chosen parent's real content (inheritedTemplateContent), code
          locked to the parent's own. Never shown to a Platform author or root
          (owner: "no change to the way template is created by a platform
          user") — the route only computes this list for a real tenant viewer. %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-uppercase text-muted small fw-bold mb-2">Inherit from an existing Template</h6>
          <p class="text-muted small mb-2">Start from a Platform or your own tenant's published Template — its code, capabilities, mandatory Packs, and deliverables carry over as an editable starting point. Its mandatory Packs must stay mandatory in your Derived Template.</p>
          <% if (locals.inheritingFromTemplateId) { %>
            <p class="small mb-2"><i class="bi bi-check-circle text-success me-1"></i>Inheriting below — code is locked to the parent's.</p>
          <% } %>
          <form method="GET" action="/aisworg/seu/sdk/<%= slug %>/new" class="d-flex gap-2">
            <select name="parentTemplateId" class="form-select form-select-sm" style="max-width: 420px;">
              <option value="">Choose a Template to inherit from&hellip;</option>
              <% inheritableTemplates.forEach(function (t) { %>
                <option value="<%= t.id %>" <%= locals.inheritingFromTemplateId === t.id ? 'selected' : '' %>><%= t.name %> (<%= t.code %> v<%= t.templateVersion %>)</option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Inherit</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (isNew && locals.inheritableProfiles && inheritableProfiles.length > 0) { %>
      <%# Ch.7 §9 Profile Inheritance (owner, 2026-08-19), same treatment as
          Template's Inherit control above — a plain GET reload with
          ?parentProfileId=, pre-filled from the chosen parent's real content
          (inheritedProfileContent), code locked to the parent's own. Never
          shown to a Platform author or root, same "no change to the way
          [it] is created by a platform user" rule as Template's. %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-uppercase text-muted small fw-bold mb-2">Inherit from an existing Profile</h6>
          <p class="text-muted small mb-2">Start from a Platform or your own tenant's published Profile — its code, Pack selections, and configuration carry over as an editable starting point.</p>
          <% if (locals.inheritingFromProfileId) { %>
            <p class="small mb-2"><i class="bi bi-check-circle text-success me-1"></i>Inheriting below — code is locked to the parent's.</p>
          <% } %>
          <form method="GET" action="/aisworg/seu/sdk/<%= slug %>/new" class="d-flex gap-2">
            <select name="parentProfileId" class="form-select form-select-sm" style="max-width: 420px;">
              <option value="">Choose a Profile to inherit from&hellip;</option>
              <% inheritableProfiles.forEach(function (p) { %>
                <option value="<%= p.id %>" <%= locals.inheritingFromProfileId === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.code %> v<%= p.profileVersion %>)</option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Inherit</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (isNew && locals.inheritableDeliverableDefinitions && inheritableDeliverableDefinitions.length > 0) { %>
      <%# Ch.15 §12 Deliverable inheritance (CR-049), same "Inherit" pattern as
          Template/Profile above — a plain GET reload with
          ?parentDeliverableDefinitionId=, pre-filled from the chosen parent's
          real content (inheritedDeliverableDefinitionContent). Unlike
          Template/Profile, code is NOT locked to the parent's own — a
          specialisation is expected to have its own genuinely new name. %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-uppercase text-muted small fw-bold mb-2">Inherit from an existing Deliverable Definition</h6>
          <p class="text-muted small mb-2">Start from a Platform-published Deliverable Definition — its code and description carry over as an editable starting point. Give your specialisation its own name if it needs one.</p>
          <% if (locals.inheritingFromDeliverableDefinitionId) { %>
            <p class="small mb-2"><i class="bi bi-check-circle text-success me-1"></i>Inheriting below.</p>
          <% } %>
          <form method="GET" action="/aisworg/seu/sdk/<%= slug %>/new" class="d-flex gap-2">
            <select name="parentDeliverableDefinitionId" class="form-select form-select-sm" style="max-width: 420px;">
              <option value="">Choose a Deliverable Definition to inherit from&hellip;</option>
              <% inheritableDeliverableDefinitions.forEach(function (d) { %>
                <option value="<%= d.id %>" <%= locals.inheritingFromDeliverableDefinitionId === d.id ? 'selected' : '' %>><%= d.code %> v<%= d.definitionVersion %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Inherit</button>
          </form>
        </div>
      </div>
    <% } %>

    <%# Owner: "Pathetic UI... continuing to do a shallow pass" — this used
        to be a Stepper (Meta / Items) wrapping, on its Items step, a
        SEPARATE vertical-tabs sidebar for Dependencies + every Contribution
        type — two stacked levels of tab-like navigation for what is really
        one flat list of peer sections. _generatedFieldGroups.ejs already
        natively renders every section (Identity & Metadata, Compatibility,
        Dependencies, each Contribution type) as ONE unified set of tabs
        when no `sections` filter is passed — the stepper was an artificial
        split of a single call into two, not something the underlying
        mechanism required. Removed outright: one call, one sidebar, every
        section a peer — genuinely fewer navigation levels, not just a
        restyled version of the same nesting. Also drops the outer
        "Generated form" card wrapper (an internal/developer label, not
        something an author needs framed as its own boxed section) so the
        page isn't a card inside a card inside a card. %>
    <%# One shared form/action-toolbar, not a separate floating button
        elsewhere on the page: Save/Create posts here by default; the
        verb-named advance action (e.g. "Validate Pack") is a formaction
        override on the SAME form/fields, not a second disconnected form —
        it cannot be enabled independent of this form's own saved-state
        tracking. %>
    <form method="POST" id="authoring-form" action="<%= isNew ? ('/aisworg/seu/sdk/' + slug) : ('/aisworg/seu/sdk/' + slug + '/' + draft.id + '/save') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%# CR-026 Template Inheritance — parentTemplateId isn't a generated
          schema field (it's identity/lineage, not authored content), so it
          rides along as its own hidden input set only when this new-draft
          form was reached via the "Inherit" control below. %>
      <% if (locals.inheritingFromTemplateId) { %>
        <input type="hidden" name="parentTemplateId" value="<%= inheritingFromTemplateId %>">
      <% } %>
      <% if (locals.inheritingFromProfileId) { %>
        <input type="hidden" name="parentProfileId" value="<%= inheritingFromProfileId %>">
      <% } %>
      <% if (locals.inheritingFromDeliverableDefinitionId) { %>
        <input type="hidden" name="parentDeliverableDefinitionId" value="<%= inheritingFromDeliverableDefinitionId %>">
      <% } %>

      <%- include('../_generatedFieldGroups', { groups: groups, canEdit: canEdit, referentialOptions: locals.referentialOptions, packDependencyOptions: locals.packDependencyOptions, templateOptions: locals.templateOptions, ontologyOptions: locals.ontologyOptions, contributionHelp: locals.contributionHelp, verifiableFieldHelp: locals.verifiableFieldHelp }) %>

      <% if (canEdit || canPublish) { %>
        <div class="authoring-action-bar">
          <div class="container d-flex gap-2 align-items-center">
            <% if (canEdit) { %>
              <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i><%= isNew ? 'Create draft' : 'Save draft' %></button>
              <a href="/aisworg/seu/sdk/<%= slug %>" class="btn btn-sm btn-outline-secondary">Cancel</a>
            <% } %>
            <% if (canPublish) { %>
              <%# Bug fix (owner: "I do not see the Validate button on the
                  new pack form... why did you remove it") — it must stay
                  VISIBLE on the new-draft form too, not appear only after
                  the first Save, so its existence/label isn't a surprise.
                  isNew: always disabled (there's no draft yet to act on) —
                  formaction points nowhere real since a disabled button
                  never submits. !isNew: starts enabled (the draft IS
                  saved — nothing pending) and is disabled the instant any
                  field in THIS form changes, by save-state-tracking.js
                  below — re-enabled only by a fresh page load, which only
                  happens after an actual Save. %>
              <button type="submit" id="advance-btn"
                <%- isNew ? 'disabled' : ('formaction="/aisworg/seu/sdk/' + slug + '/' + draft.id + '/publish"') %>
                formnovalidate class="btn btn-success btn-sm"><i class="bi bi-cloud-upload me-1"></i><%= verbLabel %> <%= kindLabel %></button>
              <span id="advance-hint" class="text-muted small <%= isNew ? '' : 'd-none' %>"><%= isNew ? 'Create the draft first.' : 'Save your changes first.' %></span>
            <% } %>
          </div>
        </div>
      <% } %>
    </form>

    <% if (!isNew && (locals.possibleNextStates || []).length > 0) { %>
      <%
        // Registry governance, relocated here (owner, 2026-08-19: "Add it
        // back to Authoring" — the Registry page is now view-only). Every
        // possible next state off the entity's CURRENT status is offered —
        // the real per-target-state authority check happens server-side in
        // POST .../transition, same as the removed Registry dropdown did.
      %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-uppercase text-muted small fw-bold mb-2">Lifecycle</h6>
          <form method="POST" action="/aisworg/seu/sdk/<%= slug %>/<%= draft.id %>/transition" class="d-flex align-items-center gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
              <% locals.possibleNextStates.forEach(function(s) { %>
                <option value="<%= s %>"><%= s %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
          </form>
        </div>
      </div>
    <% } %>

    <% if (!isNew && canEdit) { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <h6 class="text-uppercase text-muted small fw-bold mb-2">JSON import</h6>
          <p class="text-muted small mb-2">First-class entry point, not a fallback — replaces the whole document.</p>
          <form method="POST" action="/aisworg/seu/sdk/<%= slug %>/<%= draft.id %>/import">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea name="importedJson" class="form-control form-control-sm font-monospace mb-2" rows="6" placeholder="Paste a JSON document..."><%= contentJson %></textarea>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Import</button>
          </form>
        </div>
      </div>
    <% } %>

  </main>

  <script>
    // Bug fix: advancing must never act on edits the user hasn't saved yet.
    // Disable the advance action the instant ANY field in the authoring form
    // changes, re-enabled only by a fresh (post-save) page load. Defensively
    // bound two ways — form-level delegation AND a direct listener on every
    // individual field — so no bubbling edge case (a wrapped/enhanced widget
    // that stops propagation, for instance) can leave it silently enabled
    // through an unsaved edit. No-ops entirely when the button isn't on the
    // page at all (this actor holds no authority for the next hop); on the
    // new-draft form it IS on the page, just server-rendered `disabled` —
    // markDirty()'s own already-disabled check makes attaching these
    // listeners harmless there.
    (function () {
      var form = document.getElementById('authoring-form');
      var btn = document.getElementById('advance-btn');
      var hint = document.getElementById('advance-hint');

      function markDirty() {
        if (!btn || btn.disabled) return;
        btn.disabled = true;
        if (hint) hint.classList.remove('d-none');
      }
      // Exposed so the shared referentialListGroup.js (add/remove-row
      // wiring, loaded below) can flag the form dirty too, without this
      // page's own dirty-tracking logic living in two places.
      window.markDirty = markDirty;

      if (form && btn) {
        form.addEventListener('input', markDirty);
        form.addEventListener('change', markDirty);
        var fields = form.querySelectorAll('input, select, textarea');
        for (var i = 0; i < fields.length; i++) {
          fields[i].addEventListener('input', markDirty);
          fields[i].addEventListener('change', markDirty);
        }

        // The confirm prompt belongs to THIS button only (a `formaction`
        // override on the shared form) — not the form's onsubmit, which would
        // otherwise also prompt on an ordinary Save click.
        btn.addEventListener('click', function (e) {
          var verb = <%- JSON.stringify(verbLabel) %>;
          var kind = <%- JSON.stringify(kindLabel) %>;
          var fromState = <%- JSON.stringify(isNew ? '' : draft.status) %>;
          var toState = <%- JSON.stringify(nextState || '') %>;
          if (!window.confirm(verb + ' this ' + kind + ' — move it from ' + fromState + ' to ' + toState + ', under your authority?')) {
            e.preventDefault();
          }
        });
      }

      // "+ Add another" / "Remove" row wiring for every .referential-list-group
      // on this page (Dependencies + every Contribution type) now lives in
      // the shared public/js/referentialListGroup.js, loaded below — it also
      // covers schema-registry/new.ejs's own referential-list field, which
      // had no add/remove affordance at all before this (generateFields()
      // only ever offers one blank row, so that form could only ever add ONE
      // new field per saved schema version — a real functional gap, not
      // cosmetic, fixed by sharing this instead of leaving it edit.ejs-only).

      // "Next version" (owner: "Version should be autogenerated using a next
      // version button. Editable text is not the correct approach.") — the
      // field itself is readonly; this is the ONLY way its value changes.
      // Patch-bump (x.y.z -> x.y.(z+1)); anything not already valid semver
      // (shouldn't happen — the route always seeds 1.0.0) resets to 1.0.0.
      // CR-024: generic over every .next-version-btn on the page (Pack's
      // packVersion and Template's templateVersion both use this now, kind
      // "version" — see _generatedFieldGroups.ejs), not one hardcoded pair
      // of element ids.
      document.querySelectorAll('.next-version-btn').forEach(function (btn) {
        var targetId = btn.getAttribute('data-version-target');
        var versionField = targetId && document.getElementById(targetId);
        if (!versionField) return;
        btn.addEventListener('click', function () {
          var m = /^(\d+)\.(\d+)\.(\d+)$/.exec(versionField.value.trim());
          versionField.value = m ? (m[1] + '.' + m[2] + '.' + (parseInt(m[3], 10) + 1)) : '1.0.0';
          markDirty();
        });
      });

      // Ontology-backed picker guidance (owner: "when the dropdown is chosen,
      // show this as guidance") — reads the selected <option>'s
      // data-description (set from ontologyOptions[...].description,
      // _generatedFieldGroups.ejs) into the field's own guidance <div>.
      // Generic over every .ontology-select on the page (Template's `code`
      // today; any future ontology-backed field the same way, no per-field
      // wiring) — runs once on load too, so a prefilled/edit-mode value shows
      // its guidance immediately, not only after the author touches it.
      function showOntologyGuidance(select) {
        var targetId = select.getAttribute('data-guidance-target');
        var target = targetId && document.getElementById(targetId);
        if (!target) return;
        var opt = select.options[select.selectedIndex];
        var description = opt ? opt.getAttribute('data-description') : '';
        target.textContent = description || '';
      }
      document.querySelectorAll('.ontology-select').forEach(function (select) {
        showOntologyGuidance(select);
        select.addEventListener('change', function () { showOntologyGuidance(select); });
      });
    })();
  </script>
  <script src="<%= baseUrl %>/js/referentialListGroup.js"></script>

  <%- include('../../../partials/footer') %>
</body>
</html>
