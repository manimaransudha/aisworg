<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold"><%= kindLabel %> Authoring</h2>
        <p class="text-muted small mb-0">
          A <%= kindLabel %> is authored as a <strong>Draft of the <%= kindLabel %> itself</strong> and driven through its own
          governed <code>noun × verb</code> transitions by you — the real author. Publishing registers the live, governed <%= kindLabel %>.
        </p>
      </div>
      <% if (canCreate) { %>
        <a href="/aisworg/seu/sdk/<%= slug %>/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New <%= kindLabel %></a>
      <% } %>
    </div>

    <%# CR-027 — one vertical-tab sidebar for the whole page: the per-verb
        Draft tabs for Pack/Template/Profile, or (Transition Definition only,
        `definitions` set) the CR-006 Stage 1b authority tabs — everything
        else on the page (the tab content, and for Transition Definition the
        Current Transition Definitions section below) sits in the content
        column beside it. %>
    <div class="d-flex flex-column flex-md-row gap-4 align-items-start">
    <% if (locals.definitions) { %>
      <%- include('../../../partials/authorityTabs', { active: 'definitions' }) %>
    <% } else { %>
      <%- include('../../../partials/verticalTabs', { tabs: (locals.tabs || []).map(function (t) { return { key: t.key, label: t.label, sub: '<code>' + t.verb + '</code>' }; }), paneMode: true }) %>
    <% } %>
    <div class="flex-grow-1" style="min-width: 0;">

    <% if (typeof showDrafts === 'undefined' || showDrafts) { %>
      <% const _tabs = locals.tabs || []; %>
      <div class="tab-content">
        <% _tabs.forEach(function(t, i) { %>
          <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="tab-<%= t.key %>" role="tabpanel">
            <div class="card border-0 shadow-sm">
              <div class="card-body">
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Created</th><th></th></tr></thead>
                  <tbody>
                    <% t.rows.forEach(function(r) { %>
                      <tr>
                        <td class="small text-muted"><%= r.code %></td>
                        <td class="small"><%= r.name %></td>
                        <td><span class="state-badge state-<%= r.status.replace(/\s+/g,'') %>"><%= r.status %></span></td>
                        <td class="text-muted small"><%= new Date(r.createdAt).toLocaleString() %></td>
                        <td><a class="btn btn-sm btn-outline-primary" href="/aisworg/seu/sdk/<%= slug %>/<%= r.id %>"><%= t.key === 'define' ? 'Open' : 'View' %></a></td>
                      </tr>
                    <% }) %>
                    <% if (t.rows.length === 0) { %>
                      <tr><td colspan="5" class="text-muted small text-center py-3">Nothing in “<%= t.label %>” yet<%= t.key === 'define' ? ' — start one with “New '+kindLabel+'”.' : '.' %></td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i>Transition definitions are authored directly in the form below (noun × verb), not as grammar drafts.</p>
    <% } %>

    <%# CR-007: the LIVE transition definitions (current governed-transition graph), not just drafts. %>
    <% if (locals.definitions) { %>
      <% const _base = locals.listBasePath || ('/aisworg/seu/sdk/' + slug); %>
      <div class="d-flex align-items-baseline justify-content-between mt-5 mb-2">
        <h6 class="text-uppercase text-muted small fw-bold mb-0">Current Transition Definitions</h6>
        <span class="text-muted small">the governed-transition graph in force now (authority is attached here)</span>
      </div>
      <% if (locals.canWriteAuthority) { %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <form method="POST" action="/aisworg/seu/authority/transition-definitions/add" class="row g-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-3">
                <label class="form-label small mb-1">Noun</label>
                <select name="entityType" id="td-noun" class="form-select form-select-sm" required>
                  <option value="">Choose…</option>
                  <% (locals.activeNouns || []).forEach(function(n) { %><option value="<%= n.code %>"><%= n.code %></option><% }) %>
                </select>
              </div>
              <div class="col-sm-2"><label class="form-label small mb-1">From</label><input name="fromState" class="form-control form-control-sm" required></div>
              <div class="col-sm-2"><label class="form-label small mb-1">To</label><input name="toState" class="form-control form-control-sm" required></div>
              <div class="col-sm-3">
                <label class="form-label small mb-1">Verb</label>
                <select name="verb" id="td-verb" class="form-select form-select-sm" required><option value="">Choose noun first…</option></select>
              </div>
              <div class="col-sm-2 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
            </form>
            <div class="form-text small">The verb must be allowed on the noun (Mapping tab).</div>
          </div>
        </div>
        <script>
          (function () {
            var mapping = <%- JSON.stringify(locals.mappingByNoun || {}) %>;
            var noun = document.getElementById('td-noun'), verb = document.getElementById('td-verb');
            if (noun && verb) noun.addEventListener('change', function () {
              var vs = mapping[noun.value] || [];
              verb.innerHTML = vs.length ? vs.map(function (v) { return '<option value="' + v + '">' + v + '</option>'; }).join('') : '<option value="">No verbs mapped — add on the Mapping tab</option>';
            });
          })();
        </script>
      <% } %>
      <%- include('../../../partials/listControls', { list: definitions, listBasePath: _base, searchPlaceholder: 'Search entity / state / verb / badge' }) %>
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Entity', 'entity', definitions, _base) %></th>
                <th><%- sortLink('From', 'from', definitions, _base) %></th>
                <th><%- sortLink('To', 'to', definitions, _base) %></th>
                <th><%- sortLink('Verb', 'verb', definitions, _base) %></th>
                <th>Badge (noun_verb)</th>
                <th><%- sortLink('Authority rule', 'rule', definitions, _base) %></th>
                <th>Policies</th><th>Gates</th><th>Status</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% if (definitions.total === 0) { %>
                <tr><td colspan="10" class="text-muted small text-center py-3"><%= definitions.q ? 'No definitions match your search.' : 'No transition definitions.' %></td></tr>
              <% } %>
              <% definitions.items.forEach(function(d) { %>
                <tr class="<%= d.isActive ? '' : 'text-muted' %>">
                  <td><span class="badge bg-light text-dark border"><%= d.entityType %></span></td>
                  <td class="small"><%= d.fromState %></td>
                  <td class="small"><%= d.toState %></td>
                  <td class="small"><% if (d.verb) { %><code><%= d.verb %></code><% } else { %><span class="text-muted">—</span><% } %></td>
                  <td class="small"><% if (d.nounVerbBadge) { %><code class="text-primary"><%= d.nounVerbBadge %></code><% } else { %><span class="text-muted">—</span><% } %></td>
                  <td class="small text-muted"><%= d.authorityRuleCode || '—' %></td>
                  <td class="small text-muted"><%= d.policyCount %></td>
                  <td class="small text-muted"><%= d.qualityGateCount %></td>
                  <td><% if (d.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span><% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired</span><% } %></td>
                  <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" href="/aisworg/seu/authority/transition-definitions/<%= d.id %>">View</a>
                    <% if (locals.canWriteAuthority && d.isActive) { %>
                      <form method="POST" action="/aisworg/seu/authority/transition-definitions/retire" class="d-inline" onsubmit="return confirm('Retire this transition edge (<%= d.entityType %> <%= d.fromState %> → <%= d.toState %>)?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= d.id %>">
                        <button class="btn btn-sm btn-outline-secondary">Retire</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
