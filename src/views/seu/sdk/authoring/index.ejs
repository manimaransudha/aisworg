<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold"><%= kindLabel %> Authoring</h2>
        <p class="text-muted small mb-0">
          Each session is an ordinary Deliverable, produced by commissioning a small bootstrap SEU — reaching
          Baselined registers the real, governed <%= kindLabel %> (SDK UI Layer Plan).
        </p>
      </div>
      <% if (canCreate) { %>
        <form method="POST" action="/aisworg/seu/sdk/<%= slug %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New <%= kindLabel %></button>
        </form>
      <% } %>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>Session</th><th>State</th><th>Started</th><th></th></tr></thead>
          <tbody>
            <% sessions.forEach(function(s) { %>
              <tr>
                <td class="small text-muted"><%= s.deliverableId %></td>
                <td><span class="state-badge state-<%= s.lifecycleState.replace(/\s+/g,'') %>"><%= s.lifecycleState %></span></td>
                <td class="text-muted small"><%= new Date(s.createdAt).toLocaleString() %></td>
                <td><a class="btn btn-sm btn-outline-primary" href="/aisworg/seu/sdk/<%= slug %>/<%= s.deliverableId %>">Open</a></td>
              </tr>
            <% }) %>
            <% if (sessions.length === 0) { %>
              <tr><td colspan="4" class="text-muted small text-center py-3">No <%= kindLabel %> authoring sessions yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
