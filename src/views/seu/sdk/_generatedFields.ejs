<%# Shared renderer for a generateFields() result. Locals: fields (GeneratedField[]),
    canEdit (bool), referentialOptions (Record<string,string[]>), packDependencyOptions.
    Used by the Schema Registry's own meta-schema form (CR-017) — the Pack/Template/
    Profile authoring edit form moved to the tabbed _generatedFieldGroups.ejs instead
    (that partial's own header comment), this one is schema-registry/new.ejs's only
    consumer now. %>
<% fields.forEach(function(f) { %>
  <div class="mb-3">
    <label class="form-label small fw-semibold"><%= f.label %><% if (f.required) { %> <span class="text-danger">*</span><% } %></label>

    <% if (f.kind === 'string') { %>
      <input name="<%= f.name %>" class="form-control form-control-sm" value="<%= f.value %>" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
      <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>

    <% } else if (f.kind === 'select') { %>
      <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
        <option value="">— select —</option>
        <% f.options.forEach(function(opt) { %>
          <option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option>
        <% }) %>
      </select>

    <% } else if (f.kind === 'referential-select') { %>
      <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
        <option value="">— select —</option>
        <% ((locals.referentialOptions || {})[f.referentialSource] || []).forEach(function(opt) { %>
          <option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option>
        <% }) %>
      </select>
      <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>

    <% } else if (f.kind === 'json') { %>
      <textarea name="<%= f.name %>" class="form-control form-control-sm font-monospace" rows="8" <%- canEdit ? '' : 'disabled' %>><%= f.value %></textarea>
      <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>

    <% } else if (f.kind === 'referential-list') { %>
      <%# Owner's structural-review finding — this used to be a stale,
          unfixed duplicate of _referentialListGroup.ejs's own referential-
          list rendering: no labels, every field crammed into a bare
          col-auto regardless of kind, and (a real functional bug, not just
          cosmetic) no add/remove-row affordance at all — generateFields()
          only ever offers one blank row, so schema-registry/new.ejs's own
          9-column META_SCHEMA fields editor could only ever add ONE new
          field per saved schema version. Reusing the real, already-fixed
          widget instead of maintaining a second, divergent copy — same
          per-kind column sizing, same labeled cards, and (via the shared
          public/js/referentialListGroup.js, now included by both pages)
          the same working add/remove wiring. %>
      <%- include('_referentialListGroup', { field: f, canEdit: canEdit, referentialOptions: locals.referentialOptions, packDependencyOptions: locals.packDependencyOptions }) %>
      <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>
    <% } %>
  </div>
<% }) %>
