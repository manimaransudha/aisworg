<%# Grouped, TABBED rendering of a groupFieldsForDisplay() result — the Pack/
    Template/Profile authoring redesign (owner: "extremely unfriendly", then
    "each of the sections ... has to be a separate tab"), later generalised
    (owner: "Policy UI has to be similar to Pack - Metadata tab and other
    tabs grouped" -> "Full redesign") so which simple-field-grid tabs a kind
    has — Identity & Metadata, Pack Codes, Deliverable Catalogue,
    Compatibility, Policy's own Applicability/Governance, etc. — is entirely
    the schema's own x-groups declaration (groups.groups, in order), not a
    hardcoded list here. Dependencies and each individual Contribution type
    are still their own tab too, name/pattern-detected as before. Only one
    tab's fields are on screen at a time.
    Locals: groups (FieldGroups), canEdit (bool), referentialOptions,
    contributionHelp (Record<string,string>), verifiableFieldHelp
    (Record<string,string>), checklistOptions (ChecklistOption[], CR-060 —
    checklistIds' cross-Pack picker source), renderMarkdown (CR-077 —
    (raw: string) => string, threaded through to _referentialListGroup.ejs),
    sections (string[], optional — which of
    groups/exposableParameters/parameterOverrides/dependencies/contributions
    to include; omitted = all — 'groups' covers every schema-declared simple
    tab plus Configuration Parameters), idPrefix (string, optional — keeps
    tab/pane element ids unique when this partial is included more than once
    on the same page, e.g. once per stepper pane).
    Self-contained — doesn't share markup with _generatedFields.ejs, which the
    schema-registry's own meta-schema form still uses unchanged, so this
    redesign carries zero risk to that page. %>
<%
  // Full redesign (owner: "Policy UI has to be similar to Pack - Metadata
  // tab and other tabs grouped") — which simple-field-grid tabs exist, their
  // label, order, and field membership all come from the schema's own
  // x-groups/x-group now (formGenerator.js's groupFieldsForDisplay), not a
  // hardcoded list of tab ids here. `sections` (unused by the form's only
  // real caller today — reserved for a future stepper) now filters by these
  // five conceptual buckets instead of the old finer-grained tab ids.
  var sections = locals.sections || ['groups', 'exposableParameters', 'parameterOverrides', 'dependencies', 'contributions'];
  var wantSection = function(key) { return sections.indexOf(key) !== -1; };
  // Bug fix — JSON.stringify embedded raw into a SINGLE-quoted HTML
  // attribute (the only way to embed valid JSON, whose own strings are
  // double-quoted, without colliding with the attribute's own quoting) broke
  // the moment any Ontology label carried a literal apostrophe (e.g. "COPPA
  // Children's Privacy Compliance") — the apostrophe closed the attribute
  // early, silently truncating every driver value that came after it in the
  // JSON, not just the one carrying it. Escaping `'` to `&#39;` keeps the
  // attribute intact; the browser decodes the entity back to a literal `'`
  // before JSON.parse ever sees it, which reads it as an ordinary string
  // character like any other.
  var escapeAttrJson = function(obj) { return JSON.stringify(obj).replace(/'/g, '&#39;'); };
  // Bug fix (owner: "still shows Deliverable states" — the raw
  // "Deliverable|Approved|Baselined" value IS a transition already, but
  // displaying that exact string as the option's own visible LABEL too is
  // just concatenated states with pipes, not "more clear" at all). Strips
  // the entity type, shows "From → To" — generic over any EntityType|From|To
  // referentialOptions value, not just Deliverable's; a plain non-pipe
  // string (e.g. a noun code) passes through unchanged.
  var formatMultiOptionLabel = function(opt) {
    var parts = String(opt).split('|');
    return parts.length === 3 ? (parts[1] + ' → ' + parts[2]) : opt;
  };
  var idPrefix = locals.idPrefix || 'sec';
  var VERIFIABLE_FIELD_NAMES = ['statement','classification','prompt','participant','outputContract','assurance','externalEvidence'];

  // CR-067 x-show-when — "when a composition strategy is chosen, the UI
  // widget should appear." Generic: any field may declare showWhen naming
  // another field on this same form; that field starts hidden until the
  // controller has a value. Controller lookup only needs a value, not a
  // full field object — a flat name->value map built once, across every
  // "simple"-tab field (referential-list fields carry no scalar .value, so
  // they're never valid controllers, only targets).
  var fieldValueByName = {};
  (locals.groups.groups || []).forEach(function (g) {
    g.fields.forEach(function (f) { if (f.kind !== 'referential-list') fieldValueByName[f.name] = f.value; });
  });
  var isShowWhenHidden = function (f) { return !!f.showWhen && !fieldValueByName[f.showWhen]; };
  // Deliverable Catalogue tab exists only for Template (its own x-groups
  // declares a "deliverables" entry; Profile/Pack/Service/Policy don't).
  var hasDeliverablesGroup = (locals.groups.groups || []).some(function (g) { return g.key === 'deliverables' && g.fields.length; });

  // One entry per TAB — 'simple' (a plain field grid: Identity & Metadata,
  // Compatibility), 'referential-list' (Dependencies + most Contribution
  // types), or 'json' (Contributions still using a raw-JSON widget, e.g.
  // Compliance). hasContent decides which tab opens active by default — jump
  // the author straight to whichever section already has real data, same
  // intent the old accordion's "collapsed unless populated" had.
  var tabs = [];
  if (wantSection('groups')) {
    (locals.groups.groups || []).forEach(function (g) {
      if (g.fields.length) tabs.push({ id: g.key, label: g.label, type: 'simple', fields: g.fields, hasContent: false });
    });
  }
  // CR-091 Part 2 — Profile's own Ch.7 §10 Configuration Parameters. Unlike
  // Exposable Parameters below (a bespoke candidate-driven grid), these are
  // ordinary generated fields — 'simple' renders them exactly like the
  // schema-driven groups above; stays its own name-detected singleton
  // (formGenerator.js) rather than schema-driven, since its required-ness is
  // tenant-overridable at render time (CR-091 Part 2), not a schema fact.
  if (wantSection('groups') && (locals.groups.configurationParameters || []).length) {
    tabs.push({ id: 'configurationParameters', label: 'Configuration Parameters', type: 'simple', fields: locals.groups.configurationParameters, hasContent: false });
  }
  if (wantSection('exposableParameters') && (locals.groups.exposableParameters || []).length) {
    tabs.push({ id: 'exposableParameters', label: 'Exposable Parameters', type: 'exposableParameters', hasContent: false });
  }
  // CR-088 Profile-side completion (owner, 2026-09-05: "the overrides have to
  // be saved in the profile") — Profile's own tab, mirroring Exposable
  // Parameters above exactly (candidate-driven, computed server-side, no
  // author-typed rows), one level down: Template decides WHICH parameters
  // may be overridden at all; this tab is where a Profile actually sets the
  // overriding value for the ones it chooses to.
  if (wantSection('parameterOverrides') && (locals.groups.parameterOverrides || []).length) {
    tabs.push({ id: 'parameterOverrides', label: 'Parameter Overrides', type: 'parameterOverrides', hasContent: false });
  }
  if (wantSection('dependencies') && locals.groups.dependencies) {
    var depField = locals.groups.dependencies;
    tabs.push({ id: 'dependencies', label: 'Dependencies', type: 'referential-list', field: depField, count: depField.existingCount, hasContent: depField.rows.slice(0, depField.existingCount).length > 0 });
  }
  if (wantSection('contributions')) {
    (locals.groups.contributions || []).forEach(function (c) {
      var f = c.field;
      // CR-089 follow-on — contributionPolicies is the first "contributions"
      // field whose kind is referential-multi-select (a checkbox grid, not
      // an add-a-row list): f.value is a string[] here, not a string, so the
      // referential-list/json ternary below (f.value.trim()) would throw.
      // Routed to the SAME 'simple' tab type Identity & Metadata uses — its
      // generic per-field-kind switch (below) already renders
      // referential-multi-select correctly; no _referentialListGroup include
      // needed for a field with no per-item sub-fields at all.
      var isMultiSelect = f.kind === 'referential-multi-select';
      var hasContent = f.kind === 'referential-list' ? f.rows.slice(0, f.existingCount).length > 0
        : isMultiSelect ? f.value.length > 0
        : (f.value && f.value.trim() !== '{}' && f.value.trim() !== '[]' && f.value.trim() !== '');
      var tabType = f.kind === 'json' ? 'json' : isMultiSelect ? 'simple' : 'referential-list';
      tabs.push({ id: c.key, label: c.label, type: tabType, field: f, fields: isMultiSelect ? [f] : undefined, helpKey: c.key, count: f.kind === 'referential-list' ? f.existingCount : (isMultiSelect ? f.value.length : 0), hasContent: hasContent });
    });
  }
  // Bug fix (owner: branching a new Pack from an existing version's content
  // lands on the Dependencies tab instead of Identity & Metadata, then
  // "going back to identity" no longer shows the version — it's there in the
  // markup the whole time, just never the tab you land on). The
  // hasContent jump makes sense for CONTINUING an existing Draft (land on
  // whatever the author actually has to work on) but is wrong for a form
  // that was just freshly loaded via inheritance/branching
  // (?fromPackId=/?parentTemplateId=/?parentProfileId=/
  // ?parentDeliverableDefinitionId=) — the author just came from choosing
  // what to prefill FROM, and lands back on the very fields (Code, the
  // computed Version, Name) that choice just filled in, not on whichever
  // section happened to inherit the most content. `isNew` alone can't
  // distinguish "still-blank new form" from "just-prefilled new form", but
  // it doesn't need to: Identity & Metadata (tabs[0] whenever this entity
  // has any metadata fields at all, which every kind does) is exactly where
  // a blank form's own first field already lives too.
  var defaultActive = locals.isNew ? 0 : tabs.findIndex(function (t) { return t.hasContent; });
  if (defaultActive === -1) defaultActive = 0;
%>


<%# CR-027 — vertical tab sidebar for the generated form's own sections
    (Identity & Metadata / Compatibility / Dependencies / each Contribution
    type) — Pack's Draft can easily run to 8+ of these, which read as plain
    text crammed into one horizontal row. `defaultActive` still decides which
    pane opens first (whichever section already has real content), so
    verticalTabs' own "first tab active" default is overridden below by
    re-marking the right button/pane active. %>
<% if (tabs.length) { %>
  <div class="d-flex flex-column flex-md-row gap-4 align-items-start mb-4">
  <%- include('../../partials/verticalTabs', {
    tabs: tabs.map(function (t) { return { key: t.id, label: t.label, sub: t.count ? '<span class="badge bg-primary-subtle text-primary">' + t.count + '</span>' : '' }; }),
    paneMode: true,
    paneIdPrefix: idPrefix,
    activePaneIndex: defaultActive,
  }) %>
  <div class="tab-content flex-grow-1" style="min-width: 0;">
    <% tabs.forEach(function (t, i) { %>
      <div class="tab-pane fade <%= i === defaultActive ? 'show active' : '' %>" id="<%= idPrefix %>-<%= t.id %>" role="tabpanel">

        <% if (t.type === 'simple') { %>
          <%# Owner, 2026-09-04: "The form & the view should show read only
              capability-names (deduped) from the deliverable catalog. The
              next section should allow users to pick packs... If there are
              no packs contributing to the capability, it has to be called
              out... If there are packs that are contributing more than the
              deliverable led capabilities, they have to be called out too."
              Pure UI advisories (owner: "for now") — never block Save/Publish
              (core/templates.ts's validateTemplateSeed is untouched).
              "Required" is derived off deliverableCatalogue[].code itself
              (owner: "Deliverables are tied to services which are tied to
              capability") — every Active Service Definition whose own
              declared outputs (Ch.11) name a code in this catalogue names a
              producing Capability (sdkAuthoring.ts's
              loadPackCodesCapabilityCoverage — same contract
              commissioning.ts's own auto-derivation trusts, CR-087).
              Guarded on the entity actually having a Deliverable Catalogue
              tab at all (Template only — Profile shares this Pack Codes tab
              for its own 4 category fields but has no deliverableCatalogue
              to derive anything from). %>
          <% if (t.id === 'packSelection' && hasDeliverablesGroup) { %>
            <div class="mb-3">
              <label class="form-label small fw-semibold mb-1">Required Capabilities <span class="text-muted fw-normal">— from the Deliverable Catalogue's Capability dependencies, read-only</span></label>
              <% if (!(locals.requiredCapabilityNames || []).length) { %>
                <p class="text-muted small mb-2">None</p>
              <% } else { %>
                <div class="d-flex flex-wrap gap-1 mb-2">
                  <% locals.requiredCapabilityNames.forEach(function(c) { %>
                    <span class="badge bg-light text-dark border"><%= c.label %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if ((locals.capabilityCoverageGaps || []).length) { %>
                <div class="alert alert-warning small py-2 px-3 mb-2">
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  No selected Pack contributes: <strong><%= locals.capabilityCoverageGaps.map(function(c) { return c.label; }).join(", ") %></strong>. Update the Deliverable Catalogue's dependency graph, or pick a Pack below that contributes it.
                </div>
              <% } %>
              <% if ((locals.capabilityCoverageExcess || []).length) { %>
                <div class="alert alert-info small py-2 px-3 mb-2">
                  <i class="bi bi-info-circle me-1"></i>
                  The selected Packs below also contribute: <strong><%= locals.capabilityCoverageExcess.map(function(c) { return c.label; }).join(", ") %></strong> — not required by the Deliverable Catalogue.
                </div>
              <% } %>
            </div>
          <% } %>
          <div class="row g-3">
            <% t.fields.forEach(function(f) { %>
              <% if (f.kind === 'referential-list') { %>
                <%# Bug fix (owner: "Does New Template have a similar form
                    that Pack has?"): a referential-list field (Template's
                    mandatoryPackCodes, Profile's optionalPackCodes) bucketed
                    into this "simple" grid by NAME (groupFieldsForDisplay's
                    METADATA_FIELD_NAMES) but was never handled by this loop's
                    kind switch below (string/select/referential-select/json
                    only) — the label rendered, the control silently didn't.
                    Full width (col-12, not col-md-6 — a repeatable-row widget
                    needs the room), same partial Pack's own Dependencies tab
                    uses. %>
                <div class="col-12" <% if (f.showWhen) { %>data-show-when="<%= f.showWhen %>" style="<%= isShowWhenHidden(f) ? 'display:none' : '' %>"<% } %>>
                  <%# Owner: "In a view page why will a mandatory * indicator
                      show up?" — required is an editing affordance (what you
                      must still fill in); meaningless once the page is just
                      showing what was already saved. %>
                  <label class="form-label small fw-semibold"><%= f.label %><% if (f.required && canEdit) { %> <span class="text-danger">*</span><% } %></label>
                  <%- include('_referentialListGroup', { field: f, canEdit: canEdit, referentialOptions: locals.referentialOptions, ontologyOptions: locals.ontologyOptions, packDependencyOptions: locals.packDependencyOptions, checklistOptions: locals.checklistOptions, policyOptions: locals.policyOptions, serviceDefinitionOptions: locals.serviceDefinitionOptions, renderMarkdown: locals.renderMarkdown, fieldValueByName: fieldValueByName }) %>
                  <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>
                </div>
              <% } else { %>
              <%# CR-081 — Pack's own `category` forced full-width (owner:
                  "Category in its own row. Code and version alongside") so
                  code/packVersion (both still col-md-6, right after category
                  in FIELD_DISPLAY_ORDER) land paired on the row below,
                  instead of category eating half of code's own row and
                  packVersion drifting off to sit next to name several rows
                  later. Name-checked, not kind-checked — Template/Profile
                  have no field named `category` at all, so this is a Pack-
                  only effect by construction.
                  Settled, two SEPARATE things going to two separate places
                  (owner: "Did i not already say the computed version should
                  be muted belongside the name" — right, and that stands
                  alongside, not instead of, "show the version selector
                  alongside the code": these are two different pieces of
                  version information, not one). The COMPUTED version itself
                  (what this Draft's version will actually be) renders muted
                  next to Name, below. The version SELECTOR (existing
                  versions to branch content from) renders here, in
                  packVersion's own column beside Code — relabelled, since
                  this column no longer shows "the version," only the
                  choices; isNew-only, since there's nothing to branch from
                  once a Draft already exists. %>
              <% if (f.name === 'packVersion' && locals.kindLabel === 'Pack') { %>
                <%# The computed value itself is never independently editable
                    and never shown in its own column any more (see the Name
                    field's own label, below, in this same loop) — but it
                    still has to reach the server on submit, for both a
                    genuinely new Draft (blank until Code picks a category)
                    and a continuing edit of one already created (its version
                    was fixed at creation and must round-trip unchanged). A
                    plain hidden input, generic to every case, does that
                    without needing its own visible column at all. %>
                <% if (locals.isNew) { %>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold">Existing versions</label>
                  <div class="pack-code-versions small"></div>
                  <div class="form-text small">Pick one to start this new Draft from its content. Its own version is computed automatically once Code is chosen — shown next to Name.</div>
                </div>
                <% } %>
                <input type="hidden" name="packVersion" id="packVersion-field" value="<%= f.value %>">
              <% } else { %>
              <div class="<%= (f.name === 'category' || f.name === 'contributionPolicies') ? 'col-12' : 'col-md-6' %>" <% if (f.showWhen) { %>data-show-when="<%= f.showWhen %>" style="<%= isShowWhenHidden(f) ? 'display:none' : '' %>"<% } %>>
                <label class="form-label small fw-semibold">
                  <%= f.label %><% if (f.required && canEdit) { %> <span class="text-danger">*</span><% } %>
                  <% if (f.name === 'name' && locals.kindLabel === 'Pack') { %>
                    <%# Owner: "Did i not already say the computed version
                        should be muted belongside the name" — the OTHER of
                        the two version pieces (the selector lives beside
                        Code instead, above). id matched by
                        dynamicOntologyField.js's updateVersionPanel, which
                        keeps this in sync with the hidden packVersion input
                        above as Code changes; the server-rendered value here
                        is just this render's starting point. %>
                    <span id="packVersion-display" class="text-muted fw-normal ms-1">(<%= fieldValueByName['packVersion'] ? ('v' + fieldValueByName['packVersion']) : 'version pending' %>)</span>
                  <% } %>
                </label>
                <% if (!canEdit) { %>
                  <%# View mode — plain text, not a disabled control (owner:
                      "The view should show the details... just not
                      editable, showing dropdowns etc"). Referential values
                      resolve to the same human-readable label their
                      <option> would have shown, not the bare stored code. %>
                  <% if (f.kind === 'textarea' || f.kind === 'string' || f.kind === 'version' || f.kind === 'select') { %>
                    <div class="small <%= f.kind === 'version' ? 'font-monospace' : '' %>" style="white-space: pre-wrap;"><%= f.value || '—' %></div>
                  <% } else if (f.kind === 'json') { %>
                    <pre class="small bg-light border rounded p-2 mb-0"><%= f.value %></pre>
                  <% } else if (f.kind === 'referential-select' && f.ontology) { %>
                    <% var _ontOpts = ((locals.ontologyOptions || {})[f.referentialSource] || []); %>
                    <% var _matchedOnt = _ontOpts.find(function(opt) { return opt.code === f.value; }); %>
                    <div class="small"><%= _matchedOnt ? _matchedOnt.label : (f.value ? ('⚠ ' + f.value + ' (not currently active)') : '—') %></div>
                    <% if (_matchedOnt && _matchedOnt.description) { %><div class="form-text small fst-italic"><%= _matchedOnt.description %></div><% } %>
                  <% } else if (f.kind === 'referential-select' && f.referentialSource === 'template-code') { %>
                    <% var _matchedTemplate = (locals.templateOptions || []).find(function(t) { return t.code === f.value; }); %>
                    <div class="small"><%= _matchedTemplate ? _matchedTemplate.name : (f.value ? ('⚠ ' + f.value + ' (not currently Active)') : '—') %></div>
                  <% } else if (f.kind === 'referential-multi-select' && f.name === 'contributionPolicies') { %>
                    <%# CR-089 follow-on — code/name/description of every
                        ADOPTED canonical Policy Definition, resolved off
                        policyDefinitionOptions (not Ontology-backed like
                        every other multi-select, so a bespoke branch, not
                        the generic one below). %>
                    <% var _polOptsView = locals.policyDefinitionOptions || []; %>
                    <% if (!f.value.length) { %>
                      <div class="small text-muted">None adopted.</div>
                    <% } else { %>
                      <% f.value.forEach(function(code) { %>
                        <% var _matchedPol = _polOptsView.find(function(p) { return p.code === code; }); %>
                        <div class="card mb-2">
                          <div class="card-body py-2">
                            <h6 class="mb-1"><%= _matchedPol ? _matchedPol.name : ('⚠ ' + code + ' (not currently Active)') %> <code class="text-muted small"><%= code %></code></h6>
                            <% if (_matchedPol && _matchedPol.description) { %><p class="text-muted small mb-0"><%= _matchedPol.description %></p><% } %>
                          </div>
                        </div>
                      <% }) %>
                    <% } %>
                  <% } else if (f.kind === 'referential-multi-select') { %>
                    <%# Owner: "applicabilityDeliverableLifecycle is not
                        OntologyComposable" — a real, non-Ontology multi-select
                        (e.g. sourced from live transition_definitions states)
                        reads from referentialOptions instead of
                        ontologyOptions; every one of its values is already a
                        real, valid option (it's a closed dropdown, nothing
                        free-typed), so no "⚠ unregistered" marker applies. %>
                    <% var _ontOptsMultiView = ((locals.ontologyOptions || {})[f.referentialSource] || []); %>
                    <% if (!f.value.length) { %>
                      <div class="small text-muted">None</div>
                    <% } else if (!f.ontology) { %>
                      <div class="d-flex flex-wrap gap-1">
                        <% f.value.forEach(function(v) { %>
                          <span class="badge bg-light text-dark border"><%= formatMultiOptionLabel(v) %></span>
                        <% }) %>
                      </div>
                    <% } else { %>
                      <div class="d-flex flex-wrap gap-1">
                        <% f.value.forEach(function(v) { %>
                          <% var _matchedMulti = _ontOptsMultiView.find(function(o) { return o.code === v; }); %>
                          <span class="badge bg-light text-dark border"><%= _matchedMulti ? _matchedMulti.label : ('⚠ ' + v) %></span>
                        <% }) %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <div class="small"><%= f.value || '—' %></div>
                  <% } %>
                <% } else { %>
                <% if (f.kind === 'version') { %>
                  <%# Owner: "Version should be autogenerated using a next
                      version button. Editable text is not the correct
                      approach." — CR-024 generalised this off a hardcoded
                      `f.name === 'packVersion'` check (Pack's only, once)
                      onto `x-widget: "version"` (any kind — Template's
                      `templateVersion` uses the exact same mechanism now).
                      Readonly (not disabled, so it still submits), advanced
                      only by this field's own "Next version" button
                      (patch-bump, edit.ejs's script, generic over
                      .version-field); a fresh draft is pre-seeded 1.0.0 by
                      the route, never typed.
                      CR-081 — Pack's own packVersion no longer reaches this
                      branch at all (handled entirely by the outer loop —
                      its own column becomes the version-selector, and the
                      computed value itself displays next to Name instead),
                      so every case still arriving here is Template/Profile/
                      Deliverable's own version field, unaffected. %>
                  <div class="input-group input-group-sm">
                    <input id="<%= f.name %>-field" name="<%= f.name %>" class="form-control form-control-sm font-monospace version-field" value="<%= f.value %>" readonly required>
                    <% if (canEdit) { %>
                      <button type="button" class="btn btn-outline-secondary next-version-btn" data-version-target="<%= f.name %>-field"><i class="bi bi-arrow-up-circle me-1"></i>Next version</button>
                    <% } %>
                  </div>
                  <div class="form-text small">Auto-generated — semver, bumped by the button, never hand-typed.</div>
                <% } else if (f.kind === 'string') { %>
                  <input name="<%= f.name %>" class="form-control form-control-sm" value="<%= f.value %>" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                <% } else if (f.kind === 'textarea') { %>
                  <textarea name="<%= f.name %>" class="form-control form-control-sm" rows="3" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>><%= f.value %></textarea>
                <% } else if (f.kind === 'select') { %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% f.options.forEach(function(opt) { %><option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </select>
                <% } else if (f.kind === 'referential-select' && f.ontology && f.dynamicSourceField) { %>
                  <%# CR-079 step (d) — Pack's own `code`: concept type is
                      DRIVEN by another field's current value (category), not
                      fixed, so this can't be a plain <select> populated once
                      at render time — the author can change category in the
                      browser first.
                      Bug fix (owner: "this is really very bad... is this how
                      dropdown+text is implemented") — a first version used a
                      native <input list>/<datalist>: its suggestion popup is
                      browser/OS-drawn, unstyleable, inconsistent across
                      browsers, and shows the raw code ahead of the friendly
                      label. Rebuilt as a real on-page combo box instead
                      (dynamicOntologyField.js): a plain text input (still
                      free-text capable, no separate "type new" affordance
                      needed) plus a JS-driven, Bootstrap-styled suggestion
                      list that opens on focus (browsing every option for the
                      current category, before typing anything) and filters
                      live as you type, entirely within the page's own CSS —
                      matching the "how does the user know what's already
                      available" requirement properly instead of relying on
                      a native picker's inconsistent, unstyleable UI. %>
                  <% var _driverOpts = ((locals.ontologyOptions || {})[f.dynamicSourceDriverConceptType] || []); %>
                  <% var _optionsByDriverValue = {}; %>
                  <% _driverOpts.forEach(function(driverOpt) { _optionsByDriverValue[driverOpt.code] = (locals.ontologyOptions || {})[(driverOpt.code || '').toLowerCase() + (f.dynamicSourceSuffix || '')] || []; }); %>
                  <%# CR-081 — Pack's own `code`: version is a computed
                      SEQUENCE per code (owner: "version is to be treated
                      like a 'sequence'. If it['s] taken, assign the next"),
                      never hand-typed and never shown before Code has a
                      value at all (owner: "Version should not be shown in
                      the form by default that is wrong"). packCodeVersions
                      (server-computed, per code: Published-through-Archived
                      versions+status to branch from, plus the version the
                      next Draft under that code will actually get) is
                      embedded the same "no round trip" way the category
                      driver data above is (has to live here — this is where
                      Code's own current value is); dynamicOntologyField.js
                      reads it off this combo box to update the Version field
                      AND render its branch-picker list — both live in
                      Version's own column beside this one, not here (owner:
                      "show the version selector alongside the code" — see
                      that field's own rendering, below, in this same file). %>
                  <%
                    // CR-081 — gated on isNew (not just f.name === 'code'
                    // alone): the branch-picker's own links navigate to THIS
                    // page with ?fromPackId=, which only /sdk/:slug/new
                    // handles. Rendering the attribute (and the JS behavior
                    // it drives) on an existing Draft's edit page would
                    // clobber that Draft's own already-saved version the
                    // moment its author so much as touched Code, and offer
                    // dead-end branch-picker links — so this must only ever
                    // be present on a genuinely new, not-yet-created Draft.
                  %>
                  <%# Bug fix — a raw apostrophe inside an Ontology label
                      (e.g. "COPPA Children's Privacy Compliance") prematurely
                      closed this single-quoted attribute, truncating every
                      driver value that came after it in the JSON (silently
                      breaking every OTHER category's own suggestion list,
                      not just the one carrying the apostrophe). HTML-escape
                      any embedded `'` to `&#39;` — the browser decodes it
                      back to a literal apostrophe inside the attribute value,
                      which JSON.parse then reads as an ordinary string
                      character, no different from any other. %>
                  <div class="ontology-combo" data-driver-field="<%= f.dynamicSourceField %>" data-driver-values='<%- escapeAttrJson(_optionsByDriverValue) %>' <% if (f.name === 'code' && locals.isNew) { %>data-code-versions='<%- escapeAttrJson(locals.packCodeVersions || {}) %>'<% } %>>
                    <input id="<%= f.name %>-field" name="<%= f.name %>" class="form-control form-control-sm ontology-combo-input" autocomplete="off" value="<%= f.value %>" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <div class="ontology-combo-menu"></div>
                  </div>
                  <div class="form-text small">Click or start typing to browse existing codes for the chosen category, or type a new one — publishing is blocked until it's a real, registered Ontology concept.</div>
                <% } else if (f.kind === 'referential-select' && f.ontology) { %>
                  <%# Ch.18 Ontology (owner: "the schema has to pick the
                      values from the ontology... use a generic function") —
                      ONE branch for every ontology-backed referential-select
                      on any kind (Pack's category today; Template/
                      Profile whenever a future field carries the same
                      x-ontology:true marker). Which concept_type to show
                      comes from f.referentialSource (== the schema's
                      x-referential-source, verbatim); never a field-name
                      check here. %>
                  <select name="<%= f.name %>" class="form-select form-select-sm ontology-select" data-guidance-target="<%= f.name %>-guidance" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% var _ontOpts = ((locals.ontologyOptions || {})[f.referentialSource] || []); %>
                    <% _ontOpts.forEach(function(opt) { %><option value="<%= opt.code %>" data-description="<%= opt.description || '' %>" <%= f.value === opt.code ? 'selected' : '' %>><%= opt.label %></option><% }) %>
                    <% if (f.value && !_ontOpts.some(function(opt) { return opt.code === f.value; })) { %>
                      <option value="<%= f.value %>" selected>&#9888; <%= f.value %> (not currently active)</option>
                    <% } %>
                  </select>
                  <%# CR-023 (owner: "when the dropdown is chosen, show this as
                      guidance") — populated/updated by edit.ejs's script from
                      the selected option's data-description; empty (and
                      hidden by the script) when there isn't one. %>
                  <div id="<%= f.name %>-guidance" class="form-text small fst-italic"></div>
                <% } else if (f.kind === 'referential-select' && f.referentialSource === 'template-code') { %>
                  <%# Owner: "Why is code not auto generated?" — Template's
                      code became a system UUID too (migration 045), so this
                      picker (Profile's baseTemplateCode) needs Template's
                      `name` for legibility, same fix as the Pack pickers. %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% (locals.templateOptions || []).forEach(function(t) { %><option value="<%= t.code %>" <%= f.value === t.code ? 'selected' : '' %>><%= t.name %></option><% }) %>
                    <% if (f.value && !(locals.templateOptions || []).some(function(t) { return t.code === f.value; })) { %>
                      <option value="<%= f.value %>" selected>&#9888; <%= f.value %> (not currently Active)</option>
                    <% } %>
                  </select>
                <% } else if (f.kind === 'referential-select') { %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% ((locals.referentialOptions || {})[f.referentialSource] || []).forEach(function(opt) { %><option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </select>
                <% } else if (f.kind === 'referential-multi-select' && f.name === 'contributionPolicies') { %>
                  <%# CR-089 follow-on — owner: "Similar to services, pick the
                      ones that are applicable to the contributingCapabilities[]...
                      allow the user to check/uncheck to select/deselect a
                      policy." Checkbox grid, not a <select multiple> (a
                      canonical Policy isn't Ontology-backed, so the generic
                      branch below can't source it anyway) — every Active
                      Policy Definition, each carrying its own
                      data-deliverable-names for referentialListGroup.js's
                      live capability filter (dims, never hides/disables —
                      advisory, same "Pure UI advisories" discipline the Pack
                      Codes tab's own capability-coverage callouts use).
                      Posted as "contributionPolicies[]" — only CHECKED boxes
                      submit, so qs/Express collapse this into a clean,
                      gap-free string[] with zero extra plumbing (same
                      mechanism as the generic branch below). %>
                  <% var _polOptsEdit = locals.policyDefinitionOptions || []; %>
                  <script type="application/json" id="capability-deliverable-names-map"><%- JSON.stringify(locals.capabilityDeliverableNames || {}) %></script>
                  <div class="policy-checkbox-grid" data-field-name="contributionPolicies">
                    <% if (!_polOptsEdit.length) { %>
                      <div class="text-muted small">No Active canonical Policy Definitions yet.</div>
                    <% } %>
                    <% _polOptsEdit.forEach(function(pd) { %>
                      <div class="form-check mb-2 rlg-policy-row" data-deliverable-names="<%= (pd.applicabilityDeliverableNames || []).join(',') %>">
                        <input class="form-check-input rlg-policy-checkbox" type="checkbox" name="contributionPolicies[]" value="<%= pd.code %>" id="policy-check-<%= pd.code %>" <%= f.value.indexOf(pd.code) !== -1 ? 'checked' : '' %> <%- canEdit ? '' : 'disabled' %>>
                        <label class="form-check-label small" for="policy-check-<%= pd.code %>">
                          <strong><%= pd.name %></strong> <code class="text-muted small"><%= pd.code %></code>
                          <% if (pd.description) { %><div class="text-muted small"><%= pd.description %></div><% } %>
                        </label>
                      </div>
                    <% }) %>
                  </div>
                  <div class="form-text small">Dimmed policies don't obviously govern a deliverable-name this Pack's own declared Capabilities currently produce — check them anyway if you know better; nothing here is enforced.</div>
                <% } else if (f.kind === 'referential-multi-select' && f.driverField) { %>
                  <%# Owner: "what kind of coding is this? isn't this
                      fundamental?" — a driven multi-select (Policy's own
                      applicabilityDeliverableNames, by `scope`) must swap
                      LIVE the instant the driver changes, same standard the
                      single-value driven referential-select (dynamicOntologyField.js)
                      already meets — not just correctly-resolved after a
                      reload. Renders one <fieldset> per variant (each with
                      its own correct widget shape/options), all present in
                      the DOM; scopeDrivenMulti.js shows exactly one and
                      disables the rest — `disabled` on a <fieldset> cascades
                      to every descendant control, so a hidden variant's
                      values never submit alongside the visible one's. Only
                      the variant matching the driver's CURRENT value is
                      pre-filled with f.value — switching modes starts the
                      other variant empty rather than showing foreign
                      selections that don't apply to it. %>
                  <% var _currentDriverValue = fieldValueByName[f.driverField]; %>
                  <div class="scope-driven-multi" data-driver-field="<%= f.driverField %>">
                    <% f.variants.forEach(function(variant) { %>
                      <% var _namedMatches = f.variants.some(function(x) { return x.matchValue !== null && x.matchValue === _currentDriverValue; }); %>
                      <% var _isActive = variant.matchValue === null ? !_namedMatches : variant.matchValue === _currentDriverValue; %>
                      <% var _vOpts = variant.ontology ? ((locals.ontologyOptions || {})[variant.referentialSource] || []) : ((locals.referentialOptions || {})[variant.referentialSource] || []).map(function(s) { return { code: s, label: formatMultiOptionLabel(s) }; }); %>
                      <% var _vValue = _isActive ? f.value : []; %>
                      <fieldset class="scope-driven-variant" data-match-value="<%= variant.matchValue === null ? '' : variant.matchValue %>" data-is-default="<%= variant.matchValue === null ? '1' : '' %>" <%- (_isActive || !canEdit) ? '' : 'disabled' %> <%- _isActive ? '' : 'hidden' %>>
                        <% if (variant.ontology && variant.composable) { %>
                          <div class="ontology-multi-combo" data-field-name="<%= f.name %>" data-options='<%- escapeAttrJson(_vOpts) %>'>
                            <div class="ontology-multi-chips">
                              <% _vValue.forEach(function(v) { %>
                                <% var _matchedV = _vOpts.find(function(o) { return o.code === v; }); %>
                                <span class="ontology-chip">
                                  <input type="hidden" name="<%= f.name %>[]" value="<%= v %>">
                                  <span class="ontology-chip-label"><%= _matchedV ? _matchedV.label : v %></span>
                                  <% if (!_matchedV) { %><span class="ontology-chip-flag" title="Not yet in the Ontology — proposing on save">⚠</span><% } %>
                                  <% if (canEdit) { %><button type="button" class="ontology-chip-remove" aria-label="Remove">&times;</button><% } %>
                                </span>
                              <% }) %>
                            </div>
                            <% if (canEdit) { %>
                            <div class="ontology-combo">
                              <input class="ontology-combo-input form-control form-control-sm" autocomplete="off" placeholder="Pick or type a new value…">
                              <div class="ontology-combo-menu"></div>
                            </div>
                            <% } %>
                          </div>
                        <% } else { %>
                          <select name="<%= f.name %>[]" class="form-select form-select-sm" multiple size="6">
                            <% _vOpts.forEach(function(opt) { %>
                              <option value="<%= opt.code %>" <%= _vValue.indexOf(opt.code) !== -1 ? 'selected' : '' %>><%= opt.label %></option>
                            <% }) %>
                          </select>
                        <% } %>
                      </fieldset>
                    <% }) %>
                  </div>
                <% } else if (f.kind === 'referential-multi-select' && f.composable) { %>
                  <%# Owner: "flag in the schema that will specify if an
                      Ontology Composition is allowed" (x-ontology-composable)
                      — pick any number of existing Ontology options, or type
                      a value that isn't one yet; an unregistered typed value
                      proposes an OntologyComposed event on save instead of
                      being rejected (core/ontology.ts#proposeComposableOntologyValues),
                      same "propose, don't reject" split Pack's own `code`
                      combo already has at draft time. Each chip is a real
                      hidden input, so the field submits as a plain
                      "<name>[]" array with zero server-side special-casing —
                      composableMultiSelect.js only manipulates chips
                      client-side. %>
                  <div class="ontology-multi-combo" data-field-name="<%= f.name %>" data-options='<%- escapeAttrJson((locals.ontologyOptions || {})[f.referentialSource] || []) %>'>
                    <div class="ontology-multi-chips">
                      <% f.value.forEach(function(v) { %>
                        <% var _matchedChip = ((locals.ontologyOptions || {})[f.referentialSource] || []).find(function(o) { return o.code === v; }); %>
                        <span class="ontology-chip">
                          <input type="hidden" name="<%= f.name %>[]" value="<%= v %>">
                          <span class="ontology-chip-label"><%= _matchedChip ? _matchedChip.label : v %></span>
                          <% if (!_matchedChip) { %><span class="ontology-chip-flag" title="Not yet in the Ontology — proposing on save">⚠</span><% } %>
                          <% if (canEdit) { %><button type="button" class="ontology-chip-remove" aria-label="Remove">&times;</button><% } %>
                        </span>
                      <% }) %>
                    </div>
                    <% if (canEdit) { %>
                    <div class="ontology-combo">
                      <input class="ontology-combo-input form-control form-control-sm" autocomplete="off" placeholder="Pick or type a new value…">
                      <div class="ontology-combo-menu"></div>
                    </div>
                    <% } %>
                  </div>
                  <div class="form-text small">Pick as many as apply, or type a value that isn't listed yet — it will be proposed to the Ontology when saved, and must be accepted before this Policy can Publish.</div>
                <% } else if (f.kind === 'referential-multi-select') { %>
                  <%# CR-086/Ch.11 follow-on — Service Definition's own
                      `consumers`: same ontology-backed option source as a
                      single-value referential-select (f.ontology), just a
                      real multi-select. Posted as "<name>[]" so qs collapses
                      it back to a plain array under the schema's own field
                      name — parseFormBody's generic passthrough (no
                      referential-multi-select-specific branch needed there)
                      picks it up unchanged.
                      Owner: "applicabilityDeliverableLifecycle is not
                      OntologyComposable" — a non-Ontology multi-select
                      (f.ontology === false) sources its options from
                      referentialOptions (a plain string[] Registry source,
                      e.g. live transition_definitions states) instead of
                      ontologyOptions ({code,label}[]); each option's own
                      string is both its value and its label. %>
                  <select name="<%= f.name %>[]" class="form-select form-select-sm" multiple size="6" <%- canEdit ? '' : 'disabled' %>>
                    <% if (f.ontology) { %>
                      <% ((locals.ontologyOptions || {})[f.referentialSource] || []).forEach(function(opt) { %>
                        <option value="<%= opt.code %>" <%= f.value.indexOf(opt.code) !== -1 ? 'selected' : '' %>><%= opt.label %></option>
                      <% }) %>
                    <% } else { %>
                      <% ((locals.referentialOptions || {})[f.referentialSource] || []).forEach(function(opt) { %>
                        <option value="<%= opt %>" <%= f.value.indexOf(opt) !== -1 ? 'selected' : '' %>><%= formatMultiOptionLabel(opt) %></option>
                      <% }) %>
                    <% } %>
                  </select>
                  <div class="form-text small">Ctrl/Cmd-click to select more than one — leave empty for none.</div>
                <% } else if (f.kind === 'json') { %>
                  <textarea name="<%= f.name %>" class="form-control form-control-sm font-monospace" rows="4" <%- canEdit ? '' : 'disabled' %>><%= f.value %></textarea>
                <% } %>
                <% } %>
                <%# CR-081 — owner: "the help on the field should not be
                    obscuring the whole thing." Pack's own driven code combo
                    already renders its own specific inline help line above
                    (and the branch-picker panel below that) — this generic
                    schema-level f.help would be a THIRD stacked block of
                    small muted text right under it, purely redundant, adding
                    clutter rather than information. Suppressed for that one
                    case only; every other field's help is unaffected. %>
                <% if (f.help && !(f.kind === 'referential-select' && f.ontology && f.dynamicSourceField)) { %><div class="form-text small"><%= f.help %></div><% } %>
              </div>
              <% } %>
              <% } %>
            <% }) %>
          </div>
          <% if (t.id === 'compatibility') { %>
            <p class="text-muted small mt-3 mb-0">Declared for documentation today — composition doesn't yet enforce these (Ch.5 §19.9).</p>
          <% } %>

        <% } else if (t.type === 'exposableParameters') { %>
          <%# CR-088 — candidate-driven, not author-added: one row per
              configurable parameter the Template's currently-selected Packs
              actually carry (deriveExposableParameterCandidates,
              core/templates.ts — recomputed on every render, never trusted
              from stale saved content). Owner's own settled mechanism:
              value-bearing candidates (Service Level metrics, Policy's
              constraintType) get an editable value plus a checkbox; list/
              filter candidates (Policy's three applicability dimensions,
              Checklist's configurableKey) get a checkbox only. Checked =
              "a Profile may override this" — every candidate starts checked.
              Submitted as indexed exposedParamRows[i][...], reassembled into
              the real exposedParameters[] by the web route
              (reconstructExposedParameters, sdkAuthoring.ts) before
              parseFormBody ever runs — this field has no author-typed rows
              for that generic machinery to parse in the first place. %>
          <p class="text-muted small mb-2">Which of this Template's configurable parameters a Profile may override, and this Template's own value for the ones it sets. Recomputed from the Pack Codes tab's current selections — a parameter whose Pack was deselected drops off automatically.</p>
          <% var epRows = locals.exposableParameterRows || []; %>
          <% if (!epRows.length) { %>
            <p class="text-muted small mb-0">None yet — the currently-selected Packs (Pack Codes tab) don't carry any Service Level targets, Policies, or configurable Checklist items.</p>
          <% } else { %>
            <% var epGroups = [
              { sourceType: 'service', label: 'Service Level' },
              { sourceType: 'policy', label: 'Policy' },
              { sourceType: 'checklist', label: 'Checklist' },
              { sourceType: 'dependency', label: 'Deliverable Dependency' },
            ]; %>
            <% epGroups.forEach(function(g) { %>
              <% var groupRows = []; epRows.forEach(function(row, idx) { if (row.sourceType === g.sourceType) groupRows.push({ row: row, idx: idx }); }); %>
              <% if (groupRows.length) { %>
                <div class="mb-3">
                  <div class="text-uppercase text-muted small fw-semibold mb-1"><%= g.label %></div>
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <tbody>
                        <% groupRows.forEach(function(entry) { %>
                          <% var row = entry.row, i = entry.idx; %>
                          <tr>
                            <td class="small text-nowrap"><%= row.sourceName %></td>
                            <td class="small text-nowrap text-muted"><%= row.parameterLabel %></td>
                            <td class="small">
                              <% if (canEdit) { %>
                                <input type="hidden" name="exposedParamRows[<%= i %>][sourceType]" value="<%= row.sourceType %>">
                                <input type="hidden" name="exposedParamRows[<%= i %>][sourceCode]" value="<%= row.sourceCode %>">
                                <input type="hidden" name="exposedParamRows[<%= i %>][parameterName]" value="<%= row.parameterName %>">
                              <% } %>
                              <% if (row.valueBearing) { %>
                                <% if (row.valueOptions && row.valueOptions.length) { %>
                                  <% if (!canEdit) { %><%= row.value || '—' %><% } else { %>
                                  <select name="exposedParamRows[<%= i %>][value]" class="form-select form-select-sm" style="max-width: 12rem;">
                                    <% row.valueOptions.forEach(function(opt) { %>
                                      <option value="<%= opt %>" <%= row.value === opt ? 'selected' : '' %>><%= opt %></option>
                                    <% }) %>
                                  </select>
                                  <% } %>
                                <% } else { %>
                                  <% if (!canEdit) { %><%= row.value || '—' %><% } else { %>
                                  <input type="text" name="exposedParamRows[<%= i %>][value]" class="form-control form-control-sm" style="max-width: 10rem;" value="<%= row.value %>">
                                  <% } %>
                                <% } %>
                              <% } else { %>
                                <span class="text-muted">—</span>
                              <% } %>
                            </td>
                            <td class="small text-nowrap">
                              <div class="form-check mb-0">
                                <input type="checkbox" class="form-check-input" name="exposedParamRows[<%= i %>][overridable]" value="true" <%= row.overridable ? 'checked' : '' %> <%- canEdit ? '' : 'disabled' %>>
                                <label class="form-check-label small text-muted">Profile may override</label>
                              </div>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% } %>
            <% }) %>
          <% } %>

        <% } else if (t.type === 'parameterOverrides') { %>
          <%# CR-088 Profile-side completion — candidate-driven, same
              discipline as the Exposable Parameters tab above: one row per
              parameter this Profile's base Template flagged overridable
              (deriveOverridableParameterCandidates, core/templates.ts —
              recomputed fresh on every render off baseTemplateCode). Blank
              means "no override, use the Template's own value" — never
              pre-filled with that value, so a blank input can't be mistaken
              for an applied override. Submitted as indexed
              exposedParamOverrideRows[i][...], reassembled into the real
              exposedParameterOverrides[] by the web route
              (reconstructProfileParameterOverrides, sdkAuthoring.ts) before
              parseFormBody ever runs, same as Template's own tab. %>
          <p class="text-muted small mb-2">This Profile's own value for whichever of its base Template's configurable parameters the Template allows a Profile to override. Leave blank to keep the Template's own value.</p>
          <% var poRows = locals.exposedParameterOverrideRows || []; %>
          <% if (!poRows.length) { %>
            <p class="text-muted small mb-0">None yet — the base Template (Identity &amp; Metadata tab) hasn't flagged any of its configurable parameters as overridable.</p>
          <% } else { %>
            <% var poGroups = [
              { sourceType: 'service', label: 'Service Level' },
              { sourceType: 'policy', label: 'Policy' },
              { sourceType: 'checklist', label: 'Checklist' },
              { sourceType: 'dependency', label: 'Deliverable Dependency' },
            ]; %>
            <% poGroups.forEach(function(g) { %>
              <% var groupRows = []; poRows.forEach(function(row, idx) { if (row.sourceType === g.sourceType) groupRows.push({ row: row, idx: idx }); }); %>
              <% if (groupRows.length) { %>
                <div class="mb-3">
                  <div class="text-uppercase text-muted small fw-semibold mb-1"><%= g.label %></div>
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <tbody>
                        <% groupRows.forEach(function(entry) { %>
                          <% var row = entry.row, i = entry.idx; %>
                          <tr>
                            <td class="small text-nowrap"><%= row.sourceName %></td>
                            <td class="small text-nowrap text-muted"><%= row.parameterLabel %></td>
                            <td class="small text-nowrap text-muted">Template default: <%= row.defaultValue || '—' %></td>
                            <td class="small">
                              <% if (canEdit) { %>
                                <input type="hidden" name="exposedParamOverrideRows[<%= i %>][sourceType]" value="<%= row.sourceType %>">
                                <input type="hidden" name="exposedParamOverrideRows[<%= i %>][sourceCode]" value="<%= row.sourceCode %>">
                                <input type="hidden" name="exposedParamOverrideRows[<%= i %>][parameterName]" value="<%= row.parameterName %>">
                              <% } %>
                              <% if (row.valueOptions && row.valueOptions.length) { %>
                                <% if (!canEdit) { %><%= row.value || '—' %><% } else { %>
                                <select name="exposedParamOverrideRows[<%= i %>][value]" class="form-select form-select-sm" style="max-width: 12rem;">
                                  <option value="">— use Template default —</option>
                                  <% row.valueOptions.forEach(function(opt) { %>
                                    <option value="<%= opt %>" <%= row.value === opt ? 'selected' : '' %>><%= opt %></option>
                                  <% }) %>
                                </select>
                                <% } %>
                              <% } else { %>
                                <% if (!canEdit) { %><%= row.value || '—' %><% } else { %>
                                <input type="text" name="exposedParamOverrideRows[<%= i %>][value]" class="form-control form-control-sm" style="max-width: 10rem;" value="<%= row.value %>" placeholder="<%= row.defaultValue || '' %>">
                                <% } %>
                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% } %>
            <% }) %>
          <% } %>

        <% } else { %>
          <%# CR-058 form redesign (owner: "the help should be against each
              field instead of a write-up at the top... the form is very
              very poorly designed") — Quality Gates, Review Gates (CR-059),
              Checklists (CR-060), Policies (CR-061), Obligation Definitions
              (CR-062), and Services (CR-064) all now carry real per-field
              help (items.properties.someField's own x-help, rendered inline
              by _referentialListGroup.ejs — including nested-list items,
              e.g. Checklist's own items[]/Service's own serviceLevel[]), so
              the once-per-section write-up + field-name bullet list below is
              suppressed for each. Dependencies doesn't have inline help
              yet, so keep this fallback unchanged for it. %>
          <% var SECTIONS_WITH_INLINE_HELP = ['contributionQualityGates', 'contributionReviewGates', 'contributionChecklists', 'contributionPolicies', 'contributionObligationDefinitions', 'contributionServices']; %>
          <% if (t.id === 'dependencies') { %>
            <p class="text-muted small mb-2">Other Packs this one requires, allows alongside, or is incompatible with. A "required" dependency must resolve to a real, Active Pack.</p>
          <% } else if (SECTIONS_WITH_INLINE_HELP.indexOf(t.id) === -1 && (locals.contributionHelp || {})[t.helpKey]) { %>
            <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i><%= contributionHelp[t.helpKey] %></p>
          <% } %>
          <% var relevantVerifiableFields = (t.type === 'referential-list' && SECTIONS_WITH_INLINE_HELP.indexOf(t.id) === -1) ? t.field.itemFields.filter(function(itemField){ return VERIFIABLE_FIELD_NAMES.indexOf(itemField.name) !== -1; }) : []; %>
          <% if (relevantVerifiableFields.length) { %>
            <ul class="text-muted small mb-3 ps-3">
              <% relevantVerifiableFields.forEach(function(itemField) { %>
                <% if ((locals.verifiableFieldHelp || {})[itemField.name]) { %>
                  <li><strong><%= itemField.name %></strong> — <%= verifiableFieldHelp[itemField.name] %></li>
                <% } %>
              <% }) %>
            </ul>
          <% } %>
          <% if (t.type === 'json' && !canEdit) { %>
            <pre class="small bg-light border rounded p-2 mb-0"><%= t.field.value %></pre>
          <% } else if (t.type === 'json') { %>
            <textarea name="<%= t.field.name %>" class="form-control form-control-sm font-monospace" rows="6" <%- canEdit ? '' : 'disabled' %>><%= t.field.value %></textarea>
          <% } else { %>
            <%- include('_referentialListGroup', { field: t.field, canEdit: canEdit, referentialOptions: locals.referentialOptions, ontologyOptions: locals.ontologyOptions, packDependencyOptions: locals.packDependencyOptions, checklistOptions: locals.checklistOptions, policyOptions: locals.policyOptions, serviceDefinitionOptions: locals.serviceDefinitionOptions, renderMarkdown: locals.renderMarkdown, fieldValueByName: fieldValueByName }) %>
          <% } %>
        <% } %>

      </div>
    <% }) %>
  </div>
  </div>
<% } %>
