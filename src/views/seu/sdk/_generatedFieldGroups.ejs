<%# Grouped, TABBED rendering of a groupFieldsForDisplay() result — the Pack/
    Template/Profile authoring redesign (owner: "extremely unfriendly", then
    "each of the sections ... has to be a separate tab"). Every section —
    Identity & Metadata, Compatibility, Dependencies, and each individual
    Contribution type — is its own Bootstrap tab, not a stacked card or a
    nested accordion; only one section's fields are on screen at a time.
    Locals: groups (FieldGroups), canEdit (bool), referentialOptions,
    contributionHelp (Record<string,string>), verifiableFieldHelp
    (Record<string,string>), sections (string[], optional — which of
    metadata/compatibility/dependencies/contributions to include; omitted =
    all), idPrefix (string, optional — keeps tab/pane element ids unique when
    this partial is included more than once on the same page, e.g. once per
    stepper pane).
    Self-contained — doesn't share markup with _generatedFields.ejs, which the
    schema-registry's own meta-schema form still uses unchanged, so this
    redesign carries zero risk to that page. %>
<%
  var sections = locals.sections || ['metadata', 'compatibility', 'dependencies', 'contributions'];
  var wantSection = function(key) { return sections.indexOf(key) !== -1; };
  var idPrefix = locals.idPrefix || 'sec';
  var simpleFields = (locals.groups.other || []).concat(locals.groups.metadata || []);
  var VERIFIABLE_FIELD_NAMES = ['statement','classification','prompt','participant','outputContract','assurance','externalEvidence'];

  // One entry per TAB — 'simple' (a plain field grid: Identity & Metadata,
  // Compatibility), 'referential-list' (Dependencies + most Contribution
  // types), or 'json' (Contributions still using a raw-JSON widget, e.g.
  // Compliance). hasContent decides which tab opens active by default — jump
  // the author straight to whichever section already has real data, same
  // intent the old accordion's "collapsed unless populated" had.
  var tabs = [];
  if (wantSection('metadata') && simpleFields.length) {
    tabs.push({ id: 'metadata', label: 'Identity & Metadata', type: 'simple', fields: simpleFields, hasContent: false });
  }
  if (wantSection('compatibility') && (locals.groups.compatibility || []).length) {
    tabs.push({ id: 'compatibility', label: 'Compatibility', type: 'simple', fields: locals.groups.compatibility, hasContent: false });
  }
  if (wantSection('dependencies') && locals.groups.dependencies) {
    var depField = locals.groups.dependencies;
    tabs.push({ id: 'dependencies', label: 'Dependencies', type: 'referential-list', field: depField, count: depField.existingCount, hasContent: depField.rows.slice(0, depField.existingCount).length > 0 });
  }
  if (wantSection('contributions')) {
    (locals.groups.contributions || []).forEach(function (c) {
      var f = c.field;
      var hasContent = f.kind === 'referential-list' ? f.rows.slice(0, f.existingCount).length > 0 : (f.value && f.value.trim() !== '{}' && f.value.trim() !== '[]' && f.value.trim() !== '');
      tabs.push({ id: c.key, label: c.label, type: f.kind === 'json' ? 'json' : 'referential-list', field: f, helpKey: c.key, count: f.kind === 'referential-list' ? f.existingCount : 0, hasContent: hasContent });
    });
  }
  var defaultActive = tabs.findIndex(function (t) { return t.hasContent; });
  if (defaultActive === -1) defaultActive = 0;
%>


<%# CR-027 — vertical tab sidebar for the generated form's own sections
    (Identity & Metadata / Compatibility / Dependencies / each Contribution
    type) — Pack's Draft can easily run to 8+ of these, which read as plain
    text crammed into one horizontal row. `defaultActive` still decides which
    pane opens first (whichever section already has real content), so
    verticalTabs' own "first tab active" default is overridden below by
    re-marking the right button/pane active. %>
<% if (tabs.length) { %>
  <div class="d-flex flex-column flex-md-row gap-4 align-items-start mb-4">
  <%- include('../../partials/verticalTabs', {
    tabs: tabs.map(function (t) { return { key: t.id, label: t.label, sub: t.count ? '<span class="badge bg-primary-subtle text-primary">' + t.count + '</span>' : '' }; }),
    paneMode: true,
    paneIdPrefix: idPrefix,
    activePaneIndex: defaultActive,
  }) %>
  <div class="tab-content flex-grow-1" style="min-width: 0;">
    <% tabs.forEach(function (t, i) { %>
      <div class="tab-pane fade <%= i === defaultActive ? 'show active' : '' %>" id="<%= idPrefix %>-<%= t.id %>" role="tabpanel">

        <% if (t.type === 'simple') { %>
          <div class="row g-3">
            <% t.fields.forEach(function(f) { %>
              <% if (f.kind === 'referential-list') { %>
                <%# Bug fix (owner: "Does New Template have a similar form
                    that Pack has?"): a referential-list field (Template's
                    mandatoryPackCodes, Profile's optionalPackCodes) bucketed
                    into this "simple" grid by NAME (groupFieldsForDisplay's
                    METADATA_FIELD_NAMES) but was never handled by this loop's
                    kind switch below (string/select/referential-select/json
                    only) — the label rendered, the control silently didn't.
                    Full width (col-12, not col-md-6 — a repeatable-row widget
                    needs the room), same partial Pack's own Dependencies tab
                    uses. %>
                <div class="col-12">
                  <label class="form-label small fw-semibold"><%= f.label %><% if (f.required) { %> <span class="text-danger">*</span><% } %></label>
                  <%- include('_referentialListGroup', { field: f, canEdit: canEdit, referentialOptions: locals.referentialOptions, packDependencyOptions: locals.packDependencyOptions }) %>
                  <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>
                </div>
              <% } else { %>
              <div class="col-md-6">
                <label class="form-label small fw-semibold"><%= f.label %><% if (f.required) { %> <span class="text-danger">*</span><% } %></label>
                <% if (f.kind === 'version') { %>
                  <%# Owner: "Version should be autogenerated using a next
                      version button. Editable text is not the correct
                      approach." — CR-024 generalised this off a hardcoded
                      `f.name === 'packVersion'` check (Pack's only, once)
                      onto `x-widget: "version"` (any kind — Template's
                      `templateVersion` uses the exact same mechanism now).
                      Readonly (not disabled, so it still submits), advanced
                      only by this field's own "Next version" button
                      (patch-bump, edit.ejs's script, generic over
                      .version-field); a fresh draft is pre-seeded 1.0.0 by
                      the route, never typed. %>
                  <div class="input-group input-group-sm">
                    <input id="<%= f.name %>-field" name="<%= f.name %>" class="form-control form-control-sm font-monospace version-field" value="<%= f.value %>" readonly required>
                    <% if (canEdit) { %>
                      <button type="button" class="btn btn-outline-secondary next-version-btn" data-version-target="<%= f.name %>-field"><i class="bi bi-arrow-up-circle me-1"></i>Next version</button>
                    <% } %>
                  </div>
                  <div class="form-text small">Auto-generated — semver, bumped by the button, never hand-typed.</div>
                <% } else if (f.kind === 'string') { %>
                  <input name="<%= f.name %>" class="form-control form-control-sm" value="<%= f.value %>" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                <% } else if (f.kind === 'textarea') { %>
                  <textarea name="<%= f.name %>" class="form-control form-control-sm" rows="3" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>><%= f.value %></textarea>
                <% } else if (f.kind === 'select') { %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% f.options.forEach(function(opt) { %><option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </select>
                <% } else if (f.kind === 'referential-select' && f.ontology) { %>
                  <%# Ch.18 Ontology (owner: "the schema has to pick the
                      values from the ontology... use a generic function") —
                      ONE branch for every ontology-backed referential-select
                      on any kind (Pack's code/category today; Template/
                      Profile whenever a future field carries the same
                      x-ontology:true marker). Which concept_type to show
                      comes from f.referentialSource (== the schema's
                      x-referential-source, verbatim); never a field-name
                      check here. %>
                  <select name="<%= f.name %>" class="form-select form-select-sm ontology-select" data-guidance-target="<%= f.name %>-guidance" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% var _ontOpts = ((locals.ontologyOptions || {})[f.referentialSource] || []); %>
                    <% _ontOpts.forEach(function(opt) { %><option value="<%= opt.code %>" data-description="<%= opt.description || '' %>" <%= f.value === opt.code ? 'selected' : '' %>><%= opt.label %></option><% }) %>
                    <% if (f.value && !_ontOpts.some(function(opt) { return opt.code === f.value; })) { %>
                      <option value="<%= f.value %>" selected>&#9888; <%= f.value %> (not currently active)</option>
                    <% } %>
                  </select>
                  <%# CR-023 (owner: "when the dropdown is chosen, show this as
                      guidance") — populated/updated by edit.ejs's script from
                      the selected option's data-description; empty (and
                      hidden by the script) when there isn't one. %>
                  <div id="<%= f.name %>-guidance" class="form-text small fst-italic"></div>
                <% } else if (f.kind === 'referential-select' && f.referentialSource === 'template-code') { %>
                  <%# Owner: "Why is code not auto generated?" — Template's
                      code became a system UUID too (migration 045), so this
                      picker (Profile's baseTemplateCode) needs Template's
                      `name` for legibility, same fix as the Pack pickers. %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% (locals.templateOptions || []).forEach(function(t) { %><option value="<%= t.code %>" <%= f.value === t.code ? 'selected' : '' %>><%= t.name %></option><% }) %>
                    <% if (f.value && !(locals.templateOptions || []).some(function(t) { return t.code === f.value; })) { %>
                      <option value="<%= f.value %>" selected>&#9888; <%= f.value %> (not currently Active)</option>
                    <% } %>
                  </select>
                <% } else if (f.kind === 'referential-select') { %>
                  <select name="<%= f.name %>" class="form-select form-select-sm" <%- f.required ? 'required' : '' %> <%- canEdit ? '' : 'disabled' %>>
                    <option value="">— select —</option>
                    <% ((locals.referentialOptions || {})[f.referentialSource] || []).forEach(function(opt) { %><option value="<%= opt %>" <%= f.value === opt ? 'selected' : '' %>><%= opt %></option><% }) %>
                  </select>
                <% } else if (f.kind === 'json') { %>
                  <textarea name="<%= f.name %>" class="form-control form-control-sm font-monospace" rows="4" <%- canEdit ? '' : 'disabled' %>><%= f.value %></textarea>
                <% } %>
                <% if (f.help) { %><div class="form-text small"><%= f.help %></div><% } %>
              </div>
              <% } %>
            <% }) %>
          </div>
          <% if (t.id === 'compatibility') { %>
            <p class="text-muted small mt-3 mb-0">Declared for documentation today — composition doesn't yet enforce these (Ch.5 §19.9).</p>
          <% } %>

        <% } else { %>
          <% if (t.id === 'dependencies') { %>
            <p class="text-muted small mb-2">Other Packs this one requires, allows alongside, or is incompatible with. A "required" dependency must resolve to a real, Active Pack.</p>
          <% } else if ((locals.contributionHelp || {})[t.helpKey]) { %>
            <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i><%= contributionHelp[t.helpKey] %></p>
          <% } %>
          <% var relevantVerifiableFields = t.type === 'referential-list' ? t.field.itemFields.filter(function(itemField){ return VERIFIABLE_FIELD_NAMES.indexOf(itemField.name) !== -1; }) : []; %>
          <% if (relevantVerifiableFields.length) { %>
            <ul class="text-muted small mb-3 ps-3">
              <% relevantVerifiableFields.forEach(function(itemField) { %>
                <% if ((locals.verifiableFieldHelp || {})[itemField.name]) { %>
                  <li><strong><%= itemField.name %></strong> — <%= verifiableFieldHelp[itemField.name] %></li>
                <% } %>
              <% }) %>
            </ul>
          <% } %>
          <% if (t.type === 'json') { %>
            <textarea name="<%= t.field.name %>" class="form-control form-control-sm font-monospace" rows="6" <%- canEdit ? '' : 'disabled' %>><%= t.field.value %></textarea>
          <% } else { %>
            <%- include('_referentialListGroup', { field: t.field, canEdit: canEdit, referentialOptions: locals.referentialOptions, packDependencyOptions: locals.packDependencyOptions }) %>
          <% } %>
        <% } %>

      </div>
    <% }) %>
  </div>
  </div>
<% } %>
