<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Schema Registry</h2>
      <p class="text-muted small mb-0">
        The grammar behind each of the four authoring surfaces is data, not a hardcoded file — versioned the same way
        Pack itself is (SDK UI Layer Plan). A new version is always additive: it never edits an existing row, and an
        already-authored document stays checked against exactly the version it declared, permanently.
      </p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/sdk/schema-registry'; %>
    <%- include('../../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search kind' }) %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <table class="table table-sm align-middle mb-0">
          <thead><tr>
            <th><%- sortLink('Kind', 'kind', list, _base) %></th>
            <th><%- sortLink('Version', 'version', list, _base) %></th>
            <th><%- sortLink('Created', 'created', list, _base) %></th>
            <th></th>
          </tr></thead>
          <tbody>
            <% list.items.forEach(function(s) { %>
              <tr>
                <td><span class="badge bg-light text-dark border"><%= s.entityKind %></span></td>
                <td>v<%= s.version %></td>
                <td class="text-muted small"><%= new Date(s.createdAt).toLocaleString() %></td>
                <td><a class="btn btn-sm btn-outline-primary" href="/aisworg/seu/sdk/schema-registry/<%= s.id %>">View</a></td>
              </tr>
            <% }) %>
            <% if (list.total === 0) { %>
              <tr><td colspan="4" class="text-muted small text-center py-3"><%= list.q ? 'No schema versions match your search.' : 'No schema versions yet.' %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <h6 class="text-uppercase text-muted small fw-bold mb-2">New version — form</h6>
        <p class="text-muted small mb-3">
          Author a grammar in a form (CR-017): the field list is generated from a meta-schema and compiled to the
          stored JSON Schema. Starts from the kind's current version so you evolve it.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <% kinds.forEach(function(k) { %>
            <a class="btn btn-sm btn-primary" href="/aisworg/seu/sdk/schema-registry/new?entityKind=<%= k %>"><i class="bi bi-pencil-square me-1"></i>New <%= k %> version</a>
          <% }) %>
        </div>
      </div>
    </div>

    <details class="card border-0 shadow-sm">
      <summary class="card-body pb-0" style="cursor: pointer;"><span class="text-uppercase text-muted small fw-bold">Advanced — raw JSON</span></summary>
      <div class="card-body pt-2">
        <p class="text-muted small mb-2">For grammars the form can't express (e.g. nested repeatable-list item structures), paste the JSON Schema directly.</p>
        <form method="POST" action="/aisworg/seu/sdk/schema-registry">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-2" style="max-width: 220px;">
            <label class="form-label small mb-1">Entity kind</label>
            <select name="entityKind" class="form-select form-select-sm" required>
              <% kinds.forEach(function(k) { %><option value="<%= k %>"><%= k %></option><% }) %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Schema JSON</label>
            <textarea name="schemaJson" class="form-control form-control-sm font-monospace" rows="10" placeholder='{ "type": "object", "required": [...], "properties": { ... } }'></textarea>
          </div>
          <button type="submit" class="btn btn-sm btn-outline-secondary">Create version (raw)</button>
        </form>
      </div>
    </details>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
