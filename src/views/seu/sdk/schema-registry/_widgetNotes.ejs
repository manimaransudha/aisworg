<%# CR-114 — x-schema-notes editor: an append-only {date, note} log, author-only,
    never read by formGenerator/validateAgainstSchema. Same widget wherever it's
    used — the document root (schema-registry/new.ejs) or a single field's own
    notes (here, nested inside _widgetRow.ejs). Locals: notes (AuthoredNote[]),
    namePrefix (e.g. "notes" or "widgets[0][notes]"). %>
<div class="wt-notes-list border rounded p-2 bg-light-subtle" data-name-prefix="<%= namePrefix %>" data-next-index="<%= notes.length %>">
  <% notes.forEach(function(n, i) { %>
    <div class="wt-note-row row g-2 align-items-center mb-1">
      <div class="col-auto"><input type="date" name="<%= namePrefix %>[<%= i %>][date]" class="form-control form-control-sm" value="<%= n.date %>"></div>
      <div class="col"><input name="<%= namePrefix %>[<%= i %>][note]" class="form-control form-control-sm" placeholder="Note" value="<%= n.note %>"></div>
      <div class="col-auto"><button type="button" class="btn btn-sm btn-outline-danger wt-note-remove"><i class="bi bi-x"></i></button></div>
    </div>
  <% }) %>
  <button type="button" class="btn btn-sm btn-link wt-note-add p-0"><i class="bi bi-plus-circle me-1"></i>Add note</button>
</div>
