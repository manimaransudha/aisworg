<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <p class="text-muted small mb-1"><a href="/aisworg/seu/sdk/schema-registry">&larr; Schema Registry</a></p>
        <h2 class="h3 mb-1 text-dark fw-bold">
          <%= schema.entityKind %> — v<%= schema.version %>
          <span class="badge bg-<%= schema.lifecycleState === 'Published' ? 'success' : schema.lifecycleState === 'PublicationRejected' ? 'danger' : 'secondary' %> ms-2"><%= schema.lifecycleState %></span>
        </h2>
        <p class="text-muted small mb-0">Created <%= new Date(schema.createdAt).toLocaleString() %>. Schema/version are immutable — a new edit is always a new version, never a change to this row.</p>
        <% if (schema.authorBadge) { %><p class="text-muted small mb-0">Last governed under <%= schema.authorBadge %>.</p><% } %>
      </div>
      <% if (schema.lifecycleState === 'Packaged') { %>
        <div class="d-flex gap-2">
          <form method="POST" action="/aisworg/seu/sdk/schema-registry/<%= schema.id %>/publish">
            <button type="submit" class="btn btn-success btn-sm">Publish</button>
          </form>
          <form method="POST" action="/aisworg/seu/sdk/schema-registry/<%= schema.id %>/reject">
            <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
          </form>
        </div>
      <% } %>
    </div>

    <div class="section-card mb-4">
      <div class="section-header">Compatibility (CR-114)</div>
      <div class="card-body">
        <% if (!schema.compatibleVersions.length && !schema.incompatibleVersions.length) { %>
          <p class="text-muted small mb-0">No prior version of <%= schema.entityKind %> to compare against — this was the first version.</p>
        <% } else { %>
          <p class="small mb-1">
            Compatible with:
            <% if (schema.compatibleVersions.length) { %>
              <% schema.compatibleVersions.forEach(function(v) { %><span class="badge bg-light text-dark border me-1">v<%= v %></span><% }) %>
            <% } else { %><span class="text-muted">none</span><% } %>
          </p>
          <p class="small mb-0">
            Incompatible with:
            <% if (schema.incompatibleVersions.length) { %>
              <% schema.incompatibleVersions.forEach(function(v) { %><span class="badge bg-danger-subtle text-danger border me-1">v<%= v %></span><% }) %>
            <% } else { %><span class="text-muted">none</span><% } %>
          </p>
        <% } %>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header">Schema JSON</div>
      <div class="card-body">
        <pre class="mb-0 small" style="white-space: pre-wrap;"><%= schema.schemaJson %></pre>
      </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
