<%# One referential-list field. Editable (canEdit): a stack of labeled cards
    (not a horizontal strip of unlabeled inline boxes) — existing rows shown
    filled, exactly one blank "New item" row at the end doubling as the clone
    template for the "+ Add another" button (edit.ejs's script). Read-only
    (!canEdit, owner: "The view should show the details... just not
    editable, showing dropdowns etc"): plain text rows, existing content
    only — no disabled controls, no blank offered row, no Add/Remove.
    Locals: field (GeneratedField, kind referential-list), canEdit (bool),
    referentialOptions, packDependencyOptions (PackDependencyOption[] —
    name/code/version/category of every Active Pack visible to this viewer;
    used by Dependencies AND any other referential-list whose item field
    sources "pack-code" — Template's mandatoryPackCodes, Profile's
    optionalPackCodes). %>
<%
  function ilabel(n) { return n.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, function(c){ return c.toUpperCase(); }); }
  var isDependencies = field.name === 'dependencies';
  var packOptions = locals.packDependencyOptions || [];
  var categoryOptions = (locals.referentialOptions || {})['pack-category'] || [];
  var typeItemField = isDependencies ? field.itemFields.find(function(f) { return f.name === 'type'; }) : null;
%>
<% if (!canEdit) { %>
  <%# View mode — plain read rows, not disabled form controls (owner: "The
      view should show the details... just not editable, showing dropdowns
      etc" — a disabled <select> still renders as an interactive-looking
      dropdown even though it does nothing). Only real, existing rows: the
      blank "New item" rows generateFields() always appends for the edit
      form's own convenience have nothing to show here. Referential values
      resolve to the same human-readable label their <option> would have
      shown (Pack name + version, Ontology label) rather than a bare code. %>
  <%
    // Owner: "Item 1 / Pack Code - this is all not adding any value in a
    // view form. It should just list the code, name, and a link to view the
    // pack." — a row that's just ONE Pack-code reference (Template's six
    // category fields, its legacy mandatoryPackCodes, Profile's
    // optionalPackCodes/four category fields) gets a compact list line
    // instead of an "Item N" card; Dependencies (Pack + Type) gets the same
    // compact treatment with Type alongside. Any OTHER shape (Deliverable
    // Catalogue, Dependency Graph — no Pack reference involved) keeps the
    // card layout below, unchanged.
    var soloPackCodeField = (!isDependencies && field.itemFields.length === 1 && field.itemFields[0].kind === 'referential' && field.itemFields[0].referentialSource.indexOf('pack-code') === 0) ? field.itemFields[0] : null;
    function packLink(matchedPack) {
      return matchedPack ? ('<a href="/aisworg/seu/sdk/pack-authoring/' + matchedPack.id + '" class="btn btn-sm btn-link p-0">View</a>') : '';
    }
  %>
  <% var existingRows = field.rows.slice(0, field.existingCount); %>
  <% if (existingRows.length === 0) { %>
    <p class="text-muted small mb-0">None</p>
  <% } else if (isDependencies || soloPackCodeField) { %>
    <ul class="list-group list-group-flush">
      <% existingRows.forEach(function(row) { %>
        <% var pv = isDependencies ? (row.packCode || '') : (row[soloPackCodeField.name] || ''); %>
        <% var matchedPack = packOptions.find(function(p) { return p.code === pv; }); %>
        <li class="list-group-item px-0 d-flex justify-content-between align-items-center small">
          <span>
            <% if (matchedPack) { %>
              <%= matchedPack.name %> <code class="text-muted"><%= matchedPack.code %></code> <span class="text-muted">v<%= matchedPack.version %></span>
            <% } else if (pv) { %>
              ⚠ <%= pv %> (not currently Active)
            <% } else { %>
              —
            <% } %>
            <% if (isDependencies) { %><span class="badge bg-light text-dark border ms-2"><%= row.type || '—' %></span><% } %>
          </span>
          <%- packLink(matchedPack) %>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <% existingRows.forEach(function(row, i) { %>
      <div class="card card-body bg-light border-0 mb-2">
        <div class="mb-2"><span class="badge bg-secondary-subtle text-secondary small fw-normal">Item <%= i + 1 %></span></div>
        <div class="row g-2">
          <% field.itemFields.forEach(function(itemField) { %>
            <% var value = row[itemField.name] || ''; %>
            <div class="col-sm-6 col-lg-4">
              <div class="small text-muted mb-1"><%= ilabel(itemField.name) %></div>
              <div class="small">
                <% if (itemField.kind === 'boolean') { %>
                  <%= value === 'true' ? 'Yes' : 'No' %>
                <% } else if (itemField.kind === 'referential' && itemField.referentialSource.indexOf('pack-code') === 0) { %>
                  <% var _fixedCategory = itemField.referentialSource.indexOf(':') !== -1 ? itemField.referentialSource.split(':')[1] : ''; %>
                  <% var matchedItemPack = packOptions.find(function(p) { return p.code === value; }); %>
                  <% if (matchedItemPack) { %>
                    <%= matchedItemPack.name %> <code class="text-muted"><%= matchedItemPack.code %></code> v<%= matchedItemPack.version %> <%- packLink(matchedItemPack) %>
                  <% } else { %>
                    <%= value ? ('⚠ ' + value + ' (not currently Active' + (_fixedCategory ? ' / not ' + _fixedCategory : '') + ')') : '—' %>
                  <% } %>
                <% } else { %>
                  <%= value || '—' %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } %>
<% } else { %>
<div class="referential-list-group" data-field-name="<%= field.name %>" data-next-index="<%= field.rows.length %>">
  <% field.rows.forEach(function(row, i) { %>
    <% var isExisting = i < field.existingCount; %>
    <div class="card card-body bg-light border-0 mb-2 referential-list-row">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge <%= isExisting ? 'bg-secondary-subtle text-secondary' : 'bg-light text-muted border' %> small fw-normal"><%= isExisting ? ('Item ' + (i + 1)) : 'New item — fill in to add' %></span>
        <% if (canEdit) { %><button type="button" class="btn btn-sm btn-link text-danger p-0 remove-row-btn">Remove</button><% } %>
      </div>

      <% if (isDependencies) { %>
        <%# Owner: "Pack code should include the pack and the version number
            in the dropdown. Version should not be a text field... There
            should also have a dropdown on the category." — Category is a
            client-side filter only (never submitted — dependencies don't
            carry a category of their own); Pack's <option>s carry the real
            data-version/data-category the two scripts below read; Version is
            no longer its own visible box at all (owner: "remove the text
            version field") — the Pack option already names its version, and
            the value the seed actually stores now travels as a hidden input,
            kept in sync with whichever Pack is selected by the same script. %>
        <% var pv = row.packCode || ''; %>
        <% var knownPack = packOptions.some(function(p) { return p.code === pv; }); %>
        <input type="hidden" name="<%= field.name %>[<%= i %>][version]" class="dep-version-field" value="<%= row.version || '' %>">
        <div class="row g-2">
          <div class="col-sm-4 col-lg-3">
            <label class="form-label small text-muted mb-1">Category</label>
            <select class="form-select form-select-sm dep-category-filter" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— All categories —</option>
              <% categoryOptions.forEach(function(cat) { %><option value="<%= cat %>"><%= cat %></option><% }) %>
            </select>
          </div>
          <div class="col-sm-8 col-lg-6">
            <label class="form-label small text-muted mb-1">Pack</label>
            <select name="<%= field.name %>[<%= i %>][packCode]" class="form-select form-select-sm dep-pack-select" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— Pack —</option>
              <% packOptions.forEach(function(p) { %>
                <option value="<%= p.code %>" data-version="<%= p.version %>" data-category="<%= p.category %>" <%= pv === p.code ? 'selected' : '' %>><%= p.name %> — v<%= p.version %></option>
              <% }) %>
              <% if (pv && !knownPack) { %>
                <option value="<%= pv %>" selected data-version="<%= row.version || '' %>" data-category="">&#9888; <%= pv %> (not currently Active)</option>
              <% } %>
            </select>
          </div>
          <div class="col-sm-12 col-lg-3">
            <label class="form-label small text-muted mb-1">Type</label>
            <select name="<%= field.name %>[<%= i %>][type]" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
              <% (typeItemField.options || []).forEach(function(opt) { %>
                <option value="<%= opt %>" <%= (row.type || '') === opt ? 'selected' : '' %>><%= opt %></option>
              <% }) %>
            </select>
          </div>
        </div>
      <% } else { %>
        <div class="row g-2">
          <% field.itemFields.forEach(function(itemField) { %>
            <% var full = (itemField.name === 'statement' || itemField.name === 'prompt'); %>
            <% var inputName = field.name + '[' + i + '][' + itemField.name + ']'; %>
            <% var value = row[itemField.name] || ''; %>
            <div class="<%= full ? 'col-12' : 'col-sm-6 col-lg-4' %>">
              <label class="form-label small text-muted mb-1"><%= ilabel(itemField.name) %></label>

              <% if (itemField.kind === 'referential' && itemField.referentialSource.indexOf('pack-code') === 0) { %>
                <%# Owner: "Why is code not auto generated?... Pack code
                    dropdown has to be platform + tenant ones." — code is a
                    system UUID (CR-015); packOptions (already Platform +
                    this viewer's tenant, per loadActivePackDependencyOptions)
                    is what makes the option legible. Same list Dependencies
                    itself uses above — this is Template's mandatoryPackCodes
                    / Profile's optionalPackCodes, the other two "pack code
                    dropdown"s.
                    CR (Profile §7 fields, 2026-08-19): `x-referential` can
                    also carry a fixed category suffix — "pack-code:Technology"
                    — for a field whose whole purpose IS one category (Profile's
                    technology/domain/compliance/integrationPackCodes). The
                    category is baked into the field, not a picker the author
                    chooses (unlike Dependencies' own client-side category
                    filter above) — server-side filtered against the same
                    category:pack Ontology vocabulary Pack's own `category`
                    already uses. %>
                <% var _fixedCategory = itemField.referentialSource.indexOf(':') !== -1 ? itemField.referentialSource.split(':')[1] : ''; %>
                <% var _packChoices = _fixedCategory ? packOptions.filter(function(p) { return p.category === _fixedCategory; }) : packOptions; %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
                  <option value="">— Pack —</option>
                  <% _packChoices.forEach(function(p) { %>
                    <option value="<%= p.code %>" <%= value === p.code ? 'selected' : '' %>><%= p.name %> — v<%= p.version %></option>
                  <% }) %>
                  <% if (value && !_packChoices.some(function(p) { return p.code === value; })) { %>
                    <option value="<%= value %>" selected>&#9888; <%= value %> (not currently Active<%= _fixedCategory ? (' / not ' + _fixedCategory) : '' %>)</option>
                  <% } %>
                </select>
              <% } else if (itemField.kind === 'referential') { %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
                  <option value="">— <%= ilabel(itemField.name) %> —</option>
                  <% ((locals.referentialOptions || {})[itemField.referentialSource] || []).forEach(function(opt) { %>
                    <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              <% } else if (itemField.kind === 'enum') { %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
                  <option value="">— <%= ilabel(itemField.name) %> —</option>
                  <% (itemField.options || []).forEach(function(opt) { %>
                    <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              <% } else if (itemField.kind === 'boolean') { %>
                <div class="form-check mt-1">
                  <input type="checkbox" class="form-check-input" name="<%= inputName %>" value="true" <%= value === 'true' ? 'checked' : '' %> <%- canEdit ? '' : 'disabled' %>>
                </div>
              <% } else if (full) { %>
                <textarea name="<%= inputName %>" class="form-control form-control-sm" rows="2" <%- canEdit ? '' : 'disabled' %>><%= value %></textarea>
              <% } else { %>
                <input name="<%= inputName %>" class="form-control form-control-sm" value="<%= value %>" <%- canEdit ? '' : 'disabled' %>>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% }) %>
  <% if (canEdit) { %>
    <button type="button" class="btn btn-sm btn-outline-secondary add-row-btn" data-field-name="<%= field.name %>">
      <i class="bi bi-plus-lg me-1"></i>Add another
    </button>
  <% } %>
</div>
<% } %>
