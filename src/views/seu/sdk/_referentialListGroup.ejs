<%# One referential-list field. Editable (canEdit): a stack of labeled cards
    (not a horizontal strip of unlabeled inline boxes) — existing rows shown
    filled, exactly one blank "New item" row at the end doubling as the clone
    template for the "+ Add another" button (edit.ejs's script). Read-only
    (!canEdit, owner: "The view should show the details... just not
    editable, showing dropdowns etc"): plain text rows, existing content
    only — no disabled controls, no blank offered row, no Add/Remove.
    Locals: field (GeneratedField, kind referential-list), canEdit (bool),
    referentialOptions, packDependencyOptions (PackDependencyOption[] —
    name/code/version/category of every Active Pack visible to this viewer;
    used by Dependencies AND any other referential-list whose item field
    sources "pack-code" — Template's mandatoryPackCodes, Profile's
    optionalPackCodes), renderMarkdown (CR-077 — (raw: string) => string,
    only called in read mode for an itemField/nestedItemField flagged
    markdown:true), deliverableLabels (Record<code, label> — Template's
    deliverableCatalogue/dependencyGraph rows, both view and edit, resolveLabels
    against deliverable-name).
    %>
<%
  function ilabel(n) { return n.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, function(c){ return c.toUpperCase(); }); }
  var isDependencies = field.name === 'dependencies';
  var isChecklists = field.name === 'contributionChecklists';
  var isQualityGates = field.name === 'contributionQualityGates';
  var isReviewGates = field.name === 'contributionReviewGates';
  var isObligationDefinitions = field.name === 'contributionObligationDefinitions';
  var isServices = field.name === 'contributionServices';
  // Hoisted out of the view-only block below (var is function-scoped in a
  // compiled EJS template, but only ASSIGNED where the code actually runs —
  // the canEdit branch needs these too, for the isDependencyGraph edit card).
  var isDeliverableCatalogue = field.name === 'deliverableCatalogue';
  var isDependencyGraph = field.name === 'dependencyGraph';
  var deliverableLabels = locals.deliverableLabels || {};
  // Owner: "the list is not correct for all the tabs. it has to depend on
  // the information carried in the tab" — these 5 kinds share the same
  // problem the flat table has: every possible field renders as a column
  // regardless of whether a given row actually uses it (e.g. a Quality
  // Gate only ever populates ONE of deliverableName/requiredPolicyCodes,
  // depending on criteriaType — the other stays a blank column always).
  // Card per row instead, populated fields only — same pattern already
  // proven for Dependencies/Deliverable Catalogue/Dependency Graph/Checklists
  // above. Capabilities/Engineering Capital/Authority Rules (3 fields each)
  // stay on the generic table — reads fine already, no change needed.
  function resolveMultiRefs(refs, options) {
    return (Array.isArray(refs) ? refs : []).map(function(ref) {
      var matched = options.find(function(o) { return o.id === ref || o.name === ref; });
      return matched ? (matched.name + ' — ' + matched.packName) : ('⚠ ' + ref + ' (not found)');
    });
  }
  function formatGovernedTransition(raw) {
    var parts = (raw || '').split('|');
    return parts.length === 3 ? (parts[0] + ': ' + parts[1] + ' → ' + parts[2]) : raw;
  }
  // Shared by Quality Gates/Review Gates/Obligation Definitions — the same
  // §20 verifiable-item fields (statement/prompt markdown paragraphs, then
  // a small badge row for classification/participant/outputContract/
  // externalEvidence/assurance), each shown only when the row actually has it.
  function verifiableFieldsBlock(row, statementMd, promptMd) { %>
    <% if (row.statement) { %>
      <div class="small mb-1"><% if (statementMd) { %><%- renderMarkdown(row.statement) %><% } else { %><%= row.statement %><% } %></div>
    <% } %>
    <% if (row.prompt) { %>
      <div class="small text-muted fst-italic mb-1"><strong class="fst-normal">Prompt:</strong> <% if (promptMd) { %><%- renderMarkdown(row.prompt) %><% } else { %><%= row.prompt %><% } %></div>
    <% } %>
    <div class="mt-1">
      <% if (row.classification) { %><span class="badge bg-light text-dark border me-1"><%= row.classification %></span><% } %>
      <% if (row.participant) { %><span class="badge bg-light text-dark border me-1"><%= row.participant %></span><% } %>
      <% if (row.outputContract) { %><span class="badge bg-light text-dark border me-1"><%= row.outputContract %></span><% } %>
      <% if (row.externalEvidence === 'true') { %><span class="badge bg-light text-dark border me-1">External evidence</span><% } %>
      <% if (row.assurance) { %><span class="badge bg-light text-dark border me-1">Assurance: <%= row.assurance %></span><% } %>
    </div>
  <% }
  var packOptions = locals.packDependencyOptions || [];
  // Owner: "The services form should show all services tied to the
  // capabilities that are in contributions.capability[]" — contributionServices'
  // own picker source: every Active Service Definition (Ch.11) visible to
  // this viewer, each carrying its own capabilityCode/name/purpose/
  // serviceLevel for the isServices branches below (display-only fields,
  // client-side filtering) to read off directly, no extra lookups needed.
  var serviceDefOptions = locals.serviceDefinitionOptions || [];
  // Bug fix (owner: "In dependencies, there is a category tab. It is not
  // populated... It should be one of the ontology pack categories") — this
  // read from referentialOptions['pack-category'], a key loadReferentialOptions
  // (web/sdkAuthoring.ts) never actually populates; Pack's own category field
  // has been Ontology-driven (x-referential-source "category:pack",
  // ontologyOptions, not referentialOptions) since CR-079, and this filter
  // was never updated to match. Same source, same 6 values (Domain,
  // Engineering, ...) Pack's own Category field itself offers; code and
  // label are identical for this concept type, so plain codes are enough for
  // a value-and-display-text filter option.
  var categoryOptions = ((locals.ontologyOptions || {})['category:pack'] || []).map(function(opt) { return opt.code; });
  var typeItemField = isDependencies ? field.itemFields.find(function(f) { return f.name === 'type'; }) : null;
%>
<% if (!canEdit) { %>
  <%# View mode — plain read rows, not disabled form controls (owner: "The
      view should show the details... just not editable, showing dropdowns
      etc" — a disabled <select> still renders as an interactive-looking
      dropdown even though it does nothing). Only real, existing rows: the
      blank "New item" rows generateFields() always appends for the edit
      form's own convenience have nothing to show here. Referential values
      resolve to the same human-readable label their <option> would have
      shown (Pack name + version, Ontology label) rather than a bare code. %>
  <%
    // Owner: "Item 1 / Pack Code - this is all not adding any value in a
    // view form. It should just list the code, name, and a link to view the
    // pack." — a row that's just ONE Pack-code reference (Template's six
    // category fields, its legacy mandatoryPackCodes, Profile's
    // optionalPackCodes/four category fields) gets a compact list line
    // instead of an "Item N" card; Dependencies (Pack + Type) gets the same
    // compact treatment with Type alongside. Any OTHER shape (Deliverable
    // Catalogue, Dependency Graph — no Pack reference involved) keeps the
    // card layout below, unchanged.
    var soloPackCodeField = (!isDependencies && field.itemFields.length === 1 && field.itemFields[0].kind === 'referential' && field.itemFields[0].referentialSource.indexOf('pack-code') === 0) ? field.itemFields[0] : null;
    function packLink(matchedPack) {
      return matchedPack ? ('<a href="/aisworg/seu/sdk/pack-authoring/' + matchedPack.id + '" class="btn btn-sm btn-link p-0">View</a>') : '';
    }
    // Owner: "Now there is item1, item2 etc. labels which is not relevant" —
    // same compact-list treatment as the solo-Pack-code case above, for
    // Template's Deliverable Catalogue specifically. Revised (owner): no
    // category badge, no "Produced by" Pack link (a deliverable has no
    // established relationship to a Pack — only to the deliverable-name
    // concept itself) — show the concept's own human label as the primary
    // text, its code muted alongside it. deliverableLabels
    // (web/sdkAuthoring.ts, resolveLabels against deliverable-name) maps
    // each stored code to its tenant-aware label. (isDeliverableCatalogue
    // itself is declared above, shared with the canEdit branch.)
    // Owner: "Instead of showing the dependency graph as a list, is there a
    // better way of showing this?" — grouped-by-target (recommended over a
    // diagram: no new client-side library, consistent with the rest of this
    // view-mode redesign): each gated deliverable shown once, its
    // prerequisites listed underneath with relationship kind + required
    // state as badges, instead of one "Item N" card per edge.
    function relationshipLabel(kind) {
      var k = kind || 'dependency';
      return k.charAt(0).toUpperCase() + k.slice(1);
    }
    // Owner originally asked for this grouped by target under two sub
    // headings (Deliverable dependency / Capability dependency, CR-041) —
    // now just Deliverable-type edges (see isDependencyGraph below), so one
    // heading-less group is enough; groupedByTarget itself is unchanged.
    function groupedByTarget(rows) {
      var groups = [];
      var indexByTarget = {};
      rows.forEach(function(row) {
        var key = row.toCode || '';
        if (!(key in indexByTarget)) {
          indexByTarget[key] = groups.length;
          groups.push({ toCode: key, prerequisites: [] });
        }
        groups[indexByTarget[key]].prerequisites.push(row);
      });
      return groups;
    }
  %>
  <% var existingRows = field.rows.slice(0, field.existingCount); %>
  <% if (existingRows.length === 0) { %>
    <p class="text-muted small mb-0">None</p>
  <% } else if (isDependencyGraph) { %>
    <%
      // Owner, 2026-09-04: "Capability Dependency will be part of the pack
      // codes tab... it is not part of the deliverable catalog tab" — a
      // Deliverable has no established relationship to a Pack (see
      // isDeliverableCatalogue below); Capability-type edges stay real,
      // materialised dependency_definitions rows underneath (Ch.9 §8) — this
      // tab just isn't where they get shown. Filtered out here, not deleted:
      // where they DO surface is Pack Codes' own future concern, not this one.
      var deliverableGroups = groupedByTarget(existingRows.filter(function(row) { return row.fromType !== 'Capability'; }));
      function renderDependencyGroups(groups) { %>
        <ul class="list-group list-group-flush">
          <% groups.forEach(function(group) { %>
            <li class="list-group-item px-0 small">
              <div><strong><%= group.toCode || '—' %></strong></div>
              <ul class="list-unstyled mt-1 mb-0 ps-3">
                <% group.prerequisites.forEach(function(row) { %>
                  <li class="text-muted">
                    requires <%= row.fromCode || '—' %>
                    (<%= row.requiredState || '—' %>)
                    <span class="badge bg-light text-dark border ms-1"><%= relationshipLabel(row.relationshipKind) %></span>
                  </li>
                <% }) %>
              </ul>
            </li>
          <% }) %>
        </ul>
      <% } %>
    <% if (deliverableGroups.length === 0) { %>
      <p class="text-muted small mb-0">None</p>
    <% } else { %>
      <% renderDependencyGroups(deliverableGroups); %>
    <% } %>
  <% } else if (isDeliverableCatalogue) { %>
    <ul class="list-group list-group-flush">
      <% existingRows.forEach(function(row) { %>
        <% var label = row.code ? (deliverableLabels[row.code] || row.code) : '—'; %>
        <li class="list-group-item px-0 small">
          <span><%= label %></span>
          <% if (row.code) { %> <span class="text-muted"><%= row.code %></span> <% } %>
        </li>
      <% }) %>
    </ul>
  <% } else if (isDependencies || soloPackCodeField) { %>
    <ul class="list-group list-group-flush">
      <% existingRows.forEach(function(row) { %>
        <% var pv = isDependencies ? (row.packCode || '') : (row[soloPackCodeField.name] || ''); %>
        <% var matchedPack = packOptions.find(function(p) { return p.code === pv; }); %>
        <li class="list-group-item px-0 d-flex justify-content-between align-items-center small">
          <span>
            <% if (matchedPack) { %>
              <%= matchedPack.name %> <code class="text-muted"><%= matchedPack.code %></code> <span class="text-muted">v<%= matchedPack.version %></span>
            <% } else if (pv) { %>
              ⚠ <%= pv %> (not currently Active)
            <% } else { %>
              —
            <% } %>
            <% if (isDependencies) { %><span class="badge bg-light text-dark border ms-2"><%= row.type || '—' %></span><% } %>
          </span>
          <%- packLink(matchedPack) %>
        </li>
      <% }) %>
    </ul>
  <% } else if (isChecklists) { %>
    <%# Owner: "In checklist view, the metadata has to be shown separately.
        And the items. And each of the group should be a collapsible view." —
        Name/Description no longer cram into flat table columns alongside a
        huge Items cell; each Checklist is its own card (metadata as the
        header, Items below), and each `group` (same grouping this widget's
        nested-list table-cell branch already does) collapses independently
        via Bootstrap's collapse component, not always-expanded. %>
    <% var checklistItemsField = field.itemFields.find(function(f) { return f.name === 'items'; }); %>
    <% var checklistStatementMarkdown = (checklistItemsField && checklistItemsField.nestedItemFields || []).some(function(nf) { return nf.name === 'statement' && nf.markdown; }); %>
    <% existingRows.forEach(function(row, ci) { %>
      <div class="card mb-2">
        <div class="card-body">
          <h6 class="mb-1"><%= row.name || '—' %></h6>
          <% if (row.description) { %><p class="text-muted small mb-2"><%= row.description %></p><% } %>
          <%
            var checklistItems = Array.isArray(row.items) ? row.items.slice(0, Math.max(row.items.length - 1, 0)) : [];
            var checklistGroups = []; var checklistGroupIndex = {};
            checklistItems.forEach(function(it) {
              var groupName = (it.group || '').trim() || 'Ungrouped';
              if (!(groupName in checklistGroupIndex)) { checklistGroupIndex[groupName] = checklistGroups.length; checklistGroups.push({ name: groupName, rows: [] }); }
              checklistGroups[checklistGroupIndex[groupName]].rows.push(it);
            });
          %>
          <% if (!checklistItems.length) { %>
            <p class="text-muted small mb-0">No items</p>
          <% } else { %>
            <div class="accordion accordion-flush">
              <% checklistGroups.forEach(function(g, gi) { %>
                <% var collapseId = 'checklist-' + ci + '-group-' + gi + '-' + field.name; %>
                <div class="accordion-item">
                  <h2 class="accordion-header">
                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#<%= collapseId %>">
                      <%= g.name %> <span class="badge bg-secondary-subtle text-secondary ms-2"><%= g.rows.length %></span>
                    </button>
                  </h2>
                  <div id="<%= collapseId %>" class="accordion-collapse collapse">
                    <div class="accordion-body py-2">
                      <ul class="list-unstyled mb-0 ps-0">
                        <% g.rows.forEach(function(item) { %>
                          <li class="mb-1 small">
                            <% if (checklistStatementMarkdown && item.statement) { %><%- renderMarkdown(item.statement) %><% } else { %><%= item.statement || '—' %><% } %>
                          </li>
                        <% }) %>
                      </ul>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else if (isServices) { %>
    <%# Owner: "Capability Code will be a display only field. Name and
        Contract Description are display only. these fields do not have to
        be stored in contributionServices[]" — resolved here off the linked
        Service Definition (serviceDefOptions), not off the row itself
        (which only ever carries code + this Pack's own target overrides).
        Service Level shows the Definition's FULL declared set, this Pack's
        override applied wherever one exists, its own target otherwise. %>
    <% existingRows.forEach(function(row) { %>
      <% var svcDef = serviceDefOptions.find(function(d) { return d.code === row.code; }); %>
      <% var svcOverrides = Array.isArray(row.serviceLevel) ? row.serviceLevel : []; %>
      <div class="card mb-2">
        <div class="card-body">
          <h6 class="mb-1"><%= svcDef ? svcDef.name : '—' %> <code class="text-muted small"><%= row.code || '—' %></code></h6>
          <% if (svcDef) { %><span class="badge bg-light text-dark border mb-2">Capability: <%= svcDef.capabilityCode %></span><% } %>
          <% if (svcDef && svcDef.purpose) { %><p class="text-muted small mb-2"><%= svcDef.purpose %></p><% } %>
          <% if (svcDef && svcDef.serviceLevel && svcDef.serviceLevel.length) { %>
            <div class="small d-flex flex-wrap gap-1">
              <% svcDef.serviceLevel.forEach(function(base) {
                   var ov = svcOverrides.find(function(o) { return o.code === base.code; });
                   var effectiveTarget = ov ? ov.target : base.target;
                   var op = base.target_level === 'maximum' ? '≤' : (base.target_level === 'exact' ? '=' : '≥');
              %>
                <span class="badge bg-light text-dark border" title="<%= base.code %>"><%= base.label %>: <%= op %><%= effectiveTarget %> <%= base.units %><% if (ov) { %> <span class="text-primary">(overridden)</span><% } %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else if (isQualityGates || isReviewGates) { %>
    <% var statementField = field.itemFields.find(function(f) { return f.name === 'statement'; }); %>
    <% var promptField = field.itemFields.find(function(f) { return f.name === 'prompt'; }); %>
    <% var statementIsMarkdown = statementField && statementField.markdown; %>
    <% var promptIsMarkdown = promptField && promptField.markdown; %>
    <% existingRows.forEach(function(row) { %>
      <div class="card mb-2">
        <div class="card-body">
          <h6 class="mb-1">
            <%= row.name || '—' %>
            <% if (isQualityGates && row.category) { %><span class="badge bg-light text-dark border"><%= row.category %></span><% } %>
            <% if (isReviewGates && row.code) { %><code class="text-muted small"><%= row.code %></code><% } %>
          </h6>
          <% if (row.governedTransition) { %><div class="text-muted small mb-1"><%= formatGovernedTransition(row.governedTransition) %></div><% } %>
          <% if (isQualityGates && row.criteriaType) { %>
            <div class="small text-muted mb-1">
              Criteria: <%= row.criteriaType %>
              <% if (row.deliverableName) { %> — Review Gate: <span class="badge bg-light text-dark border"><%= row.deliverableName %></span><% } %>
              <% if (row.requiredPolicyCodes && row.requiredPolicyCodes.length) { %>
                <% resolveMultiRefs(row.requiredPolicyCodes, locals.policyOptions || []).forEach(function(label) { %> <span class="badge bg-light text-dark border me-1"><%= label %></span><% }) %>
              <% } %>
            </div>
          <% } %>
          <% if (row.checklistIds && row.checklistIds.length) { %>
            <div class="small text-muted mb-1">Required Checklists:
              <% resolveMultiRefs(row.checklistIds, locals.checklistOptions || []).forEach(function(label) { %> <span class="badge bg-light text-dark border me-1"><%= label %></span><% }) %>
            </div>
          <% } %>
          <% if (row.recommendedChecklistIds && row.recommendedChecklistIds.length) { %>
            <div class="small text-muted mb-1">Recommended Checklists:
              <% resolveMultiRefs(row.recommendedChecklistIds, locals.checklistOptions || []).forEach(function(label) { %> <span class="badge bg-light text-dark border me-1"><%= label %></span><% }) %>
            </div>
          <% } %>
          <% verifiableFieldsBlock(row, statementIsMarkdown, promptIsMarkdown); %>
        </div>
      </div>
    <% }) %>
  <% } else if (isObligationDefinitions) { %>
    <% var obStatementField = field.itemFields.find(function(f) { return f.name === 'statement'; }); %>
    <% var obPromptField = field.itemFields.find(function(f) { return f.name === 'prompt'; }); %>
    <% var obStatementIsMarkdown = obStatementField && obStatementField.markdown; %>
    <% var obPromptIsMarkdown = obPromptField && obPromptField.markdown; %>
    <% existingRows.forEach(function(row) { %>
      <div class="card mb-2">
        <div class="card-body">
          <h6 class="mb-1"><%= row.code || '—' %></h6>
          <div class="mb-1">
            <% if (row.category) { %><span class="badge bg-light text-dark border me-1"><%= row.category %></span><% } %>
            <% if (row.origin) { %><span class="badge bg-light text-dark border me-1"><%= row.origin %></span><% } %>
          </div>
          <% verifiableFieldsBlock(row, obStatementIsMarkdown, obPromptIsMarkdown); %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <%# Owner: "the lists should be shown as lists... What if there are 10
        records? How readable is this?" — a first attempt here used inline
        "Label: value" chips per row, which was still wrong: with several
        records it's a wall of run-together text with no way to scan a
        single column (e.g. every row's Category) and nothing separating
        one record's fields from the next but a thin border — not
        meaningfully more readable than the "Item N" cards it replaced. A
        real list of N records with M fields each is a table: column
        headers shown once, values aligned so the eye can scan down a
        column, not repeated per row as a label.
        Which columns need to wrap/widen (Quality Gate's statement/prompt,
        Capabilities' description, Services' contractDescription, ...) has
        no schema-level signal to key off — every item field is plain
        {"type":"string"} regardless of length, confirmed live (no
        x-widget/textarea marker item fields carry, unlike top-level
        fields, which do). Decided from the real data instead: any column
        where a value actually runs long gets room and wraps; short columns
        stay tight. Wrong per-field-name guessing (statement/prompt only)
        was tried and missed Capabilities' own description field — this
        works for any contribution type's long-text field, not a
        maintained allowlist. %>
    <% var LONG_TEXT_THRESHOLD = 40; %>
    <% var longColumns = {}; %>
    <% field.itemFields.forEach(function(itemField) {
         // CR-060 — nested-list/referential-multi hold arrays, not strings;
         // both render their own block content (a compact item list, a
         // badge cluster) that needs the same wrap/width treatment a long
         // text column gets, regardless of the length heuristic below
         // (which would otherwise count array-element count, not text length).
         longColumns[itemField.name] = (itemField.kind === 'nested-list' || itemField.kind === 'referential-multi')
           || existingRows.some(function(row) { return (row[itemField.name] || '').length > LONG_TEXT_THRESHOLD; });
       }); %>
    <%# Owner: "All pages should have a search, filter and sort columns" —
        same requirement as the site's registry list pages (coding_principles.md
        "List UI Requirements"), applied client-side here rather than through
        core/dbLayer: unlike a registry page, this table's rows are a Pack's
        (or Template's/Profile's) own contributions JSONB array — already
        fully loaded with the parent record, not a separately paginated
        resource — so filtering/sorting what's already on the page is the
        real equivalent of "server-side," not a wasted round trip.
        Wired up by public/js/referentialListGroup.js, already loaded on this
        widget's one host page (authoring/edit.ejs). Search box only above a
        certain row count — clutter with nothing to search is worse than no
        search box; sort headers cost nothing extra so they're always on. %>
    <div class="rlg-view-table">
      <% if (existingRows.length > 5) { %>
        <div class="input-group input-group-sm mb-2" style="max-width: 16rem;">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control rlg-view-search" placeholder="Search">
        </div>
      <% } %>
      <div style="overflow-x: auto;">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead>
            <tr>
              <% field.itemFields.forEach(function(itemField) { %>
                <th class="text-muted small text-uppercase fw-semibold rlg-sort-th <%= longColumns[itemField.name] ? '' : 'text-nowrap' %>" data-sort-key="<%= itemField.name %>">
                  <%= itemField.label || ilabel(itemField.name) %><i class="bi bi-arrow-down-up ms-1 rlg-sort-icon"></i>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% existingRows.forEach(function(row) { %>
              <tr>
                <% field.itemFields.forEach(function(itemField) { %>
                  <% var value = row[itemField.name] || ''; %>
                  <td class="small <%= longColumns[itemField.name] ? '' : 'text-nowrap' %>" <%= longColumns[itemField.name] ? 'style="min-width: 22rem; white-space: normal;"' : '' %>>
                    <% if (itemField.kind === 'nested-list') { %>
                      <%# CR-060 — Checklist's own `items`, view mode. A few
                          items nested inside one table cell reads better as a
                          compact list than forcing the full flat-table/search/
                          sort mechanism one level deeper — that machinery is
                          for many TOP-LEVEL rows, not a handful of sub-rows
                          already scoped inside one Checklist. %>
                      <% var nestedViewRows = Array.isArray(value) ? value.slice(0, Math.max(value.length - 1, 0)) : []; %>
                      <%# CR-077 — Checklist item's own statement carries
                          x-format:"markdown"; render it the same way the
                          main table cell branch below does. %>
                      <% var nestedStatementMarkdown = (itemField.nestedItemFields || []).some(function(nf) { return nf.name === 'statement' && nf.markdown; }); %>
                      <% if (!nestedViewRows.length) { %>
                        <span class="text-muted">None</span>
                      <% } else { %>
                        <%# Owner: "display the statements by group" — Checklist
                            items' own optional `group` (migration 120, purely
                            organisational, e.g. "Formatting"/"Naming conventions")
                            clusters the view instead of one flat list. Order
                            follows first appearance in the data, not alphabetised.
                            A Checklist that never uses `group` at all still
                            renders as one plain flat list — no lone "Ungrouped"
                            heading over everything. %>
                        <% var nestedGroups = []; var nestedGroupIndex = {}; %>
                        <% nestedViewRows.forEach(function(nestedRow) {
                             var groupName = (nestedRow.group || '').trim() || 'Ungrouped';
                             if (!(groupName in nestedGroupIndex)) { nestedGroupIndex[groupName] = nestedGroups.length; nestedGroups.push({ name: groupName, rows: [] }); }
                             nestedGroups[nestedGroupIndex[groupName]].rows.push(nestedRow);
                           }); %>
                        <% var nestedShowHeadings = !(nestedGroups.length === 1 && nestedGroups[0].name === 'Ungrouped'); %>
                        <% nestedGroups.forEach(function(g) { %>
                          <div class="mb-2">
                            <% if (nestedShowHeadings) { %><div class="text-uppercase text-muted small fw-semibold mb-1"><%= g.name %></div><% } %>
                            <ul class="list-unstyled mb-0 ps-0">
                              <% g.rows.forEach(function(nestedRow) { %>
                                <li class="mb-1">
                                  <span class="badge <%= nestedRow.mandatory === 'Mandatory' ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary' %> small fw-normal me-1"><%= nestedRow.mandatory || '—' %></span>
                                  <% if (nestedStatementMarkdown && nestedRow.statement) { %><%- renderMarkdown(nestedRow.statement) %><% } else { %><%= nestedRow.statement || '—' %><% } %>
                                  <% if (nestedRow.participant) { %><span class="text-muted">(<%= nestedRow.participant %>)</span><% } %>
                                </li>
                              <% }) %>
                            </ul>
                          </div>
                        <% }) %>
                      <% } %>
                    <% } else if (itemField.kind === 'referential-multi') { %>
                      <%# CR-060/CR-061 — checklistIds/requiredPolicyCodes,
                          view mode: resolve each stored reference back to its
                          real name + originating Pack, same display the
                          edit-mode <select> already uses. A stored entry is
                          either a real id (form-submitted) or this same
                          Pack's own declared name/code, never resolved back
                          into the Pack's own contributions JSON (a raw seed
                          file authors it that way — core/packs.ts's
                          validateChecklistIds/validatePolicyCodes accept the
                          identical two shapes) — match by id OR name/code,
                          not id alone. Options source dispatches on
                          referentialSource (checklist vs policy), the same
                          way pack-code fields dispatch on their own source. %>
                      <% var _multiOptions = itemField.referentialSource === 'policy' ? (locals.policyOptions || []) : (locals.checklistOptions || []); %>
                      <% var selectedRefs = Array.isArray(value) ? value : []; %>
                      <% if (!selectedRefs.length) { %>
                        <span class="text-muted">None</span>
                      <% } else { %>
                        <% selectedRefs.forEach(function(ref) { %>
                          <% var matchedOpt = _multiOptions.find(function(o) { return o.id === ref || o.name === ref; }); %>
                          <span class="badge bg-light text-dark border me-1 mb-1"><%= matchedOpt ? (matchedOpt.name + ' — ' + matchedOpt.packName) : ('⚠ ' + ref + ' (not found)') %></span>
                        <% }) %>
                      <% } %>
                    <% } else if (itemField.kind === 'boolean') { %>
                      <% if (value === 'true') { %><i class="bi bi-check-circle-fill text-success"></i><% } else { %><span class="text-muted">—</span><% } %>
                    <% } else if (itemField.kind === 'referential' && itemField.referentialSource.indexOf('pack-code') === 0) { %>
                      <% var _fixedCategory = itemField.referentialSource.indexOf(':') !== -1 ? itemField.referentialSource.split(':')[1] : ''; %>
                      <% var matchedItemPack = packOptions.find(function(p) { return p.code === value; }); %>
                      <% if (matchedItemPack) { %>
                        <%= matchedItemPack.name %> <code class="text-muted"><%= matchedItemPack.code %></code> v<%= matchedItemPack.version %> <%- packLink(matchedItemPack) %>
                      <% } else { %>
                        <%= value ? ('⚠ ' + value + ' (not currently Active' + (_fixedCategory ? ' / not ' + _fixedCategory : '') + ')') : '—' %>
                      <% } %>
                    <% } else if (itemField.kind === 'referential' && itemField.ontology) { %>
                      <% var _ontItemOptsView = ((locals.ontologyOptions || {})[itemField.referentialSource] || []); %>
                      <% var _matchedOntItem = _ontItemOptsView.find(function(o) { return o.code === value; }); %>
                      <%= _matchedOntItem ? _matchedOntItem.label : (value ? ('⚠ ' + value + ' (not currently active)') : '—') %>
                    <% } else if (itemField.markdown && value) { %>
                      <%- renderMarkdown(value) %>
                    <% } else { %>
                      <%= value || '—' %>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } else { %>
<%# CR-059 UI fix — .referential-list-group's own styling lives once, in
    authoring/edit.ejs (the page-level view), not here: this partial gets
    included once PER referential-list field (Dependencies, Checklists,
    Quality Gates, Review Gates, Obligation Definitions, ...), so a <style>
    block here would duplicate itself once per field on the page. %>
<div class="referential-list-group" data-field-name="<%= field.name %>" data-next-index="<%= field.rows.length %>">
  <% field.rows.forEach(function(row, i) { %>
    <% var isExisting = i < field.existingCount; %>
    <% if (isDependencyGraph && row.fromType === 'Capability') { %>
      <%# Owner, 2026-09-04: "Capability Dependency will be part of the pack
          codes tab... it is not part of the deliverable catalog tab" — an
          existing Capability-type edge is preserved on save (real,
          materialised dependency_definitions rows underneath, Ch.9 §8) but
          gets no card, no badge, no Remove button here: it's not shown or
          editable from this tab at all, not even as a disabled affordance. %>
      <input type="hidden" name="<%= field.name %>[<%= i %>][toCode]" value="<%= row.toCode || '' %>">
      <input type="hidden" name="<%= field.name %>[<%= i %>][fromType]" value="Capability">
      <input type="hidden" name="<%= field.name %>[<%= i %>][fromCapabilityCode]" value="<%= row.fromCapabilityCode || '' %>">
      <input type="hidden" name="<%= field.name %>[<%= i %>][requiredState]" value="<%= row.requiredState || '' %>">
      <input type="hidden" name="<%= field.name %>[<%= i %>][relationshipKind]" value="<%= row.relationshipKind || '' %>">
    <% } else { %>
    <div class="card card-body bg-light border-0 mb-2 referential-list-row">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge <%= isExisting ? 'bg-secondary-subtle text-secondary' : 'bg-light text-muted border' %> small fw-normal"><%= isExisting ? ('Item ' + (i + 1)) : 'New item — fill in to add' %></span>
        <% if (canEdit) { %><button type="button" class="btn btn-sm btn-link text-danger p-0 remove-row-btn">Remove</button><% } %>
      </div>

      <% if (isDependencies) { %>
        <%# Owner: "Pack code should include the pack and the version number
            in the dropdown. Version should not be a text field... There
            should also have a dropdown on the category." — Category is a
            client-side filter only (never submitted — dependencies don't
            carry a category of their own); Pack's <option>s carry the real
            data-version/data-category the two scripts below read; Version is
            no longer its own visible box at all (owner: "remove the text
            version field") — the Pack option already names its version, and
            the value the seed actually stores now travels as a hidden input,
            kept in sync with whichever Pack is selected by the same script. %>
        <% var pv = row.packCode || ''; %>
        <% var knownPack = packOptions.some(function(p) { return p.code === pv; }); %>
        <input type="hidden" name="<%= field.name %>[<%= i %>][version]" class="dep-version-field" value="<%= row.version || '' %>">
        <div class="row g-2">
          <div class="col-sm-4 col-lg-3">
            <label class="form-label small text-muted mb-1">Category</label>
            <select class="form-select form-select-sm dep-category-filter" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— All categories —</option>
              <% categoryOptions.forEach(function(cat) { %><option value="<%= cat %>"><%= cat %></option><% }) %>
            </select>
          </div>
          <div class="col-sm-8 col-lg-6">
            <label class="form-label small text-muted mb-1">Pack</label>
            <select name="<%= field.name %>[<%= i %>][packCode]" class="form-select form-select-sm dep-pack-select" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— Pack —</option>
              <% packOptions.forEach(function(p) { %>
                <option value="<%= p.code %>" data-version="<%= p.version %>" data-category="<%= p.category %>" <%= pv === p.code ? 'selected' : '' %>><%= p.name %> — v<%= p.version %></option>
              <% }) %>
              <% if (pv && !knownPack) { %>
                <option value="<%= pv %>" selected data-version="<%= row.version || '' %>" data-category="">&#9888; <%= pv %> (not currently Active)</option>
              <% } %>
            </select>
          </div>
          <div class="col-sm-12 col-lg-3">
            <label class="form-label small text-muted mb-1">Type</label>
            <select name="<%= field.name %>[<%= i %>][type]" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
              <% (typeItemField.options || []).forEach(function(opt) { %>
                <option value="<%= opt %>" <%= (row.type || '') === opt ? 'selected' : '' %>><%= opt %></option>
              <% }) %>
            </select>
          </div>
        </div>
      <% } else if (isServices) { %>
        <%# Owner: "The services form should show all services tied to the
            capabilities that are in contributions.capability[]. So
            Capability Code will be a display only field. Name and Contract
            Description are display only. these fields do not have to be
            stored in contributionServices[]. The service level should show
            the Service's service level and allow edits to the targets... The
            original service definition should not be overwritten." — code
            is the only referential field submitted; capabilityCode/name/
            purpose are plain read-only text, never inputs, kept in sync by
            referentialListGroup.js off the selected <option>'s own data
            attributes (rlg-service-def-select). Which options are even
            visible is ALSO client-side (same script), filtered to whichever
            Capabilities this Pack currently declares elsewhere on this same
            form. Service Level rows are rebuilt by that same script whenever
            the Service changes — label/target_level/units/code always mirror
            the Definition (a hidden input carries code through; label/
            target_level/units are shown, never posted), only Target is a
            real, editable, submitted field. %>
        <% var svcCode = row.code || ''; %>
        <% var svcDef = serviceDefOptions.find(function(d) { return d.code === svcCode; }); %>
        <% var svcOverrides = Array.isArray(row.serviceLevel) ? row.serviceLevel : []; %>
        <div class="row g-2">
          <div class="col-12">
            <label class="form-label small text-muted mb-1">Service</label>
            <select name="<%= field.name %>[<%= i %>][code]" class="form-select form-select-sm rlg-service-def-select" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— Service —</option>
              <% serviceDefOptions.forEach(function(d) { %>
                <option value="<%= d.code %>" data-capability-code="<%= d.capabilityCode %>" data-name="<%= d.name %>" data-purpose="<%= d.purpose %>" data-service-level='<%- JSON.stringify(d.serviceLevel) %>' <%= svcCode === d.code ? 'selected' : '' %>><%= d.name %></option>
              <% }) %>
              <% if (svcCode && !svcDef) { %>
                <option value="<%= svcCode %>" selected>&#9888; <%= svcCode %> (not currently an Active Service Definition)</option>
              <% } %>
            </select>
          </div>
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1">Capability</label>
            <div class="form-control-plaintext form-control-sm small rlg-svc-capability-code border-bottom"><%= svcDef ? svcDef.capabilityCode : '—' %></div>
          </div>
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1">Name</label>
            <div class="form-control-plaintext form-control-sm small rlg-svc-name border-bottom"><%= svcDef ? svcDef.name : '—' %></div>
          </div>
          <div class="col-12">
            <label class="form-label small text-muted mb-1">Contract Description</label>
            <div class="form-control-plaintext form-control-sm small rlg-svc-purpose border-bottom"><%= svcDef ? svcDef.purpose : '—' %></div>
          </div>
          <div class="col-12">
            <label class="form-label small text-muted mb-1">Service Level <span class="text-muted fw-normal">— edit Target to override; leave unchanged to inherit the Definition's own value</span></label>
            <div class="rlg-svc-service-level-rows">
              <% if (!svcDef || !svcDef.serviceLevel.length) { %>
                <p class="text-muted small mb-0"><%= svcDef ? 'This Service declares no Service Level.' : 'Pick a Service above to see its declared Service Level.' %></p>
              <% } else { %>
                <% svcDef.serviceLevel.forEach(function(base, si) {
                     var ov = svcOverrides.find(function(o) { return o.code === base.code; });
                     var op = base.target_level === 'maximum' ? '≤' : (base.target_level === 'exact' ? '=' : '≥');
                %>
                  <div class="row g-2 align-items-center mb-1 rlg-svc-service-level-row">
                    <input type="hidden" name="<%= field.name %>[<%= i %>][serviceLevel][<%= si %>][code]" value="<%= base.code %>">
                    <div class="col-sm-6 small"><%= base.label %> <span class="text-muted">(<%= op %> <%= base.units %>)</span></div>
                    <div class="col-sm-6">
                      <input type="number" step="any" name="<%= field.name %>[<%= i %>][serviceLevel][<%= si %>][target]" class="form-control form-control-sm" value="<%= ov ? ov.target : base.target %>" <%- canEdit ? '' : 'disabled' %>>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>
      <% } else if (isDependencyGraph) { %>
        <%# Owner, 2026-09-04: "Capability Dependency will be part of the pack
            codes tab... it is not part of the deliverable catalog tab" — same
            boundary as the view-mode rendering above (isDependencyGraph
            there). Only ever reached for a Deliverable-type edge — a
            Capability-type row (fromType: "Capability") never gets this far;
            it's preserved via hidden inputs before the card wrapper even
            opens (see field.rows.forEach above). So From Type itself isn't
            offered as a choice here at all — it posts as a fixed hidden
            value, not a dropdown, since a row added from this tab's own
            "+ Add another" can only ever be a Deliverable-type edge. %>
        <% var toCodeField = field.itemFields.find(function(f) { return f.name === 'toCode'; }); %>
        <% var fromCodeField = field.itemFields.find(function(f) { return f.name === 'fromCode'; }); %>
        <% var requiredStateField = field.itemFields.find(function(f) { return f.name === 'requiredState'; }); %>
        <% var relationshipKindField = field.itemFields.find(function(f) { return f.name === 'relationshipKind'; }); %>
        <% var selfDeliverableCodes = (locals.referentialOptions || {})['self:deliverableCatalogue'] || []; %>
        <input type="hidden" name="<%= field.name %>[<%= i %>][fromType]" value="Deliverable">
        <div class="row g-2">
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1"><%= (toCodeField && toCodeField.label) || ilabel('toCode') %></label>
            <select name="<%= field.name %>[<%= i %>][toCode]" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— Deliverable —</option>
              <% selfDeliverableCodes.forEach(function(code) { %>
                <option value="<%= code %>" <%= (row.toCode || '') === code ? 'selected' : '' %>><%= deliverableLabels[code] || code %></option>
              <% }) %>
            </select>
            <% if (toCodeField && toCodeField.help) { %><div class="form-text small"><%= toCodeField.help %></div><% } %>
          </div>
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1"><%= (fromCodeField && fromCodeField.label) || ilabel('fromCode') %></label>
            <select name="<%= field.name %>[<%= i %>][fromCode]" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
              <option value="">— Deliverable —</option>
              <% selfDeliverableCodes.forEach(function(code) { %>
                <option value="<%= code %>" <%= (row.fromCode || '') === code ? 'selected' : '' %>><%= deliverableLabels[code] || code %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1"><%= (requiredStateField && requiredStateField.label) || ilabel('requiredState') %></label>
            <input name="<%= field.name %>[<%= i %>][requiredState]" class="form-control form-control-sm" value="<%= row.requiredState || '' %>" <%- canEdit ? '' : 'disabled' %>>
            <% if (requiredStateField && requiredStateField.help) { %><div class="form-text small"><%= requiredStateField.help %></div><% } %>
          </div>
          <div class="col-sm-6">
            <label class="form-label small text-muted mb-1"><%= (relationshipKindField && relationshipKindField.label) || ilabel('relationshipKind') %></label>
            <select name="<%= field.name %>[<%= i %>][relationshipKind]" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
              <% (relationshipKindField ? (relationshipKindField.options || []) : []).forEach(function(opt) { %>
                <option value="<%= opt %>" <%= (row.relationshipKind || 'dependency') === opt ? 'selected' : '' %>><%= opt %></option>
              <% }) %>
            </select>
            <% if (relationshipKindField && relationshipKindField.help) { %><div class="form-text small"><%= relationshipKindField.help %></div><% } %>
          </div>
        </div>
      <% } else { %>
        <div class="row g-2">
          <% field.itemFields.forEach(function(itemField) { %>
            <% var full = (itemField.name === 'statement' || itemField.name === 'prompt'); %>
            <% var inputName = field.name + '[' + i + '][' + itemField.name + ']'; %>
            <% var value = row[itemField.name] || ''; %>
            <%# CR-058 form redesign (owner: "the form is very very poorly
                designed") — label/required/help now come from the schema's
                own items.properties.someField (x-label/items.required/x-help),
                not just the auto-derived camelCase split. Required marking is
                an editing affordance only (owner, elsewhere on this page:
                "In a view page why will a mandatory * indicator show up?"). %>
            <% var itemLabel = itemField.label || ilabel(itemField.name); %>
            <% var isRequiredField = canEdit && itemField.required; %>
            <%# Owner: "who puts form fields in columns blindly" — every
                field used to get the identical col-sm-6 col-lg-4 regardless
                of what it actually holds, so a boolean checkbox took the
                same width as a referential dropdown whose option text can
                run to 40+ characters. Sized by field KIND instead (never by
                field name — the same discipline every other generic
                mechanism on this page already follows): a boolean needs
                barely any width; a short fixed-vocabulary enum needs a bit
                more; a referential/free-text field gets real room since its
                content length isn't bounded the way an enum's is. %>
            <%# CR-060 — nested-list (Checklist's own `items`) and
                referential-multi (checklistIds) both need real room, same
                reasoning as `full` above. %>
            <% var colClass = (full || itemField.kind === 'nested-list' || itemField.kind === 'referential-multi') ? 'col-12'
                 : itemField.kind === 'boolean' ? 'col-sm-6 col-lg-3'
                 : itemField.kind === 'enum' ? 'col-sm-6 col-lg-4'
                 : 'col-sm-6 col-lg-6'; %>
            <div class="<%= colClass %>">
              <label class="form-label small text-muted mb-1"><%= itemLabel %><% if (isRequiredField) { %> <span class="text-danger">*</span><% } %></label>

              <% if (itemField.kind === 'nested-list') { %>
                <%# CR-060 — the first two-level referential-list in this
                    codebase: Checklist's own `items` is itself a repeatable
                    sub-list within one Checklist card. buildRow() (formGenerator.ts)
                    always appends exactly one blank template row at the end of
                    a nested-list value — the same BLANK_ROWS_TO_OFFER=1
                    convention the top level uses — so the last element here is
                    always the clone target for "+ Add item", never real content. %>
                <% var nestedRows = row[itemField.name] || []; %>
                <% var nestedExistingCount = Math.max(nestedRows.length - 1, 0); %>
                <div class="nested-list-group" data-field-name="<%= itemField.name %>" data-next-index="<%= nestedRows.length %>">
                  <% nestedRows.forEach(function(nestedRow, j) { %>
                    <% var nestedIsExisting = j < nestedExistingCount; %>
                    <div class="card card-body bg-white border mb-2 nested-list-row">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge <%= nestedIsExisting ? 'bg-secondary-subtle text-secondary' : 'bg-light text-muted border' %> small fw-normal"><%= nestedIsExisting ? ('Item ' + (j + 1)) : 'New item — fill in to add' %></span>
                        <% if (canEdit) { %><button type="button" class="btn btn-sm btn-link text-danger p-0 remove-nested-row-btn">Remove</button><% } %>
                      </div>
                      <div class="row g-2">
                        <% (itemField.nestedItemFields || []).forEach(function(nestedField) { %>
                          <% var nestedFull = nestedField.name === 'statement' || nestedField.name === 'prompt'; %>
                          <% var nestedColClass = nestedFull ? 'col-12' : nestedField.kind === 'boolean' ? 'col-sm-6 col-lg-3' : nestedField.kind === 'enum' ? 'col-sm-6 col-lg-4' : 'col-sm-6 col-lg-6'; %>
                          <% var nestedInputName = field.name + '[' + i + '][' + itemField.name + '][' + j + '][' + nestedField.name + ']'; %>
                          <% var nestedValue = nestedRow[nestedField.name] || ''; %>
                          <% var nestedLabel = nestedField.label || ilabel(nestedField.name); %>
                          <% var nestedRequired = canEdit && nestedField.required; %>
                          <div class="<%= nestedColClass %>">
                            <label class="form-label small text-muted mb-1"><%= nestedLabel %><% if (nestedRequired) { %> <span class="text-danger">*</span><% } %></label>
                            <% if (nestedField.kind === 'enum') { %>
                              <select name="<%= nestedInputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %> <%- nestedRequired ? 'required' : '' %>>
                                <option value="">— <%= nestedLabel %> —</option>
                                <% (nestedField.options || []).forEach(function(opt) { %>
                                  <option value="<%= opt %>" <%= nestedValue === opt ? 'selected' : '' %>><%= opt %></option>
                                <% }) %>
                              </select>
                            <% } else if (nestedField.kind === 'boolean') { %>
                              <div class="form-check mt-1">
                                <input type="checkbox" class="form-check-input" name="<%= nestedInputName %>" value="true" <%= nestedValue === 'true' ? 'checked' : '' %> <%- canEdit ? '' : 'disabled' %>>
                              </div>
                            <% } else if (nestedField.markdown) { %>
                              <%- include('_markdownEditorField', { name: nestedInputName, value: nestedValue, required: nestedRequired }) %>
                            <% } else if (nestedFull) { %>
                              <textarea name="<%= nestedInputName %>" class="form-control form-control-sm" rows="2" <%- canEdit ? '' : 'disabled' %> <%- nestedRequired ? 'required' : '' %>><%= nestedValue %></textarea>
                            <% } else { %>
                              <input name="<%= nestedInputName %>" class="form-control form-control-sm" value="<%= nestedValue %>" <%- canEdit ? '' : 'disabled' %> <%- nestedRequired ? 'required' : '' %>>
                            <% } %>
                            <% if (nestedField.help) { %><div class="form-text small"><%= nestedField.help %></div><% } %>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                  <% if (canEdit) { %>
                    <button type="button" class="btn btn-sm btn-outline-secondary add-nested-row-btn" data-field-name="<%= itemField.name %>">
                      <i class="bi bi-plus-lg me-1"></i>Add item
                    </button>
                  <% } %>
                </div>
              <% } else if (itemField.kind === 'referential-multi') { %>
                <%# CR-060/CR-061 — checklistIds/requiredPolicyCodes: both
                    scoped to this Pack's own code, so both need their own
                    richer option source ({id, name, packName}), the same
                    reason pack-code fields above use packOptions instead of
                    the generic flat referentialOptions map. Dispatches on
                    referentialSource — "checklist" or "policy" — same
                    pattern the pack-code branch below dispatches on its own
                    source. A stored selection is either a real id
                    (form-submitted, an earlier save) or this same Pack's own
                    declared name/code (a raw seed file's same-Pack self-
                    reference, never resolved back into the Pack's own
                    contributions JSON) — match either way, same dual-shape
                    handling core/packs.ts's validateChecklistIds/
                    validatePolicyCodes already do server-side. %>
                <% var _multiOptions = itemField.referentialSource === 'policy' ? (locals.policyOptions || []) : (locals.checklistOptions || []); %>
                <% var _selectedMultiRefs = Array.isArray(row[itemField.name]) ? row[itemField.name] : []; %>
                <select name="<%= field.name %>[<%= i %>][<%= itemField.name %>][]" class="form-select form-select-sm" multiple size="5" <%- canEdit ? '' : 'disabled' %>>
                  <% _multiOptions.forEach(function(opt) { %>
                    <option value="<%= opt.id %>" <%= (_selectedMultiRefs.indexOf(opt.id) !== -1 || _selectedMultiRefs.indexOf(opt.name) !== -1) ? 'selected' : '' %>><%= opt.name %> — <%= opt.packName %></option>
                  <% }) %>
                </select>
                <div class="form-text small">Ctrl/Cmd-click to select more than one.</div>
              <% } else if (itemField.kind === 'referential' && itemField.referentialSource.indexOf('pack-code') === 0) { %>
                <%# Owner: "Why is code not auto generated?... Pack code
                    dropdown has to be platform + tenant ones." — code is a
                    system UUID (CR-015); packOptions (already Platform +
                    this viewer's tenant, per loadActivePackDependencyOptions)
                    is what makes the option legible. Same list Dependencies
                    itself uses above — this is Template's mandatoryPackCodes
                    / Profile's optionalPackCodes, the other two "pack code
                    dropdown"s.
                    CR (Profile §7 fields, 2026-08-19): `x-referential` can
                    also carry a fixed category suffix — "pack-code:Technology"
                    — for a field whose whole purpose IS one category (Profile's
                    technology/domain/compliance/integrationPackCodes). The
                    category is baked into the field, not a picker the author
                    chooses (unlike Dependencies' own client-side category
                    filter above) — server-side filtered against the same
                    category:pack Ontology vocabulary Pack's own `category`
                    already uses. %>
                <% var _fixedCategory = itemField.referentialSource.indexOf(':') !== -1 ? itemField.referentialSource.split(':')[1] : ''; %>
                <% var _packChoices = _fixedCategory ? packOptions.filter(function(p) { return p.category === _fixedCategory; }) : packOptions; %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %>>
                  <option value="">— Pack —</option>
                  <% _packChoices.forEach(function(p) { %>
                    <option value="<%= p.code %>" <%= value === p.code ? 'selected' : '' %>><%= p.name %> — v<%= p.version %></option>
                  <% }) %>
                  <% if (value && !_packChoices.some(function(p) { return p.code === value; })) { %>
                    <option value="<%= value %>" selected>&#9888; <%= value %> (not currently Active<%= _fixedCategory ? (' / not ' + _fixedCategory) : '' %>)</option>
                  <% } %>
                </select>
              <% } else if (itemField.kind === 'referential' && itemField.ontology) { %>
                <%# Owner: "capability code is from a dropdown of
                    capability-name" (Pack's own contributionCapabilities) —
                    same x-ontology marker a top-level referential-select
                    already carries, one level down: options resolve to a
                    real label (not the bare code) and carry their own
                    description. Name/description no longer travel as their
                    own stored fields at all (owner: "what is stored in
                    contributionCapabilities[]? Just store only the code") —
                    the option's own text already shows the name; the
                    guidance line below (referentialListGroup.js, the same
                    rlg-autofill-source + data-row-field convention CR-023's
                    top-level guidance panel uses) is a read-only echo of the
                    description, never a submitted field. %>
                <% var _ontItemOpts = ((locals.ontologyOptions || {})[itemField.referentialSource] || []); %>
                <select name="<%= inputName %>" class="form-select form-select-sm rlg-autofill-source" data-row-field="<%= itemField.name %>" <%- canEdit ? '' : 'disabled' %> <%- isRequiredField ? 'required' : '' %>>
                  <option value="">— <%= itemLabel %> —</option>
                  <% _ontItemOpts.forEach(function(opt) { %>
                    <option value="<%= opt.code %>" data-label="<%= opt.label %>" data-description="<%= opt.description || '' %>" <%= value === opt.code ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                  <% if (value && !_ontItemOpts.some(function(opt) { return opt.code === value; })) { %>
                    <option value="<%= value %>" selected>&#9888; <%= value %> (not currently active)</option>
                  <% } %>
                </select>
                <% var _selectedOntItem = _ontItemOpts.find(function(opt) { return opt.code === value; }); %>
                <div class="form-text small fst-italic" data-autofill-from="<%= itemField.name %>" data-autofill-attr="description"><%= (_selectedOntItem && _selectedOntItem.description) || '' %></div>
              <% } else if (itemField.kind === 'referential') { %>
                <%# Owner: "Review Gates form is pathetic... same feedback
                    for quality gates" — governedTransition's own option list
                    (transition-definition) is 100+ flat "EntityType|from|to"
                    strings across every entity type with zero grouping, the
                    single worst offender once actually viewed in a browser.
                    Generic fix, not field-specific: any referential option
                    list using the "EntityType|..." delimiter convention
                    groups into <optgroup>s by that leading entity type;
                    anything without "|" renders exactly as before. %>
                <% var _refOpts = (locals.referentialOptions || {})[itemField.referentialSource] || []; %>
                <% var _refGrouped = _refOpts.length && _refOpts[0].indexOf('|') !== -1; %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %> <%- isRequiredField ? 'required' : '' %>>
                  <option value="">— <%= itemLabel %> —</option>
                  <% if (_refGrouped) { %>
                    <% var _refGroups = {}; var _refGroupOrder = []; %>
                    <% _refOpts.forEach(function(opt) { var g = opt.split('|')[0]; if (!_refGroups[g]) { _refGroups[g] = []; _refGroupOrder.push(g); } _refGroups[g].push(opt); }) %>
                    <% _refGroupOrder.forEach(function(g) { %>
                      <optgroup label="<%= g %>">
                        <% _refGroups[g].forEach(function(opt) { %>
                          <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt.split('|').slice(1).join(' → ') %></option>
                        <% }) %>
                      </optgroup>
                    <% }) %>
                  <% } else { %>
                    <% _refOpts.forEach(function(opt) { %>
                      <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
                    <% }) %>
                  <% } %>
                </select>
              <% } else if (itemField.kind === 'enum') { %>
                <select name="<%= inputName %>" class="form-select form-select-sm" <%- canEdit ? '' : 'disabled' %> <%- isRequiredField ? 'required' : '' %>>
                  <option value="">— <%= itemLabel %> —</option>
                  <% (itemField.options || []).forEach(function(opt) { %>
                    <option value="<%= opt %>" <%= value === opt ? 'selected' : '' %>><%= opt %></option>
                  <% }) %>
                </select>
              <% } else if (itemField.kind === 'boolean') { %>
                <div class="form-check mt-1">
                  <input type="checkbox" class="form-check-input" name="<%= inputName %>" value="true" <%= value === 'true' ? 'checked' : '' %> <%- canEdit ? '' : 'disabled' %>>
                </div>
              <% } else if (itemField.markdown) { %>
                <%- include('_markdownEditorField', { name: inputName, value: value, required: isRequiredField }) %>
              <% } else if (full) { %>
                <textarea name="<%= inputName %>" class="form-control form-control-sm" rows="2" <%- canEdit ? '' : 'disabled' %> <%- isRequiredField ? 'required' : '' %>><%= value %></textarea>
              <% } else { %>
                <input name="<%= inputName %>" class="form-control form-control-sm" value="<%= value %>" <%- canEdit ? '' : 'disabled' %> <%- isRequiredField ? 'required' : '' %>>
              <% } %>
              <% if (itemField.help) { %><div class="form-text small"><%= itemField.help %></div><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% } %>
  <% }) %>
  <% if (canEdit) { %>
    <button type="button" class="btn btn-sm btn-outline-secondary add-row-btn" data-field-name="<%= field.name %>">
      <i class="bi bi-plus-lg me-1"></i>Add another
    </button>
  <% } %>
</div>
<% } %>
