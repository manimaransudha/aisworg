<%# The dependency graph drawn as boxes and arrows. `graph` is a DependencyGraphLayout, or null when there is nothing to draw. %>
<% if (!graph) { %>
  <div class="small text-muted">None.</div>
<% } else { %>
  <div class="overflow-auto border rounded p-3">
    <svg width="<%= graph.width %>" height="<%= graph.height %>" viewBox="0 0 <%= graph.width %> <%= graph.height %>" role="img" aria-label="Dependency graph">
      <defs>
        <marker id="dg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#6c757d"/></marker>
      </defs>
      <% graph.edges.forEach(function (e) { %>
        <path d="<%= e.path %>" fill="none" stroke="#6c757d" stroke-width="1.5" marker-end="url(#dg-arrow)"/>
      <% }) %>
      <% graph.nodes.forEach(function (n) { %>
        <% if (n.href) { %><a href="<%= n.href %>"><% } %>
        <g>
          <title><%= n.label %> (<%= n.code %>)</title>
          <rect x="<%= n.x %>" y="<%= n.y %>" width="<%= n.w %>" height="<%= n.h %>" rx="<%= n.kind === 'Capability' ? 22 : 6 %>" fill="<%= n.kind === 'Capability' ? '#f8f9fa' : '#ffffff' %>" stroke="#6c757d" stroke-width="1.5" <%- n.kind === 'Capability' ? 'stroke-dasharray="5 3"' : '' %>/>
          <text x="<%= n.x + n.w / 2 %>" y="<%= n.y + 19 %>" text-anchor="middle" font-size="12" fill="#212529"><%= n.label %></text>
          <text x="<%= n.x + n.w / 2 %>" y="<%= n.y + 34 %>" text-anchor="middle" font-size="10" fill="#6c757d"><%= n.code %></text>
        </g>
        <% if (n.href) { %></a><% } %>
      <% }) %>
    </svg>
  </div>
  <div class="small text-muted mt-2">An arrow runs from a prerequisite to the deliverable it gates. Dashed rounded boxes are Capabilities.</div>
<% } %>
