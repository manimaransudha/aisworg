<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Authority — <%= tabLabel %></h2>
      <p class="text-muted small mb-0">
        Authorisation is <strong>noun × verb</strong>: a transition is a verb applied to a noun, and the required badge is
        <code>noun_verb</code>. Add or <strong>retire</strong> (soft — never delete/rename): a retired row stays and existing data keeps working, it just drops out of the pickers (CR-006 / CR-007).
      </p>
    </div>

    <%- include('../../../partials/authorityTabs', { active: activeTab }) %>

    <% const canWrite = locals.canWrite; %>

    <% if (canWrite) { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <% if (activeTab === 'nouns') { %>
            <form method="POST" action="/aisworg/seu/authority/nouns/add" class="row g-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-3"><label class="form-label small mb-1">Code</label><input name="code" class="form-control form-control-sm" placeholder="Document" required></div>
              <div class="col-sm-4"><label class="form-label small mb-1">Label</label><input name="label" class="form-control form-control-sm" placeholder="Document" required></div>
              <div class="col-sm-3"><label class="form-label small mb-1">Description</label><input name="description" class="form-control form-control-sm"></div>
              <div class="col-sm-2 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add noun</button></div>
            </form>
          <% } else if (activeTab === 'verbs') { %>
            <form method="POST" action="/aisworg/seu/authority/verbs/add" class="row g-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-3"><label class="form-label small mb-1">Code</label><input name="code" class="form-control form-control-sm" placeholder="audit" required></div>
              <div class="col-sm-4"><label class="form-label small mb-1">Label</label><input name="label" class="form-control form-control-sm" placeholder="Audit" required></div>
              <div class="col-sm-3"><label class="form-label small mb-1">Description</label><input name="description" class="form-control form-control-sm"></div>
              <div class="col-sm-2 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add verb</button></div>
            </form>
          <% } else { %>
            <form method="POST" action="/aisworg/seu/authority/mapping/add" class="row g-2 align-items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-sm-5">
                <label class="form-label small mb-1">Noun</label>
                <select name="nounCode" class="form-select form-select-sm" required>
                  <option value="">Choose noun…</option>
                  <% (locals.activeNouns || []).forEach(function(n) { %><option value="<%= n.code %>"><%= n.code %></option><% }) %>
                </select>
              </div>
              <div class="col-sm-5">
                <label class="form-label small mb-1">Allow verb</label>
                <select name="verbCode" class="form-select form-select-sm" required>
                  <option value="">Choose verb…</option>
                  <% (locals.activeVerbs || []).forEach(function(v) { %><option value="<%= v.code %>"><%= v.code %></option><% }) %>
                </select>
              </div>
              <div class="col-sm-2 d-grid"><button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Allow</button></div>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>

    <%- include('../../../partials/listControls', { list: list, listBasePath: listBasePath, searchPlaceholder: 'Search' }) %>

    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <% if (activeTab === 'nouns') { %>
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Noun', 'code', list, listBasePath) %></th>
                <th><%- sortLink('Label', 'label', list, listBasePath) %></th>
                <th><%- sortLink('Allowed verbs', 'verbCount', list, listBasePath) %></th>
                <th><%- sortLink('Transitions', 'transitionCount', list, listBasePath) %></th>
                <th><%- sortLink('Status', 'active', list, listBasePath) %></th>
                <% if (canWrite) { %><th></th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (list.total === 0) { %><tr><td colspan="6" class="text-muted small text-center py-3"><%= list.q ? 'No nouns match your search.' : 'No nouns.' %></td></tr><% } %>
              <% list.items.forEach(function(n) { %>
                <tr class="<%= n.isActive ? '' : 'text-muted' %>">
                  <td><span class="badge bg-light text-dark border"><%= n.code %></span></td>
                  <td class="small"><%= n.label %></td>
                  <td class="small text-muted"><%= n.verbCount %></td>
                  <td class="small text-muted"><%= n.transitionCount %></td>
                  <td><% if (n.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span><% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired</span><% } %></td>
                  <% if (canWrite) { %><td class="text-end">
                    <% if (n.isActive) { %><form method="POST" action="/aisworg/seu/authority/nouns/retire" onsubmit="return confirm('Retire noun <%= n.code %>? Existing data is unaffected; it just won\'t be offered for new items.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="code" value="<%= n.code %>"><button class="btn btn-sm btn-outline-secondary">Retire</button></form><% } %>
                  </td><% } %>
                </tr>
              <% }) %>
            </tbody>
          <% } else if (activeTab === 'verbs') { %>
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Verb', 'code', list, listBasePath) %></th>
                <th><%- sortLink('Label', 'label', list, listBasePath) %></th>
                <th><%- sortLink('Used by nouns', 'nounCount', list, listBasePath) %></th>
                <th><%- sortLink('Status', 'active', list, listBasePath) %></th>
                <% if (canWrite) { %><th></th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (list.total === 0) { %><tr><td colspan="5" class="text-muted small text-center py-3"><%= list.q ? 'No verbs match your search.' : 'No verbs.' %></td></tr><% } %>
              <% list.items.forEach(function(v) { %>
                <tr class="<%= v.isActive ? '' : 'text-muted' %>">
                  <td><code><%= v.code %></code></td>
                  <td class="small"><%= v.label %></td>
                  <td class="small text-muted"><%= v.nounCount %></td>
                  <td><% if (v.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span><% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired</span><% } %></td>
                  <% if (canWrite) { %><td class="text-end">
                    <% if (v.isActive) { %><form method="POST" action="/aisworg/seu/authority/verbs/retire" onsubmit="return confirm('Retire verb <%= v.code %>?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="code" value="<%= v.code %>"><button class="btn btn-sm btn-outline-secondary">Retire</button></form><% } %>
                  </td><% } %>
                </tr>
              <% }) %>
            </tbody>
          <% } else { %>
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Noun', 'nounCode', list, listBasePath) %></th>
                <th><%- sortLink('Verb', 'verbCode', list, listBasePath) %></th>
                <th><%- sortLink('Status', 'active', list, listBasePath) %></th>
                <% if (canWrite) { %><th></th><% } %>
              </tr>
            </thead>
            <tbody>
              <% if (list.total === 0) { %><tr><td colspan="4" class="text-muted small text-center py-3"><%= list.q ? 'No mappings match your search.' : 'No mappings.' %></td></tr><% } %>
              <% list.items.forEach(function(m) { %>
                <tr class="<%= m.isActive ? '' : 'text-muted' %>">
                  <td><span class="badge bg-light text-dark border"><%= m.nounCode %></span></td>
                  <td><code><%= m.verbCode %></code></td>
                  <td><% if (m.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span><% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired</span><% } %></td>
                  <% if (canWrite) { %><td class="text-end">
                    <% if (m.isActive) { %><form method="POST" action="/aisworg/seu/authority/mapping/retire" onsubmit="return confirm('Retire mapping <%= m.nounCode %> → <%= m.verbCode %>?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="nounCode" value="<%= m.nounCode %>"><input type="hidden" name="verbCode" value="<%= m.verbCode %>"><button class="btn btn-sm btn-outline-secondary">Retire</button></form><% } %>
                  </td><% } %>
                </tr>
              <% }) %>
            </tbody>
          <% } %>
        </table>
      </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
