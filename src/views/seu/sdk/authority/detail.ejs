<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../../partials/head') %>
</head>
<body>
  <%- include('../../../partials/helpers') %>
  <header><%- include('../../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 820px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <a href="/aisworg/seu/sdk/transition-definition-authoring" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Transition Definitions</a>

    <div class="d-flex align-items-center gap-2 mt-2 mb-4">
      <h2 class="h4 mb-0 text-dark fw-bold"><%= detail.entityType %>: <%= detail.fromState %> → <%= detail.toState %></h2>
      <% if (detail.isActive) { %><span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
      <% } else { %><span class="badge bg-secondary-subtle text-secondary border">Retired<% if (detail.retiredAt) { %> · <%= new Date(detail.retiredAt).toLocaleString() %><% } %></span><% } %>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-sm-4 text-muted">Noun (Work outcome)</dt><dd class="col-sm-8"><span class="badge bg-light text-dark border"><%= detail.entityType %></span></dd>
          <dt class="col-sm-4 text-muted">Verb (Work process)</dt><dd class="col-sm-8"><% if (detail.verb) { %><code><%= detail.verb %></code><% } else { %>—<% } %></dd>
          <dt class="col-sm-4 text-muted">Required badge (noun_verb)</dt><dd class="col-sm-8"><% if (detail.nounVerbBadge) { %><code class="text-primary"><%= detail.nounVerbBadge %></code><% } else { %>—<% } %></dd>
          <dt class="col-sm-4 text-muted">From → To</dt><dd class="col-sm-8"><%= detail.fromState %> → <%= detail.toState %></dd>
          <dt class="col-sm-4 text-muted">Authority rule <span class="text-muted">(legacy)</span></dt><dd class="col-sm-8"><%= detail.authorityRuleCode || '—' %></dd>
          <dt class="col-sm-4 text-muted">Policies</dt><dd class="col-sm-8"><% if (detail.policyCodes.length) { detail.policyCodes.forEach(function(p){ %><code class="me-1"><%= p %></code><% }) } else { %>—<% } %></dd>
          <dt class="col-sm-4 text-muted">Quality gates</dt><dd class="col-sm-8"><% if (detail.qualityGateCodes.length) { detail.qualityGateCodes.forEach(function(q){ %><code class="me-1"><%= q %></code><% }) } else { %>—<% } %></dd>
          <dt class="col-sm-4 text-muted">Creates obligation</dt><dd class="col-sm-8"><%= detail.createsObligation || '—' %></dd>
          <dt class="col-sm-4 text-muted">Category</dt><dd class="col-sm-8"><%= detail.category || '—' %></dd>
        </dl>
      </div>
    </div>
  </main>

  <%- include('../../../partials/footer') %>
</body>
</html>
