<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .version-badge { font-size: 0.68rem; font-weight: 600; padding: 0.15rem 0.45rem; border-radius: 4px; background: #f1f5f9; color: #334155; }
    .capability-badge { font-size: 0.68rem; font-weight: 600; padding: 0.15rem 0.45rem; border-radius: 4px; background: #ede9fe; color: #5b21b6; }
  </style>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Service Definitions</h2>
      <p class="text-muted small mb-0">
        Service Definition Registry (Ch.11 §13) — the canonical, versioned contract each capability-name code
        exposes, one per Capability. Distinct from the Pack-level <code>services</code> table (Ch.11 §12
        Composition) — many Packs may each compose their own Service against the same Capability; this is the
        single canonical Definition it's judged against.
      </p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/service-definitions'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search code or name' }) %>
    <div class="small text-muted mb-3">Sort:
      <%- sortLink('Code', 'code', list, _base) %> &middot;
      <%- sortLink('Version', 'version', list, _base) %> &middot;
      <%- sortLink('Status', 'status', list, _base) %>
    </div>

    <%
      var _states = locals.states || [];
      var _activeStatus = locals.activeStatus || '';
    %>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="<%= _base + listQueryString(list, { status: '' }) %>" class="btn btn-sm <%= _activeStatus ? 'btn-outline-secondary' : 'btn-secondary' %>">All states</a>
      <% _states.forEach(function(s) { %>
        <a href="<%= _base + listQueryString(list, { status: s }) %>" class="btn btn-sm <%= _activeStatus === s ? 'btn-secondary' : 'btn-outline-secondary' %>"><%= s %></a>
      <% }) %>
    </div>

    <% if (list.total === 0) { %>
      <% if (list.q) { %>
        <div class="alert alert-warning">No Service Definitions match your search.</div>
      <% } else if (_activeStatus) { %>
        <div class="alert alert-warning">No Service Definitions in state "<%= _activeStatus %>".</div>
      <% } else { %>
        <div class="alert alert-warning">No Service Definitions published yet — author one via SDK / Authoring &rarr; Service Authoring.</div>
      <% } %>
    <% } else { %>
      <% list.items.forEach(function(r) { var s = r.serviceDefinition; %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h5 class="mb-1">
                  <%= s.name %>
                  <span class="version-badge ms-1">v<%= s.version %></span>
                </h5>
                <p class="text-muted small mb-2">
                  <code class="text-muted small"><%= s.code %></code>
                  <span class="state-badge state-<%= s.status %>"><%= s.status %></span>
                  <span class="capability-badge"><%= s.capability_code %></span>
                  <% if (s.tenant_id === locals.platformTenantId) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Platform</span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border">Your tenant</span>
                  <% } %>
                  <% if (s.parent_service_definition_id) { %>
                    <span class="badge bg-secondary-subtle text-secondary border">Derived</span>
                  <% } %>
                </p>
                <% if (s.purpose) { %><p class="small mb-2"><%= s.purpose %></p><% } %>
                <% if (s.service_level && s.service_level.length > 0) { %>
                  <div class="mb-2 d-flex flex-wrap gap-1">
                    <% s.service_level.forEach(function(sl) {
                         var _op = sl.target_level === 'maximum' ? '≤' : (sl.target_level === 'exact' ? '=' : '≥');
                    %>
                      <span class="badge bg-light text-dark border" title="<%= sl.code %>"><%= sl.label %>: <%= _op %><%= sl.target %> <%= sl.units %></span>
                    <% }) %>
                  </div>
                <% } %>
                <% if (s.consumers && s.consumers.length > 0) { %>
                  <p class="small text-muted mb-0">Consumers: <%= s.consumers.join(', ') %></p>
                <% } %>
              </div>
            </div>
            <div class="d-flex gap-2 mt-2">
              <a href="/aisworg/seu/sdk/service-authoring/<%= s.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>View</a>
              <% if (locals.canCopy) { %>
                <form method="POST" action="/aisworg/seu/service-definitions/<%= s.id %>/copy">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-copy me-1"></i>Copy</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
