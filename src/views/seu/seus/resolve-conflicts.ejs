<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <%# The Resolve Conflicts screen of Compose EBM (CR-139). One vertical tab for each conflict table. A conflict shows what the sources say and the
       action that fits its kind. A pick is posted to the Compose route, which checks it, stores it and re-runs the detectors. %>
  <main class="container py-5" style="max-width: 1100px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <h2 class="h3 mb-1 text-dark fw-bold">Resolve Conflicts</h2>
    <p class="text-muted small mb-4">Where the sources of this composition disagree. Pick an answer for each open conflict. Composition completes when none is left open.</p>

    <% var _base = locals.listBasePath || ''; %>
    <% var _openTotal = tabs.reduce(function(n, t) { return n + t.open; }, 0); %>
    <% var _cells = locals.cells; var _esc = _cells.esc, _jsonHtml = _cells.jsonHtml, _cellHtml = _cells.cellHtml, _linksHtml = _cells.linksHtml; %>
    <% function _fmt(value) { return (value === null || value === undefined) ? '—' : (typeof value === 'object' ? JSON.stringify(value) : String(value)); } %>
    <% var _capInfo = locals.capabilityInfo || {}; %>
    <%# A value that names a Capability shows its name as a link that opens the Capability in a modal, with the code in muted text. %>
    <% function _valueHtml(value, linked) {
         var code = value && typeof value === 'object' && typeof value.capabilityCode === 'string' ? value.capabilityCode : null;
         if (!code) return _jsonHtml(value);
         var cap = _capInfo[code];
         if (!cap) return '<code>' + _esc(code) + '</code>';
         var name = linked
           ? '<button type="button" class="btn btn-link btn-sm p-0 align-baseline text-start" data-bs-toggle="modal" data-bs-target="#capabilityModal" data-name="' + _esc(cap.name) + '" data-code="' + _esc(code) + '" data-category="' + _esc(cap.category) + '" data-version="' + _esc(cap.version) + '" data-description="' + _esc(cap.description) + '" data-href="/aisworg/seu/capability-definitions/' + _esc(cap.id) + '">' + _esc(cap.name) + '</button>'
           : _esc(cap.name);
         return name + ' <span class="text-muted small">' + _esc(code) + '</span>';
       } %>
    <% var _compared = locals.comparedKinds || []; %>
    <% var _links = locals.resultLinks || []; %>
    <%# The entity that holds the whole definition of an option: its source Pack, Template or Profile. %>
    <% var _sourcePath = { pack: 'packs', template: 'templates', profile: 'profiles' }; %>
    <% function _optionLinks(opt, capInfo) {
         var links = [];
         if (opt.sourceId && _sourcePath[opt.sourceKind]) links.push({ label: opt.sourceKind.charAt(0).toUpperCase() + opt.sourceKind.slice(1) + ' ' + opt.sourceLabel, href: '/aisworg/seu/' + _sourcePath[opt.sourceKind] + '/' + opt.sourceId });
         var cap = opt.value && typeof opt.value === 'object' && typeof opt.value.capabilityCode === 'string' ? capInfo[opt.value.capabilityCode] : null;
         if (cap) links.push({ label: 'Capability ' + opt.value.capabilityCode, href: '/aisworg/seu/capability-definitions/' + cap.id });
         return links;
       } %>
    <%# The options of a conflict side by side: one column for each source, one row for each field (or, for a list of roles, for each role). A row where the sources differ is highlighted. %>
    <% function _compareRows(options) {
         var rows = [];
         if (options.every(function(o) { return Array.isArray(o.value); })) {
           var items = [];
           options.forEach(function(o) { o.value.forEach(function(x) { if (items.indexOf(x) < 0) items.push(x); }); });
           items.forEach(function(item) {
             var cells = options.map(function(o) { return o.value.indexOf(item) >= 0 ? 'Yes' : '—'; });
             rows.push({ name: String(item), cells: cells, differs: cells.some(function(x) { return x !== cells[0]; }) });
           });
           return rows;
         }
         var fields = [];
         options.forEach(function(o) { Object.keys(o.value || {}).forEach(function(k) { if (fields.indexOf(k) < 0) fields.push(k); }); });
         fields.forEach(function(f) {
           var raw = options.map(function(o) { return (o.value && Object.prototype.hasOwnProperty.call(o.value, f)) ? o.value[f] : undefined; });
           var cells = raw.map(function(x) { return x === undefined ? '—' : x; });
           rows.push({ name: f, cells: cells, differs: raw.some(function(x) { return JSON.stringify(x) !== JSON.stringify(raw[0]); }) });
         });
         rows.sort(function(a, b) { return (b.differs ? 1 : 0) - (a.differs ? 1 : 0); });
         return rows;
       } %>
    <% function _same(a, b) { return JSON.stringify(a) === JSON.stringify(b); } %>
    <% function _status(c) { return c.notice ? 'notice' : (c.resolution !== null && c.resolution !== undefined ? 'resolved' : 'open'); } %>

    <div class="d-flex align-items-center justify-content-end gap-2 mb-3">
      <a href="/aisworg/seu/objectives/<%= objectiveId %>/compose-ebm" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Compose</a>
    </div>

    <% if (locals.allResolved) { %>
      <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>No conflict is open. Continue with the composition transitions.</div>
    <% } else { %>
      <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i><%= _openTotal %> conflict<%= _openTotal === 1 ? ' is' : 's are' %> open.</div>
    <% } %>

    <div class="row g-4">
      <div class="col-md-3">
        <div class="section-card">
          <div class="section-header">Conflicts</div>
          <div class="nav flex-column nav-pills p-2" role="tablist" aria-orientation="vertical">
            <% tabs.forEach(function(t) { %>
              <a class="nav-link d-flex align-items-center justify-content-between <%= t.table === selectedTable ? 'active' : '' %>" href="<%= _base %>?category=<%= encodeURIComponent(t.table) %>">
                <span><%= t.label %></span>
                <% if (t.open > 0) { %>
                  <span class="badge bg-danger-subtle text-danger-emphasis"><%= t.open %></span>
                <% } else if (t.total > 0) { %>
                  <span class="badge bg-success-subtle text-success-emphasis"><%= t.total %></span>
                <% } %>
              </a>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="col-md-9">
        <%# What the SEU takes for this table. It is shown whether or not the table has a conflict. %>
        <% var _taken = locals.settledResult || []; %>
        <% var _cols = _cells.orderedColumns(_taken, locals.resultColumns || []); %>
        <div class="section-card">
          <div class="section-header collapsed d-flex align-items-center justify-content-between gap-2" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#seuTakes" aria-expanded="false" aria-controls="seuTakes">
            <span><i class="bi bi-check2-square me-1"></i>What the SEU takes</span>
            <i class="bi bi-chevron-down"></i>
          </div>
          <div id="seuTakes" class="collapse">
          <% if (!_taken.length) { %>
            <div class="p-3 text-muted small">Nothing yet.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><% _cols.forEach(function(col) { %><th class="small text-muted"><%= col %></th><% }) %><th class="small text-muted">Open</th></tr></thead>
                <tbody>
                  <% _taken.forEach(function(row, ri) { %>
                    <tr><% _cols.forEach(function(col) { %><td class="small"><%- _cellHtml(row[col], col, _links[ri]) %></td><% }) %><td class="small text-nowrap"><%- _linksHtml(_links[ri]) %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
          </div>
        </div>

        <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search conflicts' }) %>

        <% if (!list.items.length) { %>
          <div class="section-card"><div class="p-3 text-muted small">No conflict in this table.</div></div>
        <% } %>

        <% if (locals.asTable && list.items.length) { %>
          <%# The conflicts of this table are rows of one table, each with an Include or Exclude choice, and one Apply for all of them. %>
          <form method="POST" action="/aisworg/seu/objectives/<%= objectiveId %>/compose-ebm" id="rows-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="returnTo" value="resolve-conflicts">
            <input type="hidden" name="category" value="<%= selectedTable %>">
            <% selections.forEach(function(s) { %>
              <input type="hidden" name="templateProfile" value="<%= s.templateId %>|<%= s.profileId || '' %>">
            <% }) %>
            <div class="section-card">
              <div class="p-2" style="position: sticky; top: 0; z-index: 10; background: var(--surface); border-bottom: 1px solid var(--border);">
                <div class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i>The conflicts show Packs included that do not correspond to the Profile deliverable. They are paginated. Apply saves the choices made on this page.</div>
                <div class="d-flex align-items-center justify-content-end gap-2">
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-decision="include">Include all remaining</button>
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-decision="exclude">Exclude all remaining</button>
                  <button type="reset" class="btn btn-outline-secondary btn-sm">Reset</button>
                  <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                </div>
              </div>
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th class="small text-muted">Capability</th><th class="small text-muted">Include or exclude</th></tr></thead>
                  <tbody>
                    <% var _packVersions = locals.packVersions || {}; var _lastPack = null; %>
                    <% list.items.forEach(function(c, ci) { var opt = c.options[0]; var _packKey = opt ? (opt.sourceId || opt.sourceLabel) : ''; var _code = opt && opt.value && typeof opt.value.capabilityCode === 'string' ? opt.value.capabilityCode : null; var _cap = _code ? _capInfo[_code] : null; %>
                      <% if (_packKey !== _lastPack) { _lastPack = _packKey; %>
                        <tr class="table-light">
                          <td class="small fw-semibold" colspan="2">
                            <% if (opt && opt.sourceKind === 'pack' && opt.sourceId) { %>
                              <a href="/aisworg/seu/packs/<%= opt.sourceId %>" target="_blank" rel="noopener">Pack <%= opt.sourceLabel %></a><% if (_packVersions[opt.sourceId]) { %> <span class="text-muted fw-normal">v<%= _packVersions[opt.sourceId] %></span><% } %>
                            <% } else if (opt) { %><%= opt.sourceLabel %><% } %>
                          </td>
                        </tr>
                      <% } %>
                      <tr>
                        <td class="small">
                          <input type="hidden" name="ebmBulkKey" value="<%= c.key %>">
                          <% if (_cap) { %>
                            <%- _valueHtml(opt.value, true).replace(/ <span class="text-muted small">(.*)<\/span>$/, '<div class="text-muted small">$1</div>') %>
                          <% } else { %><%= _code || _fmt(opt && opt.value) %><% } %>
                        </td>
                        <td class="small">
                          <% if (!c.resolvable || c.action !== 'include-or-exclude') { %>
                            <span class="text-muted">This cannot be resolved here.</span>
                          <% } else { %>
                            <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="ebmBulkDecision_<%= ci %>" id="row-<%= ci %>-include" value="include" <%= c.resolution === 'include' ? 'checked' : '' %>><label class="form-check-label small" for="row-<%= ci %>-include">Include</label></div>
                            <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="ebmBulkDecision_<%= ci %>" id="row-<%= ci %>-exclude" value="exclude" <%= c.resolution === 'exclude' ? 'checked' : '' %>><label class="form-check-label small" for="row-<%= ci %>-exclude">Exclude</label></div>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </form>
        <% } else { %>
        <% list.items.forEach(function(c, ci) { %>
          <% var st = _status(c); %>
          <div class="section-card">
            <div class="section-header d-flex align-items-center justify-content-between gap-2">
              <span class="small fw-semibold"><%= c.title || c.kind %></span>
              <% if (st === 'open') { %><span class="badge bg-danger-subtle text-danger-emphasis">Open</span>
              <% } else if (st === 'resolved') { %><span class="badge bg-success-subtle text-success-emphasis">Resolved</span>
              <% } else { %><span class="badge bg-info-subtle text-info-emphasis">Notice</span><% } %>
            </div>
            <div class="p-3">
              <p class="mb-2"><%= c.message %></p>
              <% if (_compared.indexOf(c.kind) >= 0) { %>
                <div class="table-responsive mb-2">
                  <table class="table table-sm align-middle mb-0">
                    <thead><tr>
                      <th class="small text-muted"></th>
                      <% c.options.forEach(function(opt) { %>
                        <th class="small text-nowrap">
                          <% if (opt.sourceKind === 'pack' && opt.sourceId) { %>
                            <a href="/aisworg/seu/packs/<%= opt.sourceId %>" target="_blank" rel="noopener">Pack <%= opt.sourceLabel %></a>
                          <% } else { %><%= opt.sourceLabel %><% } %>
                        </th>
                      <% }) %>
                    </tr></thead>
                    <tbody>
                      <% _compareRows(c.options).forEach(function(r) { %>
                        <tr class="<%= r.differs ? 'table-warning' : '' %>">
                          <td class="small <%= r.differs ? 'fw-semibold' : 'text-muted' %>"><%= r.name %></td>
                          <% r.cells.forEach(function(cell) { %><td class="small <%= r.differs ? '' : 'text-muted' %>"><% if (cell !== null && typeof cell === 'object') { %><%- _jsonHtml(cell) %><% } else { %><%= cell %><% } %></td><% }) %>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <div class="text-muted small mb-2">The highlighted rows differ between the sources.</div>
              <% } else { %>
              <div class="table-responsive mb-2">
                <table class="table table-sm align-middle mb-0">
                  <thead><tr><th class="small text-muted">Source</th><th class="small text-muted">Value</th><th class="small text-muted">Open</th></tr></thead>
                  <tbody>
                    <% c.options.forEach(function(opt) { %>
                      <tr>
                        <td class="small text-nowrap"><%= opt.sourceLabel %></td>
                        <td class="small"><%- _valueHtml(opt.value, true) %></td>
                        <td class="small text-nowrap"><%- _linksHtml(_optionLinks(opt, _capInfo)) %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <% } %>

              <% if (st === 'resolved') { %>
                <div class="small mb-2">Your pick: <span class="fw-semibold"><code><%= _fmt(c.resolution) %></code></span></div>
              <% } %>

              <% if (c.notice) { %>
                <div class="text-muted small">A person verifies this. Nothing to pick.</div>
              <% } else if (!c.resolvable || c.action === 'none') { %>
                <div class="text-muted small">This cannot be resolved here.</div>
              <% } else { %>
                <form method="POST" action="/aisworg/seu/objectives/<%= objectiveId %>/compose-ebm" class="d-flex flex-wrap align-items-center gap-3">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="returnTo" value="resolve-conflicts">
                  <input type="hidden" name="category" value="<%= selectedTable %>">
                  <input type="hidden" name="ebmPickKey" value="<%= c.key %>">
                  <% selections.forEach(function(s) { %>
                    <input type="hidden" name="templateProfile" value="<%= s.templateId %>|<%= s.profileId || '' %>">
                  <% }) %>
                  <% if (c.action === 'include-or-exclude') { %>
                    <% var _dec = c.resolution; %>
                    <div class="form-check"><input class="form-check-input" type="radio" name="ebmPickDecision" id="dec-<%= ci %>-include" value="include" <%= _dec === 'include' ? 'checked' : '' %>><label class="form-check-label small" for="dec-<%= ci %>-include">Include</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="ebmPickDecision" id="dec-<%= ci %>-exclude" value="exclude" <%= _dec === 'exclude' ? 'checked' : '' %>><label class="form-check-label small" for="dec-<%= ci %>-exclude">Exclude</label></div>
                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                  <% } else { %>
                    <% c.options.forEach(function(opt, oi) { %>
                      <% var picked = (c.action === 'pick-any' ? (Array.isArray(c.resolution) && c.resolution.some(function(r) { return _same(r, opt.value); })) : _same(c.resolution, opt.value)); %>
                      <div class="form-check">
                        <input class="form-check-input" type="<%= c.action === 'pick-any' ? 'checkbox' : 'radio' %>" name="ebmPickOption" id="pick-<%= ci %>-<%= oi %>" value="<%= oi %>" <%= picked ? 'checked' : '' %>>
                        <label class="form-check-label small" for="pick-<%= ci %>-<%= oi %>"><%= opt.sourceLabel %><% if (_compared.indexOf(c.kind) < 0) { %>: <%- _valueHtml(opt.value, false) %><% } %></label>
                      </div>
                    <% }) %>
                    <button type="submit" class="btn btn-primary btn-sm"><%= c.action === 'pick-any' ? 'Apply (one or both)' : 'Apply' %></button>
                  <% } %>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
        <% } %>

        <%# What the EBM leaves out of this table, and why. %>
        <% var _left = locals.leftOut || []; %>
        <div class="section-card">
          <div class="section-header collapsed d-flex align-items-center justify-content-between gap-2" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#ebmLeavesOut" aria-expanded="false" aria-controls="ebmLeavesOut">
            <span><i class="bi bi-dash-circle me-1"></i>What the EBM leaves out, and why</span>
            <i class="bi bi-chevron-down"></i>
          </div>
          <div id="ebmLeavesOut" class="collapse">
          <% if (!_left.length) { %>
            <div class="p-3 text-muted small">Nothing is left out.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead><tr><th class="small text-muted">Left out</th><th class="small text-muted">Why</th></tr></thead>
                <tbody>
                  <% _left.forEach(function(row) { %>
                    <tr><td class="small"><code><%= row.item %></code></td><td class="small"><%= row.reason %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div class="modal fade" id="capabilityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title mb-0" id="capabilityModalTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <table class="table table-sm mb-3">
            <tbody>
              <tr><th class="text-muted small">Code</th><td class="small"><code id="capabilityModalCode"></code></td></tr>
              <tr><th class="text-muted small">Category</th><td class="small" id="capabilityModalCategory"></td></tr>
              <tr><th class="text-muted small">Version</th><td class="small" id="capabilityModalVersion"></td></tr>
            </tbody>
          </table>
          <p class="small mb-3" id="capabilityModalDescription"></p>
          <a href="#" id="capabilityModalLink" class="small" target="_blank" rel="noopener">Open the Capability Definition</a>
        </div>
      </div>
    </div>
  </div>
  <script>
    document.getElementById('capabilityModal').addEventListener('show.bs.modal', function (event) {
      var link = event.relatedTarget;
      if (!link) return;
      var get = function (name) { return link.getAttribute('data-' + name) || ''; };
      document.getElementById('capabilityModalTitle').textContent = get('name');
      document.getElementById('capabilityModalCode').textContent = get('code');
      document.getElementById('capabilityModalCategory').textContent = get('category') || '—';
      document.getElementById('capabilityModalVersion').textContent = get('version') || '—';
      document.getElementById('capabilityModalDescription').textContent = get('description') || 'No description.';
      document.getElementById('capabilityModalLink').setAttribute('href', get('href'));
    });

    // Include all remaining / Exclude all remaining: ticks the chosen radio on every row of this page that has no choice yet. A row already decided is left alone. Apply saves the ticks.
    document.querySelectorAll('[data-bulk-decision]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var form = document.getElementById('rows-form');
        if (!form) return;
        var decision = btn.getAttribute('data-bulk-decision');
        form.querySelectorAll('input[type="radio"][value="' + decision + '"]').forEach(function (radio) {
          var group = form.querySelectorAll('input[type="radio"][name="' + radio.name + '"]');
          var decided = Array.prototype.some.call(group, function (r) { return r.checked; });
          if (!decided) radio.checked = true;
        });
      });
    });
  </script>

  <%- include('../../partials/jsonMore') %>
  <%- include('../../partials/footer') %>
</body>
</html>
