<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <%# design/mvp-build-plan/SEU Composition.md, 2026-09-07 — Validate
       Request's own liveness output only (owner: "That was supposed to only
       show the liveness of the information... is n't it that decoupling is
       also going to need new pages"). Compose EBM's own output (unraveled
       pool, conflicts, resolution picker) lives on seu/seus/compose.ejs now,
       not here. This page never computes anything inline — the event chain
       (CommissionRequested -> validateRequestHandler) runs off the request
       that got here, before this page is ever loaded. %>
  <main class="container py-5" style="max-width: 700px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <h2 class="h3 mb-1 text-dark fw-bold">Commission Validation</h2>
    <p class="text-muted small mb-4">Whether the Objective, Profile, Template, and everything they reference are still live.</p>

    <% if (locals.pending) { %>
      <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-hourglass-split me-2"></i>Validating — <a href="" class="alert-link">reload</a> in a moment to see the result.
      </div>
    <% } %>

    <% if (locals.failed) { %>
      <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>Validate Request failed: <%= failureReason %>
      </div>
    <% } %>

    <% if (locals.passed) { %>
      <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>Validate Request passed — the Objective, Profile, Template, and everything they reference are still live.
      </div>
    <% } %>

    <% if (locals.checks && checks.length > 0) { %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white small fw-semibold text-muted">What was checked</div>
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>Check</th><th>Result</th><th>Detail</th></tr>
          </thead>
          <tbody>
            <% checks.forEach(function(c) { %>
              <tr>
                <td class="small"><%= c.item %></td>
                <td>
                  <% if (c.status === 'live') { %>
                    <span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-check-lg"></i> Live</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger-emphasis"><i class="bi bi-x-lg"></i> Dead</span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= c.detail || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (locals.failed) { %>
      <a href="/aisworg/seu/seus/new?objectiveId=<%= objectiveId %>" class="btn btn-outline-secondary btn-sm">Back to selection</a>
    <% } %>

    <% if (locals.passed) { %>
      <a href="/aisworg/seu/objectives/<%= objectiveId %>/compose-ebm" class="btn btn-primary btn-sm"><i class="bi bi-diagram-3 me-1"></i>View Compose EBM</a>
    <% } %>

    <p class="mt-4"><a href="/aisworg/seu/objectives/<%= objectiveId %>" class="text-muted small">Cancel — back to Objective</a></p>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
