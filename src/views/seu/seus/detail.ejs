<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%# CR-083 — .section-card/.section-header/.state-badge (and every
       .state-X colour variant this page uses) all now come from the
       canonical stylesheet. .edge-note is this page's own (only used
       here) and was dropped along with everything else above without
       being restored — genuinely unstyled until now. %>
  <style>
    .edge-note { font-size: 0.75rem; color: #64748b; }
  </style>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <%# design/mvp-build-plan/SEU Composition.md — owner: "There should be a
       viewEBM button... create a new one. EBM page." This page is SEU
       runtime content only now — Deliverable instances (with lifecycle
       state/transition forms), Capability fulfilment, Obligations, Evidence,
       Decisions, Knowledge, Command/Work Item/Dispatch, External
       Interactions, Events. Everything sourced from the EBM's own
       composition (Metadata/Parameters/Engineering Practices/Quality Gates/
       Services/Capability codes/Governance/declared Deliverable Catalogue)
       moved to its own page (seus/ebm.ejs), reached via the "View EBM"
       button on the All SEUs list — same CR-027 shared vertical-tab shell
       (partials/verticalTabs, paneMode). %>
  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <p class="text-muted small mb-1">
          <a href="/aisworg/seu/seus">&larr; All SEUs</a>
          <% if (detail.seu.active_ebm_id) { %> &middot; <a href="/aisworg/seu/seus/<%= detail.seu.id %>/ebm">View EBM</a><% } %>
        </p>
        <h2 class="h4 text-dark fw-bold mb-1"><%= detail.objectiveStatement %></h2>
        <p class="text-muted small mb-0 font-monospace"><%= detail.seu.id %></p>
      </div>
      <span class="state-badge state-<%= detail.seu.lifecycle_state %> fs-6"><%= detail.seu.lifecycle_state %></span>
      <% if (detail.blockedTransition) { %>
        <span class="state-badge state-Blocked fs-6 ms-1" title="<%= detail.blockedTransition.obligationTitle %>">Blocked</span>
      <% } %>
    </div>

    <%
      var tabs = [
        { key: 'deliverables', label: 'Deliverables', sub: detail.deliverables.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.deliverables.length + '</span>' : '' },
        { key: 'capabilities', label: 'Capability Fulfilment', sub: detail.capabilities.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.capabilities.length + '</span>' : '' },
        { key: 'obligations', label: 'Obligations', sub: detail.obligations.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.obligations.length + '</span>' : '' },
        { key: 'attentionItems', label: 'Attention Items', sub: detail.attentionItems.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.attentionItems.length + '</span>' : '' },
        { key: 'evidence', label: 'Evidence', sub: detail.evidence.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.evidence.length + '</span>' : '' },
        { key: 'decisions', label: 'Decisions', sub: detail.decisions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.decisions.length + '</span>' : '' },
        { key: 'knowledge', label: 'Knowledge', sub: detail.knowledgeItems.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.knowledgeItems.length + '</span>' : '' },
        { key: 'commands', label: 'Command / Work Item / Dispatch', sub: detail.commands.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.commands.length + '</span>' : '' },
        { key: 'external-interactions', label: 'External Interactions', sub: detail.externalInteractions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.externalInteractions.length + '</span>' : '' },
        { key: 'events', label: 'Events', sub: detail.events.length ? '<span class="badge bg-secondary-subtle text-secondary">' + detail.events.length + '</span>' : '' },
      ];
      var activeTabIndex = tabs.findIndex(function(t) { return t.key === String(locals.activeTab || ''); });
      if (activeTabIndex < 0) activeTabIndex = 0;
      var activeTabKey = tabs[activeTabIndex].key;
      function paneClass(key) { return 'tab-pane fade' + (key === activeTabKey ? ' show active' : ''); }
    %>

    <div class="d-flex flex-column flex-md-row gap-4 align-items-start mb-4">
      <%- include('../../partials/verticalTabs', { tabs: tabs, paneMode: true, paneIdPrefix: 'seu-detail', activePaneIndex: activeTabIndex }) %>

      <div class="tab-content flex-grow-1" style="min-width: 0;">

        <%# ---------------------------------------------------------------- Deliverables %>
        <div class="<%= paneClass('deliverables') %>" id="seu-detail-deliverables" role="tabpanel">
          <div class="section-card">
            <div class="section-header">Deliverables</div>
            <div class="table-responsive">
              <table class="table mb-0 align-middle">
                <thead class="table-light"><tr><th>Deliverable</th><th>State</th><th>Dependencies</th><th>Transition</th></tr></thead>
                <tbody>
                  <% if (detail.deliverables.length === 0) { %>
                    <tr><td colspan="4" class="text-muted small">No Deliverable instances yet — created once commissioning reaches Create Engineering Assets.</td></tr>
                  <% } %>
                  <% detail.deliverables.forEach(function(d) { %>
                    <tr>
                      <td class="small"><%= d.name %><br><span class="text-muted" style="font-size:0.72rem;"><% if (d.category) { %><%= d.category %> &middot; <% } %>Acquisition Scope: <%= d.acquisitionScope %></span></td>
                      <td><span class="state-badge state-<%= d.lifecycleState.replace(/\s+/g, '-') %>"><%= d.lifecycleState %></span></td>
                      <td>
                        <% if (d.dependencyEdges.length === 0) { %>
                          <span class="text-muted small">none</span>
                        <% } else { %>
                          <% d.dependencyEdges.forEach(function(e) { %>
                            <div class="edge-note">
                              <%= e.targetLabel %><% if (e.requiredState) { %> &rarr; <%= e.requiredState %><% } %>:
                              <span class="state-badge state-<%= e.readinessState %>"><%= e.readinessState %></span>
                            </div>
                          <% }) %>
                        <% } %>
                      </td>
                      <td>
                        <%# Bug fix (owner: "The styling is so bad. Validate
                             looks like a button" — a select+Apply pair reads
                             as a row of pills, and a closed <select> showing
                             its own single option's text LOOKS like a
                             button but isn't one). A real, unambiguous
                             button when there's only one real target state
                             (the overwhelmingly common case); the
                             select+submit shape stays for the genuine
                             multi-option case. %>
                        <% if (d.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (d.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/deliverables/<%= d.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= d.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= d.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/deliverables/<%= d.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% d.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Capability Fulfilment %>
        <%# Owner: "Layout of the Capability fulfilment layout has to
             change. It should show each of the participant types
             separately so a hybrid/composite participant types is
             possible... Instead of a list, use a card layout for each
             capability." One card per Capability (not a shared table row) —
             the eligible-Participant picker within it is grouped by every
             registered Participant Type (AI/Human/Automated/External),
             each its own section, so a human can deliberately check one
             from AI *and* one from Human (a real Hybrid, Ch.12 §7's own
             worked example) rather than Ctrl/Cmd-clicking blind through one
             flat, type-parenthetical <select multiple> (the prior layout —
             owner: "Very clumsy layout"). Checkboxes, all sharing the name
             `participantMasterIds`, submit as the same array
             fulfilCapabilityWithParticipants already accepts — one shared
             Assign action per card collects the picks across every type's
             section together, not a separate Assign per type. %>
        <div class="<%= paneClass('capabilities') %>" id="seu-detail-capabilities" role="tabpanel">
          <% detail.capabilities.forEach(function(c) { %>
            <div class="section-card mb-3">
              <div class="section-header">
                <span><%= c.name %> <code class="text-muted small"><%= c.code %></code></span>
                <span class="state-badge state-<%= c.status %>"><%= c.status %></span>
              </div>
              <div class="p-3">

                <% if (detail.requiredTechnologyPacks.length > 0 || detail.requiredDomainPacks.length > 0) { %>
                  <div class="small mb-3">
                    <% if (detail.requiredTechnologyPacks.length > 0) { %>
                      <span class="text-muted me-1">Technology:</span>
                      <% detail.requiredTechnologyPacks.forEach(function(v) { %><span class="badge bg-light text-dark border me-1"><%= v %></span><% }) %>
                    <% } %>
                    <% if (detail.requiredDomainPacks.length > 0) { %>
                      <span class="text-muted ms-3 me-1">Domain:</span>
                      <% detail.requiredDomainPacks.forEach(function(v) { %><span class="badge bg-light text-dark border me-1"><%= v %></span><% }) %>
                    <% } %>
                  </div>
                <% } %>

                <% if (c.status === 'Fulfilled') { %>
                  <% var hasAnyAssigned = c.participantsByType.some(function(g) { return g.participants.length > 0; }); %>
                  <% if (hasAnyAssigned) { %>
                    <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/capabilities/<%= c.capabilityId %>/release">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="row g-3">
                        <% c.participantsByType.forEach(function(group) { %>
                          <div class="col-6 col-md-3">
                            <div class="small fw-semibold text-muted mb-1"><%= group.type %></div>
                            <% if (group.participants.length > 0) { %>
                              <% group.participants.forEach(function(p) { %>
                                <div class="form-check">
                                  <input class="form-check-input" type="checkbox" name="participantIds" value="<%= p.id %>" id="assigned-<%= c.id %>-<%= p.id %>">
                                  <label class="form-check-label small" for="assigned-<%= c.id %>-<%= p.id %>">
                                    <%= p.displayName %> <span class="state-badge state-<%= p.state %>"><%= p.state %></span>
                                  </label>
                                </div>
                              <% }) %>
                            <% } else { %>
                              <span class="text-muted small">None</span>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                      <button type="submit" class="btn btn-sm btn-outline-secondary mt-3">Replace</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">&mdash;</span>
                  <% } %>
                <% } else { %>
                  <% var hasAnyEligible = c.eligibleParticipantsByType.some(function(g) { return g.participants.length > 0; }); %>
                  <% if (hasAnyEligible) { %>
                    <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/capabilities/<%= c.capabilityId %>/fulfil">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <div class="row g-3">
                        <% c.eligibleParticipantsByType.forEach(function(group) { %>
                          <div class="col-6 col-md-3">
                            <div class="small fw-semibold text-muted mb-1"><%= group.type %></div>
                            <% if (group.participants.length > 0) { %>
                              <% group.participants.forEach(function(p) { %>
                                <div class="form-check">
                                  <input class="form-check-input" type="checkbox" name="participantMasterIds" value="<%= p.id %>" id="pm-<%= c.id %>-<%= p.id %>">
                                  <label class="form-check-label small" for="pm-<%= c.id %>-<%= p.id %>"><%= p.displayName %></label>
                                </div>
                              <% }) %>
                            <% } else { %>
                              <span class="text-muted small">None available</span>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                      <button type="submit" class="btn btn-sm btn-primary mt-3">Assign</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">No available Participant satisfies this Capability.</span>
                  <% } %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

        <%# ---------------------------------------------------------------- Obligations %>
        <div class="<%= paneClass('obligations') %>" id="seu-detail-obligations" role="tabpanel">
          <div class="section-card">
            <%# Owner: "Remove the add form on the SEU detail page. The
                Participant should have an Obligation form... on a
                deliverable within the SEU." — manual creation now happens
                from the Participant's own "My Work" page
                (quickview/participant.ejs), scoped to their own assigned
                Deliverables, never here. %>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Severity</th><th>Status</th><th>Transition</th></tr></thead>
                <tbody>
                  <% if (detail.obligations.length === 0) { %>
                    <tr><td colspan="5" class="text-muted small">No Obligations — the Quality Gate on Deliverable "In Progress" &rarr; "Approved" will only block once one exists and isn't yet Verified/Closed/Archived.</td></tr>
                  <% } %>
                  <% detail.obligations.forEach(function(o) { %>
                    <tr>
                      <td class="small"><%= o.deliverableName %></td>
                      <td class="small">
                        <button type="button" class="btn btn-link btn-sm p-0 text-start align-baseline" data-bs-toggle="modal" data-bs-target="#obligationModal"
                          data-title="<%= o.obligation.title %>"
                          data-category="<%= o.obligation.category %>"
                          data-severity="<%= o.obligation.severity %>"
                          data-status="<%= o.obligation.status %>"
                          data-origin="<%= o.obligation.origin || '' %>"
                          data-priority="<%= o.obligation.priority || '' %>"
                          data-completion-criteria="<%= o.obligation.completion_criteria || '' %>"
                          data-related="<%= o.deliverableName %>"
                          data-blocked-from="<%= o.obligation.blocked_from_state || '' %>"
                          data-blocked-to="<%= o.obligation.blocked_to_state || '' %>"
                          data-created-at="<%= new Date(o.obligation.created_at).toLocaleString() %>"
                          data-updated-at="<%= new Date(o.obligation.updated_at).toLocaleString() %>"
                          data-description="<%= o.obligation.description || '' %>"
                          data-version="<%= o.obligation.version %>"
                          data-originating-entity-type="<%= o.obligation.originating_entity_type || '' %>"
                          data-originating-entity-id="<%= o.obligation.originating_entity_id || '' %>"
                          data-assigned-entity-type="<%= o.obligation.assigned_entity_type || '' %>"
                          data-assigned-entity-id="<%= o.obligation.assigned_entity_id || '' %>"
                          data-id="<%= o.obligation.id %>"
                        ><%= o.obligation.title %></button>
                      </td>
                      <td class="small"><%= o.obligation.category %> &middot; <%= o.obligation.severity %></td>
                      <td><span class="state-badge state-<%= o.obligation.status.replace(/\s+/g, '-') %>"><%= o.obligation.status %></span></td>
                      <td>
                        <%# Same fix as the Deliverables tab (owner: "The
                             styling is so bad. Validate looks like a
                             button") — a real, unambiguous button for the
                             common single-next-state case; the select+submit
                             shape stays only for genuine multi-option. %>
                        <% if (o.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (o.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/obligations/<%= o.obligation.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= o.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= o.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/obligations/<%= o.obligation.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% o.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Evidence %>
        <div class="<%= paneClass('evidence') %>" id="seu-detail-evidence" role="tabpanel">
          <div class="section-card">
            <div class="p-3 border-bottom">
              <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/evidence" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                  <select name="deliverableId" class="form-select form-select-sm" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% detail.deliverables.forEach(function(d) { %>
                      <option value="<%= d.id %>"><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="category" class="form-select form-select-sm">
                    <% ['Analytical Evidence','Validation Evidence','Operational Evidence','Review Evidence','Decision Evidence','External Evidence'].forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <input type="text" name="title" class="form-control form-control-sm" placeholder="Title" required style="width: 200px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="source" class="form-control form-control-sm" placeholder="Source" style="width: 140px;">
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary">Collect Evidence</button>
                </div>
                <%# Ch.17 model cleanup (migration 232) — Participant/Capability/
                    Decision/activity provenance is no longer captured at collection
                    time; Evidence doesn't declare who/what produced it, it's
                    required BY others (linked the same way any other related
                    object is, via the Link form below the table). confidence_level
                    is no longer author-set here either — it's computed from
                    validation-dimension assessments (see the Validate form per row). %>
                <%# CR-051 item 4 (Ch.17 §15/§20.13) — versioning: this new Evidence
                    Item corrects an earlier one. Includes cross-SEU-shared
                    candidates, not just this SEU's own Evidence. %>
                <div class="col-auto">
                  <select name="predecessorEvidenceId" class="form-select form-select-sm">
                    <option value="">Corrects&hellip;</option>
                    <% detail.evidenceSupersedeCandidates.forEach(function(ev) { %>
                      <option value="<%= ev.id %>"><%= ev.title %></option>
                    <% }) %>
                  </select>
                </div>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Supports</th><th>Title</th><th>Category / Confidence</th><th>Validation</th><th>Status</th><th>Transition</th><th>Link another</th></tr></thead>
                <tbody>
                  <% if (detail.evidence.length === 0) { %>
                    <tr><td colspan="7" class="text-muted small">No Evidence collected yet — the "Approved" &rarr; "Baselined" Quality Gate needs at least one Accepted Evidence Item or an approved Decision.</td></tr>
                  <% } %>
                  <% detail.evidence.forEach(function(e) { %>
                    <tr>
                      <%# Ch.17 model cleanup (migration 232) — one Evidence Item may
                          support many artefacts, including its own SEU membership
                          (filtered out of this display list); relatedObjectLabels
                          lists all the non-SEU ones. %>
                      <td class="small"><%= e.relatedObjectLabels.join(', ') || '—' %></td>
                      <%# CR-051 item 4 (Ch.17 §15/§20.13) — shown only on the
                          correcting row itself; nothing added to the predecessor's
                          own row (no cross-SEU signal, deliberately). %>
                      <td class="small"><%= e.evidence.title %><% if (e.predecessorTitle) { %> <span class="text-muted">(corrects: <%= e.predecessorTitle %>)</span><% } %></td>
                      <td class="small"><%= e.evidence.category %> &middot; <%= e.evidence.confidence_level || 'unassessed' %></td>
                      <%# Ch.17 model cleanup — validation_dimensions is append-only;
                          show the most recent assessment per dimension plus a form to
                          record another. Full history lives on the record, not just
                          what's rendered here. %>
                      <td class="small">
                        <% e.evidence.validation_dimensions.forEach(function(v) { %>
                          <div><%= v.dimension %>: <%= v.status %><% if (v.notes) { %> <span class="text-muted" style="font-size:0.7rem;">(<%= v.notes %>)</span><% } %></div>
                        <% }) %>
                        <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/evidence/<%= e.evidence.id %>/validate" class="d-flex flex-wrap gap-1 align-items-center mt-1">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <select name="dimension" class="form-select form-select-sm" style="width:auto;">
                            <% ['authenticity','completeness','consistency','source-credibility','engineering-relevance'].forEach(function(dim) { %>
                              <option value="<%= dim %>"><%= dim %></option>
                            <% }) %>
                          </select>
                          <select name="status" class="form-select form-select-sm" style="width:auto;">
                            <% ['Pass','Partial','Fail','Not Assessed'].forEach(function(s) { %>
                              <option value="<%= s %>"><%= s %></option>
                            <% }) %>
                          </select>
                          <input type="text" name="notes" class="form-control form-control-sm" style="width:auto;" placeholder="notes (optional)">
                          <button type="submit" class="btn btn-sm btn-outline-primary">Assess</button>
                        </form>
                      </td>
                      <td><span class="state-badge state-<%= e.evidence.status %>"><%= e.evidence.status %></span></td>
                      <td>
                        <% if (e.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (e.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/evidence/<%= e.evidence.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= e.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= e.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/evidence/<%= e.evidence.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% e.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                      <td>
                        <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/evidence/<%= e.evidence.id %>/link"
                              class="d-flex align-items-center gap-2">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <select name="deliverableId" class="form-select form-select-sm" style="width: auto;" required>
                            <option value="" disabled selected>Deliverable&hellip;</option>
                            <% detail.deliverables.forEach(function(d) { %>
                              <option value="<%= d.id %>"><%= d.name %></option>
                            <% }) %>
                          </select>
                          <button type="submit" class="btn btn-sm btn-outline-secondary">Link</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Decisions %>
        <div class="<%= paneClass('decisions') %>" id="seu-detail-decisions" role="tabpanel">
          <div class="section-card">
            <div class="p-3 border-bottom">
              <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/decisions" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                  <select name="deliverableId" class="form-select form-select-sm" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% detail.deliverables.forEach(function(d) { %>
                      <option value="<%= d.id %>"><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="knowledgeId" class="form-select form-select-sm">
                    <option value="">(no supporting Knowledge)</option>
                    <% detail.knowledgeItems.forEach(function(k) { %>
                      <option value="<%= k.knowledgeItem.id %>"><%= k.knowledgeItem.title %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="category" class="form-select form-select-sm">
                    <% ['Architecture Decisions','Design Decisions','Engineering Decisions','Operational Decisions','Governance Decisions'].forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <input type="text" name="title" class="form-control form-control-sm" placeholder="Title" required style="width: 200px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="alternativeStatement" class="form-control form-control-sm" placeholder="First alternative" style="width: 180px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="alternativeRationale" class="form-control form-control-sm" placeholder="Rationale" style="width: 180px;">
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary">Identify Decision</button>
                </div>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category</th><th>Status</th><th>Transition</th></tr></thead>
                <tbody>
                  <% if (detail.decisions.length === 0) { %>
                    <tr><td colspan="5" class="text-muted small">No Decisions yet — the "Approved" &rarr; "Baselined" Quality Gate needs at least one Approved/Applied Decision or an Accepted Evidence Item.</td></tr>
                  <% } %>
                  <% detail.decisions.forEach(function(dec) { %>
                    <tr>
                      <td class="small"><%= dec.relatedObjectLabels.join(', ') %></td>
                      <td class="small"><%= dec.decision.title %><% dec.decision.alternatives.forEach(function(alt) { %><br><span class="text-muted" style="font-size:0.72rem;">&rarr; <%= alt.statement %> (<%= alt.status %>)</span><% }) %></td>
                      <td class="small"><%= dec.decision.category %></td>
                      <td><span class="state-badge state-<%= dec.decision.status %>"><%= dec.decision.status %></span></td>
                      <td>
                        <% if (dec.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (dec.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/decisions/<%= dec.decision.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= dec.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= dec.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/decisions/<%= dec.decision.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% dec.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Knowledge %>
        <div class="<%= paneClass('knowledge') %>" id="seu-detail-knowledge" role="tabpanel">
          <div class="section-card">
            <div class="p-3 border-bottom">
              <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/knowledge" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                  <select name="deliverableId" class="form-select form-select-sm" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% detail.deliverables.forEach(function(d) { %>
                      <option value="<%= d.id %>"><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="evidenceId" class="form-select form-select-sm">
                    <option value="">(no supporting Evidence)</option>
                    <% detail.evidence.forEach(function(e) { %>
                      <option value="<%= e.evidence.id %>"><%= e.evidence.title %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="category" class="form-select form-select-sm">
                    <% ['Architectural Knowledge','Domain Knowledge','Technical Knowledge','Operational Knowledge','Governance Knowledge','Process Knowledge'].forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <input type="text" name="title" class="form-control form-control-sm" placeholder="Title" required style="width: 200px;">
                </div>
                <div class="col-auto">
                  <select name="acquisitionScope" class="form-select form-select-sm">
                    <% ['SEU','Capability','Enterprise','Platform'].forEach(function(s) { %>
                      <option value="<%= s %>"><%= s %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary">Observe Knowledge</button>
                </div>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Scope</th><th>Status</th><th>Transition</th><th>Promote Scope</th></tr></thead>
                <tbody>
                  <% if (detail.knowledgeItems.length === 0) { %>
                    <tr><td colspan="6" class="text-muted small">No Knowledge Items yet.</td></tr>
                  <% } %>
                  <% detail.knowledgeItems.forEach(function(k) { %>
                    <tr>
                      <td class="small"><%= k.deliverableName %></td>
                      <td class="small"><%= k.knowledgeItem.title %></td>
                      <td class="small"><%= k.knowledgeItem.category %> &middot; <%= k.knowledgeItem.acquisition_scope %></td>
                      <td><span class="state-badge state-<%= k.knowledgeItem.status %>"><%= k.knowledgeItem.status %></span></td>
                      <td>
                        <% if (k.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (k.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= k.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= k.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% k.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                      <td>
                        <% if (k.possibleNextScopes.length === 0) { %>
                          <span class="text-muted small"><%= k.knowledgeItem.acquisition_scope === 'Platform' ? 'already Platform' : 'no further promotion defined' %></span>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/promote-scope"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetScope" class="form-select form-select-sm" style="width: auto;">
                              <% k.possibleNextScopes.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Promote</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Command / Work Item / Dispatch %>
        <div class="<%= paneClass('commands') %>" id="seu-detail-commands" role="tabpanel">
          <div class="section-card">
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Command</th><th>Transition</th><th>Status</th><th>Work Item</th></tr></thead>
                <tbody>
                  <% if (detail.commands.length === 0) { %>
                    <tr><td colspan="4" class="text-muted small">No Commands generated yet — every Deliverable transition on the Deliverables tab generates one.</td></tr>
                  <% } %>
                  <% detail.commands.forEach(function(cmd) { %>
                    <tr>
                      <td class="small"><%= cmd.entityLabel %><br><span class="text-muted" style="font-size:0.72rem;"><%= cmd.commandType %></span></td>
                      <td class="small"><%= cmd.fromState %> &rarr; <%= cmd.toState %></td>
                      <td><span class="state-badge state-<%= cmd.status %>"><%= cmd.status %></span></td>
                      <td class="small">
                        <% if (cmd.workItems.length === 0) { %>
                          <span class="text-muted">none</span>
                        <% } else { %>
                          <% cmd.workItems.forEach(function(wi) { %>
                            <div>
                              <span class="state-badge state-<%= wi.status %>"><%= wi.status %></span>
                              <% if (wi.participantLabel) { %> &rarr; <%= wi.participantLabel %><% } %>
                              <% if (wi.dispatchStrategy) { %> <span class="text-muted" style="font-size:0.7rem;">(<%= wi.dispatchStrategy %>)</span><% } %>
                              <% if (wi.executionContext) { %>
                                <% var ec = wi.executionContext; %>
                                <details style="font-size:0.72rem;">
                                  <summary class="text-muted">Execution Context</summary>
                                  <div class="ps-2">
                                    <div><strong>Objective:</strong> <%= ec.engineeringObjective %></div>
                                    <% if (ec.service) { %><div><strong>Service:</strong> <%= ec.service.name %> (<%= ec.service.code %>)</div><% } %>
                                    <div><strong>Input location:</strong> <%= ec.inputLocation || '—' %></div>
                                    <div><strong>Output location:</strong> <%= ec.outputLocation || '—' %></div>
                                    <div><strong>Decisions:</strong> <%= ec.relevantDecisions.map(function(d){ return d.title + ' (' + d.status + ')'; }).join(', ') || 'none' %></div>
                                    <div><strong>Evidence:</strong> <%= ec.supportingEvidence.map(function(e){ return e.title + ' (' + e.status + ')'; }).join(', ') || 'none' %></div>
                                    <div><strong>Knowledge:</strong> <%= ec.relevantKnowledge.map(function(k){ return k.title; }).join(', ') || 'none' %></div>
                                    <div><strong>Governing Policies:</strong> <%= ec.governingPolicies.map(function(p){ return p.name; }).join(', ') || 'none' %></div>
                                    <div><strong>Applicable Authority:</strong> <%= ec.applicableAuthority ? ec.applicableAuthority.code : 'none' %></div>
                                    <div><strong>Active Obligations:</strong> <%= ec.activeObligations.map(function(o){ return o.title + ' (' + o.status + ')'; }).join(', ') || 'none' %></div>
                                    <div><strong>Open Attention Items:</strong> <%= ec.openAttentionItems.map(function(a){ return a.title; }).join(', ') || 'none' %></div>
                                    <% if (ec.qualityGate) { %><div><strong>Quality Gate:</strong> <%= ec.qualityGate.name %> (<%= ec.qualityGate.outcome %>)</div><% } %>
                                    <% if ((ec.applicableChecklists || []).length > 0) { %><div><strong>Checklist:</strong> <%= ec.applicableChecklists.map(function(c){ return c.statement; }).join('; ') %></div><% } %>
                                    <% if ((ec.engineeringCapital || []).length > 0) { %><div><strong>Engineering Capital:</strong> <%= ec.engineeringCapital.map(function(c){ return c.type ? (c.type + (c.url ? ': ' + c.url : '')) : (c.url || ''); }).join(', ') %></div><% } %>
                                    <% var pc = ec.profileConfiguration || {}; var pcEntries = Object.keys(pc).filter(function(k){ return pc[k] !== undefined && pc[k] !== null && pc[k] !== ''; }); %>
                                    <% if (pcEntries.length > 0) { %><div><strong>Profile:</strong> <%= pcEntries.map(function(k){ var v = pc[k]; return k + ': ' + (Array.isArray(v) ? v.join('/') : (typeof v === 'object' ? JSON.stringify(v) : v)); }).join(', ') %></div><% } %>
                                  </div>
                                </details>
                              <% } %>
                            </div>
                          <% }) %>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- External Interactions %>
        <div class="<%= paneClass('external-interactions') %>" id="seu-detail-external-interactions" role="tabpanel">
          <div class="section-card">
            <div class="p-3 border-bottom">
              <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/external-interactions" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                  <select name="deliverableId" class="form-select form-select-sm">
                    <option value="">(not tied to a Deliverable)</option>
                    <% detail.deliverables.forEach(function(d) { %>
                      <option value="<%= d.id %>"><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <select name="direction" class="form-select form-select-sm">
                    <option value="Outbound">Outbound</option>
                    <option value="Inbound">Inbound</option>
                  </select>
                </div>
                <div class="col-auto">
                  <input type="text" name="interactionType" class="form-control form-control-sm" placeholder="Interaction type" required style="width: 160px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="targetSystem" class="form-control form-control-sm" placeholder="Target system" required style="width: 160px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="purpose" class="form-control form-control-sm" placeholder="Purpose" style="width: 200px;">
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary">Record Interaction</button>
                </div>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Deliverable</th><th>Type / Direction</th><th>Target System</th><th>Status</th><th>Transition</th></tr></thead>
                <tbody>
                  <% if (detail.externalInteractions.length === 0) { %>
                    <tr><td colspan="5" class="text-muted small">No External Interactions recorded yet — Ch.36: a transition to "Failed" automatically raises an Attention Item.</td></tr>
                  <% } %>
                  <% detail.externalInteractions.forEach(function(ei) { %>
                    <tr>
                      <td class="small"><%= ei.deliverableName || '—' %></td>
                      <td class="small"><%= ei.interaction.interaction_type %> &middot; <%= ei.interaction.direction %></td>
                      <td class="small"><%= ei.interaction.target_system %><% if (ei.interaction.purpose) { %><br><span class="text-muted" style="font-size:0.72rem;"><%= ei.interaction.purpose %></span><% } %></td>
                      <td><span class="state-badge state-<%= ei.interaction.status.replace(/\s+/g, '-') %>"><%= ei.interaction.status %></span></td>
                      <td>
                        <% if (ei.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (ei.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/external-interactions/<%= ei.interaction.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= ei.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= ei.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/external-interactions/<%= ei.interaction.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% ei.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Events %>
        <div class="<%= paneClass('events') %>" id="seu-detail-events" role="tabpanel">
          <div class="section-card">
            <% if (locals.session?.user?.role === 'super') { %>
              <div class="p-2 border-bottom text-end">
                <a href="/aisworg/seu/events?seuId=<%= detail.seu.id %>" class="small">Explore full history in Event Bus &rarr;</a>
              </div>
            <% } %>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Type</th><th>Object</th><th>When</th><th></th></tr></thead>
                <tbody>
                  <% if (detail.events.length === 0) { %>
                    <tr><td colspan="4" class="text-muted small">No events yet.</td></tr>
                  <% } %>
                  <% detail.events.forEach(function(e, i) { %>
                    <tr>
                      <td class="small"><code><%= e.event_type %></code></td>
                      <td class="small text-muted"><%= e.originating_object_type %></td>
                      <td class="small text-muted"><%= new Date(e.occurred_at).toLocaleString() %></td>
                      <td>
                        <button type="button" class="btn btn-sm btn-link py-0" data-bs-toggle="collapse" data-bs-target="#seu-event-<%= i %>">view</button>
                      </td>
                    </tr>
                    <tr class="collapse" id="seu-event-<%= i %>">
                      <td colspan="4">
                        <pre class="small bg-light rounded p-2 mb-0" style="max-height: 16rem; overflow: auto;"><%= JSON.stringify(e, null, 2) %></pre>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <%# ---------------------------------------------------------------- Attention Items %>
        <div class="<%= paneClass('attentionItems') %>" id="seu-detail-attentionItems" role="tabpanel">
          <div class="section-card">
            <div class="p-3 border-bottom">
              <%# Basic form for now (owner: "Just a basic tab and form based
                  on what we have now. But this will expand later") — no
                  Ontology-backed category vocabulary exists yet for
                  AttentionItem (unlike Obligation's category:obligation), so
                  this stays free text rather than inventing one. Related
                  Deliverable is optional — unlike Obligation, AttentionItem's
                  related_object_type/id are nullable (an Attention Item can
                  be SEU-level, not tied to any one Deliverable). %>
              <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/attention-items" class="row g-2 align-items-center">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-auto">
                  <select name="deliverableId" class="form-select form-select-sm">
                    <option value="">SEU-level (no Deliverable)</option>
                    <% detail.deliverables.forEach(function(d) { %>
                      <option value="<%= d.id %>"><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <input type="text" name="category" class="form-control form-control-sm" placeholder="Category" required style="width: 160px;">
                </div>
                <div class="col-auto">
                  <input type="text" name="title" class="form-control form-control-sm" placeholder="Title" required style="width: 220px;">
                </div>
                <div class="col-auto">
                  <select name="priority" class="form-select form-select-sm">
                    <% ['Low','Medium','High','Critical'].forEach(function(p) { %>
                      <option value="<%= p %>" <%= p === 'Medium' ? 'selected' : '' %>><%= p %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-auto">
                  <button type="submit" class="btn btn-sm btn-primary">Create Attention Item</button>
                </div>
              </form>
            </div>
            <div class="table-responsive">
              <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Related</th><th>Title</th><th>Category / Priority</th><th>Status</th><th>Transition</th></tr></thead>
                <tbody>
                  <% if (detail.attentionItems.length === 0) { %>
                    <tr><td colspan="5" class="text-muted small">No Attention Items.</td></tr>
                  <% } %>
                  <% detail.attentionItems.forEach(function(a) { %>
                    <tr>
                      <td class="small"><%= a.relatedName || '—' %></td>
                      <td class="small"><%= a.attentionItem.title %></td>
                      <td class="small"><%= a.attentionItem.category %> &middot; <%= a.attentionItem.priority %></td>
                      <td><span class="state-badge state-<%= a.attentionItem.status.replace(/\s+/g, '-') %>"><%= a.attentionItem.status %></span></td>
                      <td>
                        <% if (a.possibleNextStates.length === 0) { %>
                          <span class="text-muted small">no further transitions defined</span>
                        <% } else if (a.possibleNextStates.length === 1) { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/attention-items/<%= a.attentionItem.id %>/transition" class="mb-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="targetState" value="<%= a.possibleNextStates[0] %>">
                            <button type="submit" class="btn btn-sm btn-primary"><%= a.possibleNextStates[0] %></button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/aisworg/seu/seus/<%= detail.seu.id %>/attention-items/<%= a.attentionItem.id %>/transition"
                                class="d-flex align-items-center gap-2">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="targetState" class="form-select form-select-sm" style="width: auto;">
                              <% a.possibleNextStates.forEach(function(s) { %>
                                <option value="<%= s %>"><%= s %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <%# Ch.23 — one shared modal for every Obligation row's "view", populated
      from the clicked button's own data-* attributes on show.bs.modal (same
      pattern as sdk/ontology/index.ejs's #descriptionModal). Sectioned into
      Definition-like fields (category/severity/origin/priority/completion
      criteria — what this Obligation IS) vs Execution State (status/blocked
      hop/timestamps — where it stands right now) rather than one flat JSON
      dump, per the owner's own ask. %>
  <div class="modal fade" id="obligationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title mb-0" id="obligationModalTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <%# migration 252 — a pure Revision (no transition, no event; Ch.23
              §9's governed lifecycle is untouched by this form). Posts to
              /obligations/:id/revise, which diffs against the live row and
              appends only the fields that actually changed to
              revision_history, so a later viewer can still see the old
              description/severity/priority/completion criteria. %>
          <form method="POST" id="obligationReviseForm" class="mb-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-2">
              <label class="form-label small text-muted mb-1">Description</label>
              <textarea class="form-control form-control-sm" name="description" id="obligationModalDescription" rows="2"></textarea>
            </div>

            <h6 class="text-uppercase text-muted small fw-bold mb-2">Obligation</h6>
            <table class="table table-sm table-borderless mb-1">
              <tbody>
                <tr><th class="text-muted small" style="width: 40%;">Category</th><td class="small" id="obligationModalCategory"></td></tr>
                <tr><th class="text-muted small">Severity</th><td class="small"><input type="text" class="form-control form-control-sm" name="severity" id="obligationModalSeverity"></td></tr>
                <tr><th class="text-muted small">Origin</th><td class="small" id="obligationModalOrigin"></td></tr>
                <tr><th class="text-muted small">Priority</th><td class="small"><input type="text" class="form-control form-control-sm" name="priority" id="obligationModalPriority"></td></tr>
                <tr><th class="text-muted small">Completion Criteria</th><td class="small"><textarea class="form-control form-control-sm" name="completionCriteria" id="obligationModalCompletionCriteria" rows="2"></textarea></td></tr>
                <tr><th class="text-muted small">Related to</th><td class="small" id="obligationModalRelated"></td></tr>
              </tbody>
            </table>
            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
          </form>

          <h6 class="text-uppercase text-muted small fw-bold mb-2">Execution State</h6>
          <table class="table table-sm table-borderless mb-0">
            <tbody>
              <tr><th class="text-muted small" style="width: 40%;">Status</th><td class="small" id="obligationModalStatus"></td></tr>
              <tr><th class="text-muted small">Version</th><td class="small" id="obligationModalVersion"></td></tr>
              <tr id="obligationModalBlockedRow"><th class="text-muted small">Blocking</th><td class="small" id="obligationModalBlocked"></td></tr>
              <tr><th class="text-muted small">Originating entity</th><td class="small" id="obligationModalOriginatingEntity"></td></tr>
              <tr><th class="text-muted small">Assigned to</th><td class="small" id="obligationModalAssignedEntity"></td></tr>
              <tr><th class="text-muted small">Created</th><td class="small" id="obligationModalCreatedAt"></td></tr>
              <tr><th class="text-muted small">Last updated</th><td class="small" id="obligationModalUpdatedAt"></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var modalEl = document.getElementById('obligationModal');
      if (!modalEl) return;
      modalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        if (!btn) return;
        var get = function (name) { return btn.getAttribute('data-' + name) || ''; };
        document.getElementById('obligationModalTitle').textContent = get('title');
        document.getElementById('obligationModalDescription').value = get('description');
        document.getElementById('obligationModalCategory').textContent = get('category') || '—';
        document.getElementById('obligationModalSeverity').value = get('severity');
        document.getElementById('obligationModalOrigin').textContent = get('origin') || '—';
        document.getElementById('obligationModalPriority').value = get('priority');
        document.getElementById('obligationModalCompletionCriteria').value = get('completion-criteria');
        document.getElementById('obligationModalRelated').textContent = get('related') || '—';
        document.getElementById('obligationReviseForm').action = '/aisworg/seu/seus/<%= detail.seu.id %>/obligations/' + get('id') + '/revise';
        document.getElementById('obligationModalStatus').textContent = get('status');
        document.getElementById('obligationModalVersion').textContent = get('version') || '1';
        document.getElementById('obligationModalCreatedAt').textContent = get('created-at');
        document.getElementById('obligationModalUpdatedAt').textContent = get('updated-at');
        var originatingType = get('originating-entity-type'), originatingId = get('originating-entity-id');
        document.getElementById('obligationModalOriginatingEntity').textContent = originatingType ? (originatingType + (originatingId ? ' (' + originatingId + ')' : '')) : '—';
        var assignedType = get('assigned-entity-type'), assignedId = get('assigned-entity-id');
        document.getElementById('obligationModalAssignedEntity').textContent = assignedType ? (assignedType + (assignedId ? ' (' + assignedId + ')' : '')) : 'Unassigned';
        var blockedFrom = get('blocked-from'), blockedTo = get('blocked-to');
        var blockedRow = document.getElementById('obligationModalBlockedRow');
        if (blockedTo) {
          blockedRow.hidden = false;
          document.getElementById('obligationModalBlocked').textContent = 'blocks ' + (blockedFrom || '?') + ' → ' + blockedTo + ' until resolved';
        } else {
          blockedRow.hidden = true;
        }
      });
    })();
  </script>

  <%- include('../../partials/footer') %>
</body>
</html>
