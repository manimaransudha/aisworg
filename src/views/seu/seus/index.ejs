<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .state-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 999px; }
    .state-Operational { background: #dcfce7; color: #166534; }
    .state-Pending, .state-Commissioned, .state-Configured, .state-Activated { background: #fef9c3; color: #854d0e; }
    .state-Suspended, .state-Retired, .state-Archived { background: #f1f5f9; color: #64748b; }
  </style>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold">SEUs</h2>
        <p class="text-muted small mb-0">Every commissioned Software Engineering Unit.</p>
      </div>
      <a href="/aisworg/seu/seus/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Commission a new SEU</a>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/seus'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search objective / state' }) %>

    <% if (list.total === 0) { %>
      <div class="alert alert-light border text-center py-5">
        <p class="mb-3 text-muted"><%= list.q ? 'No SEUs match your search.' : 'No SEUs commissioned yet.' %></p>
        <% if (!list.q) { %><a href="/aisworg/seu/seus/new" class="btn btn-primary btn-sm">Commission the first one</a><% } %>
      </div>
    <% } else { %>
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr>
                <th><%- sortLink('Objective', 'objective', list, _base) %></th>
                <th><%- sortLink('Lifecycle State', 'state', list, _base) %></th>
                <th><%- sortLink('Created', 'created', list, _base) %></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% list.items.forEach(function(s) { %>
                <tr>
                  <td class="small"><%= s.objectiveStatement %></td>
                  <td><span class="state-badge state-<%= s.lifecycleState %>"><%= s.lifecycleState %></span></td>
                  <td class="small text-muted"><%= new Date(s.createdAt).toLocaleString() %></td>
                  <td class="text-end"><a href="/aisworg/seu/seus/<%= s.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
