<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 700px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <h2 class="h3 mb-1 text-dark fw-bold">Commission a new SEU</h2>
    <p class="text-muted small mb-4">
      One submit runs the full pipeline: create the Objective, find a Template that satisfies every
      required Capability, apply a default Profile, then commission — the Composition Engine runs and
      the SEU walks its lifecycle through to Operational.
    </p>

    <% if (capabilities.length === 0) { %>
      <div class="alert alert-warning">
        No Capabilities are loaded yet — run <code>pnpm seed:seu</code> before commissioning an SEU.
      </div>
    <% } else { %>
      <form method="POST" action="/aisworg/seu/seus" class="card border-0 shadow-sm p-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="statement" class="form-label fw-semibold">Objective statement</label>
          <textarea id="statement" name="statement" rows="3" class="form-control" required
                    placeholder="e.g. Stand up a customer web portal"></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Required Capabilities</label>
          <p class="text-muted small mb-2">Only Templates supporting every Capability checked below will be considered.</p>
          <% capabilities.forEach(function(c) { %>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="requiredCapabilityCodes" value="<%= c.code %>"
                     id="cap-<%= c.code %>" checked>
              <label class="form-check-label" for="cap-<%= c.code %>">
                <%= c.name %> <code class="text-muted small"><%= c.code %></code>
              </label>
            </div>
          <% }) %>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-rocket-takeoff me-1"></i>Commission</button>
        <a href="/aisworg/seu/seus" class="btn btn-link text-muted">Cancel</a>
      </form>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
