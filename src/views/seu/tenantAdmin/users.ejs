<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-people me-2"></i>Tenant User Management</h2>
      <p class="text-muted small mb-0">Users in your own tenant. Standing noun_verb badges (e.g. deliverable_publish, objective_propose), on each user's own participants_master row.</p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/tenant-admin/users'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search email / name / role' }) %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <table class="table table-sm align-middle">
          <thead><tr>
            <th><%- sortLink('Email', 'email', list, _base) %></th>
            <th><%- sortLink('Name', 'name', list, _base) %></th>
            <th><%- sortLink('Role', 'role', list, _base) %></th>
            <th>Active</th>
            <th>Badges</th>
          </tr></thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="5" class="text-muted small text-center py-3"><%= list.q ? 'No users match your search.' : 'No users in your tenant yet.' %></td></tr>
            <% } %>
            <% list.items.forEach(function(u) { %>
              <tr>
                <td class="small"><%= u.email %></td>
                <td class="small"><%= u.name || '' %></td>
                <td><span class="badge bg-light text-dark border"><%= u.role %></span></td>
                <td><%= u.is_active ? 'Yes' : 'No' %></td>
                <td class="text-nowrap">
                  <%# Owner: "write to participants_master and remove
                      badge_grants" — one multi-select, reconciled to exactly
                      what's selected on submit (setTenantUserAuthorisedBadges,
                      core/identity.ts), same shape as Identity Management's
                      own Badge Management page. %>
                  <form method="POST" action="/aisworg/seu/tenant-admin/users/<%= u.id %>/badges" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="badges[]" class="form-select form-select-sm" style="width: auto; min-width: 14rem;" size="4" multiple>
                      <% grantableBadges.forEach(function(b) { %>
                        <option value="<%= b %>" <%= u.authorisedBadges.includes(b) ? 'selected' : '' %>><%= b %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
