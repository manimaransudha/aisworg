<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <%# CR-083 — .display-id-pill centralised into public/css/style.css
       (was duplicated per-view; dropped without migration on
       objectives/detail.ejs, leaving it unstyled there). %>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 700px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <h2 class="h3 mb-1 text-dark fw-bold">New <%= tier %> Objective</h2>
    <% if (locals.parent) { %>
      <p class="text-muted small mb-4">
        Decomposed under <strong><%= parent.tier %></strong>: <a href="/aisworg/seu/objectives/<%= parent.id %>"><% if (parent.display_id) { %><span class="display-id-pill me-1"><%= parent.display_id %></span><% } %><%= parent.statement %></a>.
        Created as <strong>Proposed</strong> — activate it before commissioning an SEU against it.
      </p>
    <% } else { %>
      <p class="text-muted small mb-4">
        A <strong>Strategic</strong> Objective is a root — it has no parent. Created as <strong>Proposed</strong>;
        decompose it into Operational / Engineering children, and commission SEUs against the leaves.
      </p>
    <% } %>

    <% if (capabilities.length === 0) { %>
      <div class="alert alert-warning">No capability-name Ontology concepts are loaded yet — run the ontology migrations (046, 150) first.</div>
    <% } else { %>
      <form method="POST" action="/aisworg/seu/objectives" class="mb-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="tier" value="<%= tier %>">
        <% if (locals.parent) { %><input type="hidden" name="parentObjectiveId" value="<%= parent.id %>"><% } %>

        <div class="mb-3" style="position: sticky; top: 0; z-index: 10; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-md); padding: .85rem 1.25rem;">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Create <%= tier %> Objective</button>
            <a href="<%= locals.parent ? ('/aisworg/seu/objectives/' + parent.id) : '/aisworg/seu/objectives' %>" class="btn btn-link text-muted">Cancel</a>
          </div>
        </div>

        <div class="section-card">
          <div class="section-header">New <%= tier %> Objective</div>
          <div class="p-3">
            <div class="mb-3">
              <label for="statement" class="form-label fw-semibold">Statement</label>
              <textarea id="statement" name="statement" rows="3" class="form-control" required
                        placeholder="e.g. Stand up a claims-processing platform for a retail insurance client"><%= locals.statement || '' %></textarea>
            </div>

            <div class="mb-0">
              <label class="form-label fw-semibold">Required Capabilities</label>
              <% if (locals.parent) { %>
                <p class="text-muted small mb-2">Inherited from the parent Objective — adjust as needed before saving.</p>
              <% } %>
              <div id="capability-list" style="max-height: 320px; overflow-y: auto;" class="border rounded p-2">
                <% capabilities.forEach(function(c) { %>
                  <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" name="requiredCapabilityCodes" value="<%= c.code %>"
                           data-code="<%= c.code %>" id="cap-<%= c.code %>"
                           <%= (locals.selectedCodes || []).includes(c.code) ? 'checked' : '' %>>
                    <label class="form-check-label" for="cap-<%= c.code %>">
                      <%= c.name %> <code class="text-muted small"><%= c.code %></code>
                      <% if (c.description) { %><div class="text-muted small"><%= c.description %></div><% } %>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </form>
    <% } %>
  </main>

  <script>
    (function () {
      var statement = document.getElementById('statement');
      var debounceTimer;
      function suggest() {
        var text = statement.value.trim();
        if (!text) return;
        fetch('/aisworg/api/seu/objectives/suggest-capabilities?statement=' + encodeURIComponent(text))
          .then(function (r) { return r.json(); })
          .then(function (data) {
            (data.capabilityCodes || []).forEach(function (code) {
              var box = document.querySelector('input[data-code="' + code + '"]');
              if (box) box.checked = true;
            });
          })
          .catch(function () { /* suggestion is best-effort — silent on failure */ });
      }
      // Auto-suggest disabled for now (owner, 2026-09-03): the word-overlap
      // match against the 60-concept Chapter-10 vocabulary's long descriptions
      // is too loose (plain substring, not whole-word) and was auto-checking
      // unrelated capabilities on every blur of the Statement field. Logic
      // kept in place (suggest() below, and the API route it calls), just not
      // wired to fire automatically — re-enable by uncommenting once the
      // matching itself is tightened (see CR-086).
      // if (statement) {
      //   statement.addEventListener('blur', suggest);
      //   statement.addEventListener('input', function () {
      //     clearTimeout(debounceTimer);
      //     debounceTimer = setTimeout(suggest, 800);
      //   });
      // }
    })();
  </script>

  <%- include('../../partials/footer') %>
</body>
</html>
