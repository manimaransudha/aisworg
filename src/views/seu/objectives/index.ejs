<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .state-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 999px; }
    .state-Active { background: #dcfce7; color: #166534; }
    .state-Proposed { background: #fef9c3; color: #854d0e; }
    .state-Achieved { background: #dbeafe; color: #1e40af; }
    .state-Superseded, .state-Retired, .state-Archived { background: #f1f5f9; color: #64748b; }
    .tier-badge { font-size: 0.68rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 6px; background: #ede9fe; color: #5b21b6; }
  </style>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold">Objectives</h2>
        <p class="text-muted small mb-0">Ch.1 — the root of the Engineering Layer. Every SEU is commissioned to achieve one.</p>
      </div>
      <a href="/aisworg/seu/objectives/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Objective</a>
    </div>

    <% if (objectives.length === 0) { %>
      <div class="alert alert-light border text-center py-5">
        <p class="mb-3 text-muted">No Objectives yet.</p>
        <a href="/aisworg/seu/objectives/new" class="btn btn-primary btn-sm">Create the first one</a>
      </div>
    <% } else { %>
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr><th>Statement</th><th>Tier</th><th>Status</th><th>Version</th><th>Decomposition</th><th></th></tr>
            </thead>
            <tbody>
              <% objectives.forEach(function(o) { %>
                <tr>
                  <td class="small"><%= o.statement %></td>
                  <td><span class="tier-badge"><%= o.tier %></span></td>
                  <td><span class="state-badge state-<%= o.status %>"><%= o.status %></span></td>
                  <td class="small text-muted">v<%= o.version %></td>
                  <td class="small text-muted"><%= o.parentObjectiveId ? 'child' : '—' %></td>
                  <td class="text-end"><a href="/aisworg/seu/objectives/<%= o.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
