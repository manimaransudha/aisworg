<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .state-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 999px; }
    .state-Active { background: #dcfce7; color: #166534; }
    .state-Proposed { background: #fef9c3; color: #854d0e; }
    .state-Achieved { background: #dbeafe; color: #1e40af; }
    .state-Superseded, .state-Retired, .state-Archived { background: #f1f5f9; color: #64748b; }
    .tier-badge { font-size: 0.68rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 6px; background: #ede9fe; color: #5b21b6; }
    .tree-node:hover { background: #f8fafc; }
    .breadcrumb-path { font-size: 0.72rem; color: #94a3b8; }
  </style>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold">Objectives</h2>
        <p class="text-muted small mb-0">Ch.1 — the Strategic → Operational → Engineering decomposition. Every SEU serves the finest-grained (leaf) Objective.</p>
      </div>
      <a href="/aisworg/seu/objectives/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Strategic Objective</a>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/objectives'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search all Objectives by statement' }) %>

    <% if (list.total === 0) { %>
      <div class="alert alert-light border text-center py-5">
        <% if (mode === 'search') { %>
          <p class="mb-0 text-muted">No Objectives match your search.</p>
        <% } else { %>
          <p class="mb-3 text-muted">No Objectives yet. The tree starts with a Strategic Objective.</p>
          <a href="/aisworg/seu/objectives/new" class="btn btn-primary btn-sm">Create the first Strategic Objective</a>
        <% } %>
      </div>
    <% } else if (mode === 'search') { %>
      <!-- Search mode: flat hits, each with its breadcrumb to root. -->
      <div class="card border-0 shadow-sm">
        <div class="list-group list-group-flush">
          <% list.items.forEach(function(o) { %>
            <div class="list-group-item">
              <% if (o.path && o.path.length) { %>
                <div class="breadcrumb-path mb-1">
                  <% o.path.forEach(function(p, i) { %><%= i ? ' › ' : '' %><a href="/aisworg/seu/objectives/<%= p.id %>" class="text-muted text-decoration-none"><%= p.statement %></a><% }) %>
                </div>
              <% } %>
              <div class="d-flex align-items-center gap-2">
                <span class="tier-badge"><%= o.tier %></span>
                <a href="/aisworg/seu/objectives/<%= o.id %>" class="small text-dark text-decoration-none fw-semibold flex-grow-1"><%= o.statement %></a>
                <span class="state-badge state-<%= o.status %>"><%= o.status %></span>
                <% if (o.commissioned) { %>
                  <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Commissioned</span>
                <% } else if (o.commissionable) { %>
                  <form method="POST" action="/aisworg/seu/objectives/<%= o.id %>/commission" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-primary py-0"><i class="bi bi-diagram-3 me-1"></i>Commission SEU</button>
                  </form>
                <% } %>
                <a href="/aisworg/seu/objectives/<%= o.id %>" class="btn btn-sm btn-outline-primary py-0">View</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <!-- Browse mode: paginated Strategic roots; expand to lazy-load children. -->
      <div class="card border-0 shadow-sm" id="objective-tree">
        <%- include('_nodes', { nodes: roots, depth: 0, csrfToken: locals.csrfToken, childTiers: childTiers }) %>
      </div>
    <% } %>
  </main>

  <script>
    (function () {
      var tree = document.getElementById('objective-tree');
      if (!tree) return;
      document.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.tree-toggle') : null;
        if (!btn || !tree.contains(btn)) return;
        var id = btn.getAttribute('data-id');
        var depth = parseInt(btn.getAttribute('data-depth'), 10) || 0;
        var container = tree.querySelector('.tree-children[data-parent="' + id + '"]');
        if (!container) return;
        var icon = btn.querySelector('i');

        if (btn.getAttribute('data-loaded') === '1') {
          var isHidden = container.style.display === 'none';
          container.style.display = isHidden ? '' : 'none';
          if (icon) icon.className = isHidden ? 'bi bi-chevron-down' : 'bi bi-chevron-right';
          return;
        }
        fetch('/aisworg/seu/objectives/' + encodeURIComponent(id) + '/children?depth=' + (depth + 1))
          .then(function (r) { return r.text(); })
          .then(function (html) {
            container.innerHTML = html;
            btn.setAttribute('data-loaded', '1');
            if (icon) icon.className = 'bi bi-chevron-down';
          })
          .catch(function () { /* best-effort expand */ });
      });
    })();
  </script>

  <%- include('../../partials/footer') %>
</body>
</html>
