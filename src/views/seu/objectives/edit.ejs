<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
  <style>
    .display-id-pill { display: inline-block; font-family: var(--bs-font-monospace, monospace); font-size: 0.72rem; font-weight: 700; padding: 0.18rem 0.55rem; border-radius: 999px; background: #e2e8f0; color: #334155; }
  </style>
</head>
<body>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 700px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <p class="text-muted small mb-1"><a href="/aisworg/seu/objectives/<%= objective.id %>">&larr; Back</a></p>
    <h2 class="h3 mb-1 text-dark fw-bold">
      Edit <% if (objective.display_id) { %><span class="display-id-pill me-1"><%= objective.display_id %></span><% } %>
      <span class="text-muted fw-normal">(<%= objective.tier %>, v<%= objective.version %>)</span>
    </h2>

    <%# CR-075 (owner: "Only propose can edit every field... All other
         states can only add comments in their edit form") — statement,
         required Capabilities, Add child and Move are only available while
         Proposed; every other status is Comments-only. Real enforcement in
         updateObjective/reParentObjective/createObjective either way, not
         just this. The list already hides the Edit link once locked
         (submitted for activation) — this page doesn't separately re-check
         or hide anything for that narrower case. %>
    <% if (objective.status !== 'Proposed') { %>
      <p class="text-muted small mb-4">Only Comments can be added — statement, required Capabilities and decomposition are only editable while Proposed (this Objective is <%= objective.status %>).</p>
    <% } else { %>
      <p class="text-muted small mb-4">
        Tier can't be changed here — only statement, required Capabilities, decomposition and parent.
      </p>

      <% if (capabilities.length === 0) { %>
        <div class="alert alert-warning">No capability-name Ontology concepts are loaded yet — run the ontology migrations (046, 150) first.</div>
      <% } else { %>
        <form method="POST" action="/aisworg/seu/objectives/<%= objective.id %>/update" class="card border-0 shadow-sm p-4 mb-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="mb-3">
            <label for="statement" class="form-label fw-semibold">Statement</label>
            <textarea id="statement" name="statement" rows="3" class="form-control" required><%= locals.statement || '' %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Required Capabilities</label>
            <div id="capability-list">
              <% capabilities.forEach(function(c) { %>
                <div class="form-check mb-1">
                  <input class="form-check-input" type="checkbox" name="requiredCapabilityCodes" value="<%= c.code %>"
                         id="cap-<%= c.code %>"
                         <%= (locals.selectedCodes || []).includes(c.code) ? 'checked' : '' %>>
                  <label class="form-check-label" for="cap-<%= c.code %>">
                    <%= c.name %> <code class="text-muted small"><%= c.code %></code>
                    <% if (c.description) { %><div class="text-muted small"><%= c.description %></div><% } %>
                  </label>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="submit" name="action" value="save" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
            <button type="submit" name="action" value="save_no_version" class="btn btn-outline-secondary" formnovalidate>Save without versioning</button>
            <a href="/aisworg/seu/objectives/<%= objective.id %>" class="btn btn-link text-muted">Cancel</a>
          </div>
          <div class="form-text mt-2">
            <strong>Save</strong> advances the version (v<%= objective.version %> &rarr; next patch). <strong>Save without versioning</strong> keeps it at v<%= objective.version %>.
          </div>
        </form>
      <% } %>

      <% if ((locals.childTiers || []).length > 0) { %>
        <div class="card border-0 shadow-sm p-4 mb-4">
          <div class="fw-semibold mb-2">Add a child</div>
          <div class="d-inline-flex gap-1 flex-wrap">
            <% childTiers.forEach(function(ct) { %>
              <a href="/aisworg/seu/objectives/new?parent=<%= objective.id %>&tier=<%= ct %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus-lg"></i> Add <%= ct %></a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (objective.tier !== 'Strategic') { %>
        <div class="card border-0 shadow-sm p-4">
          <div class="fw-semibold mb-2">Move to a different parent</div>
          <% if ((locals.reParentOptions || []).length === 0) { %>
            <span class="text-muted small">No other valid parent available.</span>
          <% } else { %>
            <form method="POST" action="/aisworg/seu/objectives/<%= objective.id %>/move" class="d-flex align-items-center gap-2 flex-wrap">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="newParentId" class="form-select form-select-sm" style="width: auto; max-width: 100%;">
                <% reParentOptions.forEach(function(p) { %>
                  <option value="<%= p.id %>" <%= objective.parent_objective_id === p.id ? 'selected' : '' %>><%= p.displayId ? (p.displayId + ' — ') : '' %><%= p.tier %>: <%= p.statement.slice(0, 60) %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-sm btn-outline-secondary">Move</button>
            </form>
            <div class="form-text">The whole subtree moves with it. New parent can't be more strategic, itself, or one of its descendants.</div>
          <% } %>
        </div>
      <% } %>
    <% } %>

    <%# CR-073/CR-075 — posting a comment is a mutation, so it lives on Edit,
         not the view page (owner: "The view page has the post button. I
         have been saying repeatedly no edits on a view page"). Available
         regardless of status above (owner: "any time... independent of the
         Objective's current status") — a separate rule from the Proposed-only
         gate on everything else on this page. %>
    <div class="card border-0 shadow-sm p-4 mt-4">
      <div class="fw-semibold mb-2">Comments</div>
      <% if ((locals.comments || []).length === 0) { %>
        <p class="text-muted small mb-3">No comments yet.</p>
      <% } else { %>
        <ul class="list-unstyled mb-3">
          <% comments.forEach(function(c) { %>
            <li class="mb-2 pb-2 border-bottom">
              <div class="small text-muted"><%= new Date(c.created_at).toLocaleString() %><% if (c.actor_id) { %> &middot; user <%= c.actor_id %><% } %></div>
              <div class="small"><%= c.comment_text %></div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <% if (locals.canComment) { %>
        <form method="POST" action="/aisworg/seu/objectives/<%= objective.id %>/comments" class="d-flex align-items-start gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea name="comment" rows="2" class="form-control form-control-sm" placeholder="Add a comment" required></textarea>
          <button type="submit" class="btn btn-sm btn-outline-secondary">Post</button>
        </form>
      <% } %>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
