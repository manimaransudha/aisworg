<%# CR-009 tree node rows. Rendered for the root page (included by index.ejs) and
    for lazy child expansion (returned standalone by GET /objectives/:id/children).
    Locals: nodes[], depth (int), csrfToken, childTiers (tier -> allowed child tiers),
    canRetireObjective/canProposeObjective (CR-071 — gate Retire/Delete; View stays unconditional),
    hasObjectiveBadge(verb) (CR-072 — gates Submit/the next-transition button per row, since
    each row's own submitVerb/nextTransitionVerb can differ). %>
<table class="table table-hover align-middle mb-0">
  <tbody>
    <% nodes.forEach(function(node) { %>
      <tr class="tree-node align-middle" data-id="<%= node.id %>" data-depth="<%= depth %>">
        <!-- 1. TIER -->
        <td class="text-center align-middle" style="width: 110px;">
          <span class="tier-badge"><%= node.tier %></span>
        </td>

        <!-- 2. OBJECTIVE STATEMENT -->
        <td class="align-middle">
          <span style="display:inline-block; width: <%= depth * 1.25 %>rem; flex-shrink:0;"></span>
          <% if (node.hasChildren) { %>
            <button type="button" class="tree-toggle btn btn-sm btn-link p-0 text-decoration-none text-secondary me-1" data-id="<%= node.id %>" data-depth="<%= depth %>" aria-label="Expand">
              <i class="bi bi-chevron-right"></i>
            </button>
          <% } else { %>
            <span class="text-muted me-1" style="display:inline-block; width: 1.25rem; text-align:center;">&middot;</span>
          <% } %>
          <a href="/aisworg/seu/objectives/<%= node.id %>" class="small text-dark text-decoration-none fw-semibold">
            <% if (node.displayId) { %><span class="display-id-pill me-1"><%= node.displayId %></span><% } %><%= node.statement %>
          </a>
        </td>

        <!-- 3. STATUS -->
        <td class="text-center align-middle" style="width: 120px;">
          <span class="state-badge state-<%= node.status %>"><%= node.status %></span>
        </td>

        <!-- 4. BUTTONS (Tier Buttons | Manage Buttons separated by a vertical divider line) -->
        <td class="align-middle text-end pe-3" style="width: 360px;">
          <%
            const hasCommissioned = !!node.commissioned;
            const hasCommission = !hasCommissioned && !!node.commissionable;
            const hasQueue = !!(node.submitVerb && !node.alreadySubmitted && hasObjectiveBadge(node.submitVerb));
            const hasNextTransition = !!(node.submitVerb && node.alreadySubmitted && hasObjectiveBadge(node.nextTransitionVerb));
            const hasEdit = canProposeObjective && !node.editLocked;
            const hasDelete = node.deletable && canProposeObjective;
            const hasRetire = !hasDelete && node.retirable && canRetireObjective;
          %>
          <div class="d-inline-flex align-items-center justify-content-end">
            <!-- Tier Buttons -->
            <div class="d-inline-flex gap-1 align-items-center me-2 pe-2 border-end border-secondary-subtle">
              <% if (canProposeObjective && (childTiers[node.tier] || []).length > 0) { %>
                <% (childTiers[node.tier] || []).forEach(function(ct) { %>
                  <a href="/aisworg/seu/objectives/new?parent=<%= node.id %>&tier=<%= ct %>" class="btn btn-sm btn-outline-secondary py-0"><i class="bi bi-plus-lg"></i> <%= ct %></a>
                <% }) %>
              <% } %>
            </div>

            <!-- Manage Buttons -->
            <div class="d-inline-flex gap-1 align-items-center">
              <a href="/aisworg/seu/objectives/<%= node.id %>" class="btn btn-sm btn-outline-primary py-0 me-1">View</a>
              <% if (hasCommissioned || hasCommission || hasQueue || hasNextTransition || hasEdit || hasDelete || hasRetire) { %>
                <div class="dropdown d-inline">
                  <button class="btn btn-sm btn-outline-secondary py-0 px-2 dropdown-toggle-no-caret" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <% if (hasCommissioned) { %>
                      <li>
                        <a class="dropdown-item small" href="/aisworg/seu/seus/<%= node.commissionedSeuId %>">
                          <i class="bi bi-check-circle me-2 text-success"></i>Commissioned &mdash; view SEU
                        </a>
                      </li>
                    <% } else if (hasCommission) { %>
                      <li>
                        <a class="dropdown-item small" href="/aisworg/seu/seus/new?objectiveId=<%= node.id %>">
                          <i class="bi bi-diagram-3 me-2 text-primary"></i>Commission SEU
                        </a>
                      </li>
                    <% } %>
                    <% if (hasQueue) { %>
                      <% if (hasCommissioned || hasCommission) { %><li><hr class="dropdown-divider"></li><% } %>
                      <li>
                        <form method="POST" action="/aisworg/seu/objectives/<%= node.id %>/submit" class="d-inline w-100">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="dropdown-item small"><i class="bi bi-send me-2 text-primary"></i>Submit</button>
                        </form>
                      </li>
                    <% } %>
                    <% if (hasNextTransition) { %>
                      <% if (hasCommissioned || hasCommission) { %><li><hr class="dropdown-divider"></li><% } %>
                      <li>
                        <form method="POST" action="/aisworg/seu/objectives/<%= node.id %>/transition/<%= node.nextTransitionVerb %>" class="d-inline w-100">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="dropdown-item small"><i class="bi bi-play-fill me-2 text-success"></i><%= node.nextTransitionVerb.charAt(0).toUpperCase() + node.nextTransitionVerb.slice(1) %></button>
                        </form>
                      </li>
                    <% } %>
                    <% if (hasEdit) { %>
                      <% if (hasCommissioned || hasCommission || hasQueue || hasNextTransition) { %><li><hr class="dropdown-divider"></li><% } %>
                      <li>
                        <a class="dropdown-item small" href="/aisworg/seu/objectives/<%= node.id %>/edit">
                          <i class="bi bi-pencil me-2 text-secondary"></i>Edit Objective
                        </a>
                      </li>
                    <% } %>
                    <% if (hasDelete) { %>
                      <% if (hasEdit) { %><li><hr class="dropdown-divider"></li><% } %>
                      <li>
                        <form method="POST" action="/aisworg/seu/objectives/<%= node.id %>/delete" class="d-inline w-100" onsubmit="return confirm('Delete this Proposed Objective? This cannot be undone.');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                        </form>
                      </li>
                    <% } else if (hasRetire) { %>
                      <% if (hasEdit) { %><li><hr class="dropdown-divider"></li><% } %>
                      <li>
                        <form method="POST" action="/aisworg/seu/objectives/<%= node.id %>/retire" class="d-inline w-100" onsubmit="return confirm('Retire this Objective and its subtree? Retired Objectives keep their history and SEUs.');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="dropdown-item small text-warning"><i class="bi bi-archive me-2"></i>Retire Objective</button>
                        </form>
                      </li>
                    <% } %>
                  </ul>
                </div>
              <% } %>
            </div>
          </div>
        </td>
      </tr>
      <tr class="tree-children-row" data-parent="<%= node.id %>" style="display:none;">
        <td colspan="4" class="p-0 border-0">
          <div class="tree-children ps-3 border-start border-2 border-primary-subtle ms-4" data-parent="<%= node.id %>"></div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>