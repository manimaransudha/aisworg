<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-shield-lock me-2"></i>Route Authority</h2>
        <p class="text-muted small mb-0">
          Which badge(s)/role(s) each route requires — data (CR-110), not a literal baked into the route file.
          Changing a row here does not yet change enforcement: <code>requireBadge</code>/<code>requireRole</code>
          are not wired to read from this table yet (see the CR's "Remaining" section).
        </p>
      </div>
      <a class="btn btn-sm btn-primary" href="/aisworg/seu/route-authority/new"><i class="bi bi-plus-lg me-1"></i>New row</a>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/route-authority'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search method / path' }) %>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <table class="table table-sm align-middle mb-0">
          <thead><tr>
            <th><%- sortLink('Method', 'method', list, _base) %></th>
            <th><%- sortLink('Path', 'path', list, _base) %></th>
            <th>Badges</th>
            <th>Roles</th>
            <th>Match</th>
            <th></th>
          </tr></thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="6" class="text-muted small text-center py-3"><%= list.q ? 'No rows match your search.' : 'No rows yet.' %></td></tr>
            <% } %>
            <% list.items.forEach(function(r) { %>
              <tr>
                <td><span class="badge bg-light text-dark border"><%= r.method %></span></td>
                <td class="small font-monospace"><%= r.path %></td>
                <td>
                  <% if (!r.badges.length) { %><span class="text-muted small">(none)</span><% } %>
                  <% r.badges.forEach(function(b) { %><span class="badge bg-secondary-subtle text-dark-emphasis me-1"><%= b %></span><% }) %>
                </td>
                <td>
                  <% if (!r.roles.length) { %><span class="text-muted small">(none)</span><% } %>
                  <% r.roles.forEach(function(role) { %><span class="badge bg-info-subtle text-dark-emphasis me-1"><%= role %></span><% }) %>
                </td>
                <td class="text-muted small"><%= r.match_mode %></td>
                <td class="text-nowrap">
                  <a class="btn btn-sm btn-outline-primary" href="/aisworg/seu/route-authority/<%= r.id %>/edit">Edit</a>
                  <form method="POST" action="/aisworg/seu/route-authority/<%= r.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this row?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
