<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-2">
      <a href="/aisworg/seu/deliverable-definitions" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>All Deliverables</a>
    </div>

    <div class="mb-4">
      <h2 class="h3 mb-2 text-dark fw-bold">Deliverable Definition: <%= displayName %></h2>
      <div class="d-flex align-items-center gap-2">
        <span class="state-badge state-<%= deliverable.status %>"><%= deliverable.status %></span>
        <span class="small text-muted">v<%= deliverable.version %></span>
        <code class="text-muted"><%= deliverable.code %></code>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header"><span class="lp-toggle-title">Details</span></div>
      <div class="p-3">
        <div class="small text-muted">Description</div>
        <div><%= deliverable.description || '—' %></div>
        <div class="small text-muted mt-3">Guide location</div>
        <div>
          <% if (/^https?:\/\//.test(deliverable.guide_location || '')) { %>
            <a href="<%= deliverable.guide_location %>" target="_blank" rel="noopener noreferrer"><%= deliverable.guide_location %></a>
          <% } else { %><%= deliverable.guide_location || '—' %><% } %>
        </div>
        <div class="small text-muted">The folder that holds the samples, templates and guidelines for this Deliverable. Each work item type has its own folder below it.</div>
      </div>
    </div>

    <div class="section-card">
      <div class="section-header"><span class="lp-toggle-title">Services that output this Deliverable</span></div>
      <% if (services.length === 0) { %>
        <div class="p-3 small text-muted">No Active Service outputs this Deliverable.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Service</th><th>Capability</th></tr></thead>
            <tbody>
              <% services.forEach(function(s) { %>
                <tr>
                  <td><a href="/aisworg/seu/service-definitions/<%= s.id %>" class="text-decoration-none"><%= s.name %></a> <code class="text-muted small ms-1"><%= s.code %></code></td>
                  <td>
                    <% if (s.capability) { %>
                      <a href="/aisworg/seu/capability-definitions/<%= s.capability.id %>" class="text-decoration-none"><%= s.capability.label %></a> <code class="text-muted small ms-1"><%= s.capability.code %></code>
                    <% } else { %><span class="text-muted">—</span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="section-card">
      <div class="section-header"><span class="lp-toggle-title">Work item types and Guide Locations</span></div>
      <% if (workItemTypes.length === 0) { %>
        <div class="p-3 small text-muted">No work item types are defined for this Deliverable.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Work item type</th><th>Role</th><th>Capability</th><th>Guide location</th></tr></thead>
            <tbody>
              <% workItemTypes.forEach(function(t) { %>
                <tr>
                  <td><%= t.worktypeLabel %> <code class="text-muted small ms-1"><%= t.worktype %></code></td>
                  <td><%= t.roleLabel %> <code class="text-muted small ms-1"><%= t.role %></code></td>
                  <td><%= t.capabilities.length ? t.capabilities.join(', ') : '—' %></td>
                  <td>
                    <% if (/^https?:\/\//.test(t.guideLocation || '')) { %>
                      <a href="<%= t.guideLocation %>" target="_blank" rel="noopener noreferrer"><%= t.guideLocation %></a>
                    <% } else { %><%= t.guideLocation || '—' %><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
