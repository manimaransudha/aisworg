<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Documentation</h2>
      <p class="text-muted small mb-0">Specification and implementation chapters, read directly from <code>src/docs</code>.</p>
    </div>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <% folders.forEach(function(f) { %>
            <div class="col-md-6">
              <a class="d-block text-decoration-none border rounded p-3 h-100" href="<%= docPathHref(f.path) %>">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-folder2-open text-primary fs-5"></i>
                  <span class="fw-semibold text-dark"><%= f.name %></span>
                </div>
              </a>
            </div>
          <% }) %>
          <% if (!folders.length) { %>
            <div class="col-12 text-muted small">No documentation folders found.</div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
