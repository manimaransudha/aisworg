<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold">Participants</h2>
      <p class="text-muted small mb-0">
        Participant Registry (CR-098, Ch.13 §8) — every <code>participants_master</code> resource: a reusable
        identity (Human, AI, Automated or External) available to be engaged into SEUs, with its own Assigned
        Capabilities, Competency and Behaviour Context. Distinct from a SEU's own Participant engagements
        (visible on that SEU's detail page) — this is the resource pool they're drawn from.
      </p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/participants'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search name or type' }) %>
    <div class="small text-muted mb-3">Sort:
      <%- sortLink('Name', 'name', list, _base) %> &middot;
      <%- sortLink('Type', 'type', list, _base) %> &middot;
      <%- sortLink('Tenant', 'tenant', list, _base) %>
    </div>

    <%
      var _types = locals.participantTypes || [];
      var _activeType = locals.activeType || '';
    %>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="<%= _base + listQueryString(list, { status: '' }) %>" class="btn btn-sm <%= _activeType ? 'btn-outline-secondary' : 'btn-secondary' %>">All types</a>
      <% _types.forEach(function(t) { %>
        <a href="<%= _base + listQueryString(list, { status: t }) %>" class="btn btn-sm <%= _activeType === t ? 'btn-secondary' : 'btn-outline-secondary' %>"><%= t %></a>
      <% }) %>
    </div>

    <% if (list.total === 0) { %>
      <% if (list.q) { %>
        <div class="alert alert-warning">No Participants match your search.</div>
      <% } else if (_activeType) { %>
        <div class="alert alert-warning">No <%= _activeType %> Participants registered yet.</div>
      <% } else { %>
        <div class="alert alert-warning">No participants_master resources registered yet.</div>
      <% } %>
    <% } else { %>
      <% var _tenantNameById = locals.tenantNameById || {}; %>
      <% list.items.forEach(function(p) { %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h5 class="mb-1">
                  <%= p.display_name %>
                  <% if (!p.is_active) { %><span class="badge bg-secondary-subtle text-secondary border ms-1">Inactive</span><% } %>
                </h5>
                <p class="text-muted small mb-2">
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><%= p.type %></span>
                  <span class="badge bg-light text-dark border"><%= _tenantNameById[p.tenant_id] || p.tenant_id %></span>
                </p>
                <% if (p.capabilities && p.capabilities.length > 0) { %>
                  <div class="mb-2 d-flex flex-wrap gap-1">
                    <% p.capabilities.forEach(function(c) { %>
                      <span class="badge bg-light text-dark border"><%= c %></span>
                    <% }) %>
                  </div>
                <% } %>
                <% if (p.competency && Object.keys(p.competency).length > 0) { %>
                  <p class="small text-muted mb-1">
                    <% Object.keys(p.competency).forEach(function(dim, i) { %>
                      <% if (i > 0) { %> &middot; <% } %>
                      <strong><%= dim %>:</strong> <%= p.competency[dim].join(', ') %>
                    <% }) %>
                  </p>
                <% } %>
                <% if (p.behaviour_context && p.behaviour_context.length > 0) { %>
                  <p class="small text-muted mb-0">
                    Behaviour Context:
                    <% p.behaviour_context.forEach(function(bc, i) { %>
                      <% if (i > 0) { %>, <% } %><span class="badge bg-light text-dark border"><%= bc.policy %></span>
                    <% }) %>
                  </p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
