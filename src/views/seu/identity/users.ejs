<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5" style="max-width: 1000px;">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <p class="text-muted small mb-1"><a href="/aisworg/seu/identity">&larr; Identity Management</a></p>
      <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-people me-2"></i>User Management</h2>
      <p class="text-muted small mb-0">Platform user accounts. Badge issuance is a separate step, from Badge Management.</p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/identity/users'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search email / name / role' }) %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <table class="table table-sm align-middle">
          <thead><tr>
            <th><%- sortLink('Email', 'email', list, _base) %></th>
            <th><%- sortLink('Name', 'name', list, _base) %></th>
            <th><%- sortLink('Legacy role', 'role', list, _base) %></th>
            <th>Active</th>
            <th>Badges</th>
          </tr></thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="5" class="text-muted small text-center py-3"><%= list.q ? 'No users match your search.' : 'No users.' %></td></tr>
            <% } %>
            <% list.items.forEach(function(u) { %>
              <tr>
                <td class="small"><%= u.email %></td>
                <td class="small"><%= u.name || '' %></td>
                <td><span class="badge bg-light text-dark border"><%= u.role %></span></td>
                <td><%= u.is_active ? 'Yes' : 'No' %></td>
                <td>
                  <% u.platformBadges.forEach(function(b) { %>
                    <span class="badge bg-secondary-subtle text-dark-emphasis me-1"><%= b %></span>
                  <% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="text-muted small mb-2">
          Creating an account here is separate from granting it any Platform-layer badge — do that from
          Badge Management afterward. The legacy <code>role</code> column is untouched by the badge model
          (design doc §5); new accounts default to <code>general</code>.
        </p>
        <form method="POST" action="/aisworg/seu/identity/users" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-auto"><label class="form-label small mb-1">Email</label><input name="email" type="email" class="form-control form-control-sm" required></div>
          <div class="col-auto"><label class="form-label small mb-1">Name</label><input name="name" class="form-control form-control-sm"></div>
          <div class="col-auto">
            <label class="form-label small mb-1">Type</label>
            <select name="type" id="new-user-type" class="form-select form-select-sm" required onchange="document.getElementById('new-user-tenant-wrap').style.display = this.value === 'Tenant' ? '' : 'none';">
              <option value="Platform">Platform</option>
              <option value="Tenant">Tenant</option>
            </select>
          </div>
          <div class="col-auto" id="new-user-tenant-wrap" style="display:none;">
            <label class="form-label small mb-1">Tenant</label>
            <select name="tenantId" class="form-select form-select-sm">
              <% tenants.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %> (<%= t.code %>)</option><% }) %>
            </select>
          </div>
          <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Create user</button></div>
        </form>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
