<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <p class="text-muted small mb-1"><a href="/aisworg/seu/identity">&larr; Identity Management</a></p>
      <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-people me-2"></i>User Management</h2>
      <p class="text-muted small mb-0">Platform user accounts. Badge issuance is a separate step, from Badge Management.</p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/identity/users'; %>
    <% const _tenantOptions = locals.tenantFilterOptions || []; %>
    <% const _activeTenant = locals.activeTenant || ''; %>
    <%# Owner: "the page should still use getIdentityDashboardView with a
        tenant filter. Default is All." — a <select>, not a button per
        tenant (a button row doesn't scale to a real tenant count); same
        auto-submit-on-change pattern telemetry/index.ejs's own SEU filter
        already uses. Still an in-memory filter over the one
        getIdentityDashboardView load below, same as before — this page
        stays decoupled from the separate tenant-admin User Management page
        (listUsersForTenant), which is not reused here. %>
    <form method="GET" action="<%= _base %>" class="d-flex align-items-center gap-2 mb-3">
      <label class="form-label small mb-0 text-muted">Tenant</label>
      <select name="tenant" class="form-select form-select-sm" style="max-width: 280px;" onchange="this.form.submit()">
        <option value="" <%= !_activeTenant ? 'selected' : '' %>>All tenants</option>
        <% _tenantOptions.forEach(function(t) { %>
          <option value="<%= t.id %>" <%= _activeTenant === t.id ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </form>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search email / name' }) %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <table class="table table-sm align-middle">
          <thead><tr>
            <th><%- sortLink('Email', 'email', list, _base) %></th>
            <th><%- sortLink('Name', 'name', list, _base) %></th>
            <th>Active</th>
            <th>Badges</th>
            <th>Actions</th>
          </tr></thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="5" class="text-muted small text-center py-3"><%= list.q ? 'No users match your search.' : 'No users.' %></td></tr>
            <% } %>
            <% list.items.forEach(function(u) { %>
              <tr>
                <td class="small"><%= u.email %></td>
                <td class="small"><%= u.name || '' %></td>
                <td><%= u.is_active ? 'Yes' : 'No' %></td>
                <td>
                  <%# badge_grants dropped (owner: "I want the table
                      dropped") — authorisedBadges (participants_master) is
                      the one real source now, root included. %>
                  <% u.authorisedBadges.forEach(function(b) { %>
                    <span class="badge bg-secondary-subtle text-dark-emphasis me-1"><%= b %></span>
                  <% }) %>
                </td>
                <td class="text-nowrap">
                  <%# Owner: "actions dropdown should be from ontology
                      authorised-role... dropdown is multi-select. Existing
                      grant should be in a selected state. so add or revoke
                      will work" — setAuthorisedRoles (core/identity.ts)
                      reconciles the unscoped (platform/tenant-wide)
                      authorised_role grants to exactly whatever's selected
                      on submit; a SEU-scoped grant (not shown here) is left
                      untouched. Active is the other half of the same form
                      (updatePlatformUser). Self-edit guard mirrors the
                      legacy /auth/users page: an admin can't deactivate or
                      change their own roles from here — enforced
                      server-side too, not just hidden here. %>
                  <% if (u.email === currentUserEmail) { %>
                    <span class="text-muted small">(you)</span>
                  <% } else { %>
                    <div class="mb-1">
                      <% if (u.authorisedRoles.length === 0) { %>
                        <span class="text-muted small">(none)</span>
                      <% } else { %>
                        <% u.authorisedRoles.forEach(function(r) { %>
                          <span class="badge bg-secondary-subtle text-dark-emphasis me-1"><%= r %></span>
                        <% }) %>
                      <% } %>
                    </div>
                    <form method="POST" action="/aisworg/seu/identity/users/<%= u.id %>/update" class="d-flex align-items-center gap-2">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="roles[]" class="form-select form-select-sm" multiple size="4" style="width: auto; min-width: 10rem;">
                        <% authorisedRoleCodes.forEach(function(code) { %>
                          <%# 'general' is the platform default and can't be revoked once held (owner) —
                              locked here so the UI can't even submit a deselect; setAuthorisedRoles
                              (core/identity.ts) enforces the same rule server-side regardless. %>
                          <option value="<%= code %>"
                            <%= u.authorisedRoles.includes(code) ? 'selected' : '' %>
                            <%= code === 'general' && u.authorisedRoles.includes(code) ? 'disabled' : '' %>>
                            <%= code %><%= code === 'general' && u.authorisedRoles.includes(code) ? ' (default)' : '' %>
                          </option>
                        <% }) %>
                      </select>
                      <div class="form-check form-switch mb-0" title="Active">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" <%= u.is_active ? 'checked' : '' %>>
                      </div>
                      <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="text-muted small mb-2">
          Creating an account here is separate from granting it any Platform-layer badge — do that from
          Badge Management afterward. Authorised roles here are standing, platform/tenant-wide grants
          (Ontology <code>authorised-role</code>); a SEU-scoped grant is managed elsewhere.
        </p>
        <%# Owner: "Type should be renamed to Tenant. The dropdown should have
            the tenants list. Include a authorised_role dropdown" — one
            dropdown of every real tenant (Platform's own reserved row
            included — picking it is how a Platform-type account gets
            created now, createPlatformUser derives `type` from it), plus the
            same authorised-role multi-select the per-row Actions form uses.
            Owner: "badge has to be empty" — nothing pre-selected here;
            authorised_role starts exactly as whatever's picked, empty by
            default. 'general' only becomes non-revocable (per-row Actions
            form) once it's actually held — this form doesn't grant it. %>
        <form method="POST" action="/aisworg/seu/identity/users" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-auto"><label class="form-label small mb-1">Email</label><input name="email" type="email" class="form-control form-control-sm" required></div>
          <div class="col-auto"><label class="form-label small mb-1">Name</label><input name="name" class="form-control form-control-sm"></div>
          <div class="col-auto">
            <label class="form-label small mb-1">Tenant</label>
            <select name="tenantId" class="form-select form-select-sm" required>
              <% tenants.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %> (<%= t.code %>)</option><% }) %>
            </select>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-1">Authorised roles</label>
            <select name="roles[]" class="form-select form-select-sm" multiple size="4" style="width: auto; min-width: 10rem;">
              <% authorisedRoleCodes.forEach(function(code) { %>
                <option value="<%= code %>"><%= code %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Create user</button></div>
        </form>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
