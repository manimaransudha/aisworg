<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <p class="text-muted small mb-1"><a href="/aisworg/seu/identity">&larr; Identity Management</a></p>
      <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-patch-check me-2"></i>Badge Management</h2>
      <p class="text-muted small mb-0">
        Noun &times; verb badges (<code>{noun}_{verb}</code>, e.g. <code>pack_define</code>) — standing grants on
        each identity's own <code>participants_master</code> row (<code>authorised_badges</code>), not
        <code>badge_grants</code> (owner: "badge_grants on the user management should be replaced with the new
        badges implementation"). Platform-wide only — a SEU-scoped grant is not shown or touchable here.
      </p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/identity/badges'; %>
    <% const _tenantOptions = locals.tenantFilterOptions || []; %>
    <% const _activeTenant = locals.activeTenant || ''; %>
    <%# Owner: "add a tenant filter similar to user management" — same
        <select> + auto-submit pattern as /identity/users. %>
    <form method="GET" action="<%= _base %>" class="d-flex align-items-center gap-2 mb-3">
      <label class="form-label small mb-0 text-muted">Tenant</label>
      <select name="tenant" class="form-select form-select-sm" style="max-width: 280px;" onchange="this.form.submit()">
        <option value="" <%= !_activeTenant ? 'selected' : '' %>>All tenants</option>
        <% _tenantOptions.forEach(function(t) { %>
          <option value="<%= t.id %>" <%= _activeTenant === t.id ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </form>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search email / name' }) %>
    <div class="section-card">
      <div class="section-header">Badges</div>
      <div class="card-body">
        <table class="table table-sm align-middle">
          <thead><tr>
            <th><%- sortLink('Email', 'email', list, _base) %></th>
            <th><%- sortLink('Name', 'name', list, _base) %></th>
            <th>Badges</th>
          </tr></thead>
          <tbody>
            <% if (list.total === 0) { %>
              <tr><td colspan="3" class="text-muted small text-center py-3"><%= list.q ? 'No users match your search.' : 'No users.' %></td></tr>
            <% } %>
            <% list.items.forEach(function(u) { %>
              <tr>
                <td class="small"><%= u.email %></td>
                <td class="small"><%= u.name || '' %></td>
                <td>
                  <% if (u.email === currentUserEmail) { %>
                    <span class="text-muted small">(you)</span>
                  <% } else { %>
                    <div class="badges-row">
                      <div class="mb-1 badge-pills">
                        <% if (u.authorisedBadges.length === 0) { %>
                          <span class="text-muted small no-badges-msg">(none)</span>
                        <% } %>
                        <% u.authorisedBadges.forEach(function(b) { %>
                          <span class="badge bg-secondary-subtle text-dark-emphasis me-1 badge-pill" data-value="<%= b %>">
                            <%= b %>
                            <span class="badge-pill-remove" role="button" aria-label="Remove <%= b %>">&times;</span>
                          </span>
                        <% }) %>
                      </div>
                      <form method="POST" action="/aisworg/seu/identity/badges/<%= u.id %>/update" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <select name="badges[]" class="badges-hidden-select d-none" multiple>
                          <% authorisedBadgeCodes.forEach(function(code) { %>
                            <option value="<%= code %>" <%= u.authorisedBadges.includes(code) ? 'selected' : '' %>><%= code %></option>
                          <% }) %>
                        </select>
                        <select class="form-select form-select-sm badge-add-select" style="width: auto; min-width: 12rem;">
                          <option value="">+ add badge&hellip;</option>
                          <% authorisedBadgeCodes.forEach(function(code) { %>
                            <option value="<%= code %>" <%= u.authorisedBadges.includes(code) ? 'hidden' : '' %>><%= code %></option>
                          <% }) %>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                      </form>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <style>
    .badge-pills { max-width: 220px; display: flex; flex-wrap: wrap; gap: 2px; }
    .badge-pill-remove { margin-left: 4px; cursor: pointer; font-weight: 600; }
  </style>
  <script>
    (function () {
      var table = document.querySelector('table');
      if (!table) return;

      table.addEventListener('change', function (e) {
        if (!e.target.matches('.badge-add-select')) return;
        var sel = e.target;
        var code = sel.value;
        if (!code) return;
        var row = sel.closest('.badges-row');
        var hidden = row.querySelector('.badges-hidden-select');
        var opt = hidden.querySelector('option[value="' + CSS.escape(code) + '"]');
        if (opt) opt.selected = true;
        var addOpt = sel.querySelector('option[value="' + CSS.escape(code) + '"]');
        if (addOpt) addOpt.hidden = true;
        sel.value = '';

        var pills = row.querySelector('.badge-pills');
        var noneMsg = pills.querySelector('.no-badges-msg');
        if (noneMsg) noneMsg.remove();
        var pill = document.createElement('span');
        pill.className = 'badge bg-secondary-subtle text-dark-emphasis me-1 badge-pill';
        pill.dataset.value = code;
        pill.innerHTML = code + ' <span class="badge-pill-remove" role="button" aria-label="Remove ' + code + '">&times;</span>';
        pills.appendChild(pill);
      });

      table.addEventListener('click', function (e) {
        if (!e.target.matches('.badge-pill-remove')) return;
        var pill = e.target.closest('.badge-pill');
        var row = pill.closest('.badges-row');
        var code = pill.dataset.value;
        var hidden = row.querySelector('.badges-hidden-select');
        var opt = hidden.querySelector('option[value="' + CSS.escape(code) + '"]');
        if (opt) opt.selected = false;
        var addSel = row.querySelector('.badge-add-select');
        var addOpt = addSel.querySelector('option[value="' + CSS.escape(code) + '"]');
        if (addOpt) addOpt.hidden = false;
        pill.remove();
        var pills = row.querySelector('.badge-pills');
        if (!pills.querySelector('.badge-pill')) {
          var span = document.createElement('span');
          span.className = 'text-muted small no-badges-msg';
          span.textContent = '(none)';
          pills.appendChild(span);
        }
      });
    })();
  </script>

  <%- include('../../partials/footer') %>
</body>
</html>
