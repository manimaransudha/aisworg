<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/helpers') %>
  <header><%- include('../../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="mb-4">
      <h2 class="h3 mb-1 text-dark fw-bold"><i class="bi bi-database-gear me-2"></i>Data Migrations</h2>
      <p class="text-muted small mb-0">
        Baseline/reference rows that used to be created only by a one-off migration <code>INSERT</code>.
        Running this stamps <code>authored_by</code>/<code>author_badge</code> with this session's own
        root <code>participants_master</code> identity, instead of leaving them for a migration to set.
      </p>
    </div>

    <% const _base = locals.listBasePath || '/aisworg/seu/data-migrations'; %>
    <%- include('../../partials/listControls', { list: list, listBasePath: _base, searchPlaceholder: 'Search target' }) %>

    <form method="POST" action="/aisworg/seu/data-migrations/run">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <table class="table table-sm align-middle mb-0">
            <thead><tr>
              <th style="width:2rem;"><input type="checkbox" class="form-check-input" id="_selectAllTargets"></th>
              <th><%- sortLink('Target', 'target', list, _base) %></th>
              <th><%- sortLink('Table(s)', 'tables', list, _base) %></th>
            </tr></thead>
            <tbody>
              <% list.items.forEach(function(t) { %>
                <tr>
                  <td><input type="checkbox" class="form-check-input _targetCheckbox" name="codes" value="<%= t.code %>"></td>
                  <td><%= t.label %></td>
                  <td><% t.tables.forEach(function(tbl) { %><span class="badge bg-light text-dark border me-1 font-monospace"><%= tbl %></span><% }) %></td>
                </tr>
              <% }) %>
              <% if (list.total === 0) { %>
                <tr><td colspan="3" class="text-muted small text-center py-3"><%= list.q ? 'No targets match your search.' : 'No data migration targets.' %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <button type="submit" class="btn btn-primary"><i class="bi bi-play-fill me-1"></i>Run selected (all, if none checked)</button>
    </form>

    <script>
      (function () {
        var selectAll = document.getElementById('_selectAllTargets');
        var boxes = document.querySelectorAll('._targetCheckbox');
        if (!selectAll) return;
        selectAll.addEventListener('change', function () {
          boxes.forEach(function (b) { b.checked = selectAll.checked; });
        });
      })();
    </script>
  </main>

  <%- include('../../partials/footer') %>
</body>
</html>
