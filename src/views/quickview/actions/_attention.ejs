<%#
  The "attention" action modal of an engagement in My Work. Opened from the Actions of a Deliverable row of the Deliverables tab.
  Locals: d (the engagement detail), mid (the modal id of an action), relIds, urlOf (the form URLs), csrfToken, and the option lists the form needs.
%>
        <div class="modal fade" id="<%= mid('attention') %>" tabindex="-1" aria-hidden="true" data-pm>
          <div class="modal-dialog"><form class="modal-content" method="POST" action="<%= urlOf.attentionItem(d.seu.id) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="deliverableId" data-pm-id>
            <div class="modal-header"><h5 class="modal-title mb-0">Raise Attention Item</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body small">
              <div class="mb-2"><label class="form-label text-muted mb-1">Deliverable</label><input type="text" class="form-control form-control-sm" data-pm-name readonly></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Action Required</label>
                <select name="category" class="form-select form-select-sm" required>
                  <% (locals.attentionCategoryOptions || []).forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }) %>
                </select></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Title</label><input type="text" name="title" class="form-control form-control-sm" maxlength="100" required></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Description</label><textarea name="description" class="form-control form-control-sm" rows="3"></textarea></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Priority</label>
                <select name="priority" class="form-select form-select-sm">
                  <% (locals.attentionPriorityOptions || []).forEach(function (pr) { %><option value="<%= pr %>" <%= pr === 'Medium' ? 'selected' : '' %>><%= pr %></option><% }) %>
                </select></div>
              <div class="form-check"><input class="form-check-input" type="checkbox" name="blocksProgress" id="<%= mid('attention') %>-blocks"><label class="form-check-label" for="<%= mid('attention') %>-blocks">This blocks the progress of the Deliverable</label></div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-sm btn-primary">Raise Attention Item</button></div>
          </form></div>
        </div>
