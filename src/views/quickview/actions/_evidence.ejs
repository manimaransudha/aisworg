<%#
  The "evidence" action modal of an engagement in My Work. Opened from the Actions of a Deliverable row of the Deliverables tab.
  Locals: d (the engagement detail), mid (the modal id of an action), relIds, urlOf (the form URLs), csrfToken, and the option lists the form needs.
%>
        <div class="modal fade" id="<%= mid('evidence') %>" tabindex="-1" aria-hidden="true" data-pm>
          <div class="modal-dialog"><form class="modal-content" method="POST" action="<%= urlOf.evidence(d.seu.id) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="deliverableId" data-pm-id>
            <div class="modal-header"><h5 class="modal-title mb-0">Provide Evidence</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body small">
              <div class="mb-2"><label class="form-label text-muted mb-1">Deliverable</label><input type="text" class="form-control form-control-sm" data-pm-name readonly></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Category</label>
                <select name="category" class="form-select form-select-sm">
                  <% ['Analytical Evidence','Validation Evidence','Operational Evidence','Review Evidence','Decision Evidence','External Evidence'].forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }) %>
                </select></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Title</label><input type="text" name="title" class="form-control form-control-sm" required></div>
              <div class="mb-2"><label class="form-label text-muted mb-1">Source</label><input type="text" name="source" class="form-control form-control-sm" placeholder="optional"></div>
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-sm btn-primary">Provide Evidence</button></div>
          </form></div>
        </div>
