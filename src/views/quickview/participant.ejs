<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <%# CR-103 — Participant home page. Uses the same CR-083 section-card/
       section-header/state-badge primitives as seu/seus/detail.ejs (the page
       this deliberately looks similar to, minus Capability Fulfilment).
       CR-109 Build Plan §7 added the one write path this page needs: a
       "Report Result" form on each of the Participant's own Dispatched Work
       Items (Command / Work Item tab), posting to completeMyWorkItem. %>
  <style>
    .edge-note { font-size: 0.75rem; color: #64748b; }
  </style>
</head>
<body>
  <header><%- include('../partials/navbar') %></header>

  <main class="container py-5">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'error' ? 'exclamation-triangle' : 'check-circle' %> me-2"></i><%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <h2 class="h4 text-dark fw-bold mb-4">My Work</h2>

    <% var master = participantHome.master; %>
    <% if (!master) { %>
      <div class="section-card">
        <div class="p-3 text-muted small">No Participant identity is registered for your account yet.</div>
      </div>
    <% } else { %>
      <div class="section-card mb-4">
        <div class="section-header">My Participant Record</div>
        <div class="p-3">
          <dl class="row mb-0 small">
            <dt class="col-sm-2">Name</dt><dd class="col-sm-10"><%= master.display_name %></dd>
            <dt class="col-sm-2">Identifier</dt><dd class="col-sm-10 font-monospace"><%= master.id %></dd>
            <dt class="col-sm-2">Type</dt><dd class="col-sm-10"><%= master.type %></dd>
            <dt class="col-sm-2">Status</dt><dd class="col-sm-10"><span class="state-badge state-<%= master.is_active ? 'Active' : 'Inactive' %>"><%= master.is_active ? 'Active' : 'Inactive' %></span></dd>
          </dl>
        </div>
      </div>

      <h3 class="h5 text-dark fw-bold mb-3">My SEU Assignments</h3>
      <% if (participantHome.engagements.length === 0) { %>
        <div class="section-card">
          <div class="p-3 text-muted small">No SEU engagements yet.</div>
        </div>
      <% } %>

      <% participantHome.engagements.forEach(function(eng, idx) { %>
        <% var d = eng.detail; var prefix = 'p' + idx; %>
        <div class="section-card mb-4">
          <div class="d-flex justify-content-between align-items-start p-3 border-bottom">
            <div>
              <p class="text-muted small mb-1 font-monospace"><%= d.seu.id %></p>
              <h4 class="h6 text-dark fw-bold mb-0"><%= d.objectiveStatement %></h4>
            </div>
            <div class="text-end">
              <div><span class="state-badge state-<%= d.seu.lifecycle_state %>"><%= d.seu.lifecycle_state %></span></div>
              <div class="mt-1 small text-muted">My status: <span class="state-badge state-<%= eng.participant.state %>"><%= eng.participant.state %></span></div>
            </div>
          </div>

          <%
            var tabs = [
              { key: 'deliverables', label: 'Deliverables', sub: d.deliverables.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.deliverables.length + '</span>' : '' },
              { key: 'obligations', label: 'Obligations', sub: d.obligations.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.obligations.length + '</span>' : '' },
              { key: 'evidence', label: 'Evidence', sub: d.evidence.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.evidence.length + '</span>' : '' },
              { key: 'decisions', label: 'Decisions', sub: d.decisions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.decisions.length + '</span>' : '' },
              { key: 'knowledge', label: 'Knowledge', sub: d.knowledgeItems.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.knowledgeItems.length + '</span>' : '' },
              { key: 'commands', label: 'Command / Work Item', sub: d.commands.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.commands.length + '</span>' : '' },
              { key: 'external-interactions', label: 'External Interactions', sub: d.externalInteractions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.externalInteractions.length + '</span>' : '' },
              { key: 'events', label: 'Events', sub: d.events.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.events.length + '</span>' : '' },
            ];
          %>

          <div class="d-flex flex-column flex-md-row gap-4 align-items-start p-3">
            <%- include('../partials/verticalTabs', { tabs: tabs, paneMode: true, paneIdPrefix: prefix, activePaneIndex: 0 }) %>

            <div class="tab-content flex-grow-1" style="min-width: 0;">

              <div class="tab-pane fade show active" id="<%= prefix %>-deliverables" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>State</th></tr></thead>
                    <tbody>
                      <% if (d.deliverables.length === 0) { %><tr><td colspan="2" class="text-muted small">Nothing assigned to you yet.</td></tr><% } %>
                      <% d.deliverables.forEach(function(item) { %>
                        <tr>
                          <td class="small"><%= item.name %><br><span class="text-muted" style="font-size:0.72rem;"><% if (item.category) { %><%= item.category %> &middot; <% } %>Acquisition Scope: <%= item.acquisitionScope %></span></td>
                          <td><span class="state-badge state-<%= item.lifecycleState.replace(/\s+/g, '-') %>"><%= item.lifecycleState %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-obligations" role="tabpanel">
                <%# Owner: "Remove the add form on the SEU detail page. The
                    Participant should have an Obligation form. The
                    obligation has to be on the SEU that the participant is
                    assigned to, on a deliverable within the SEU." —
                    Deliverable options are this engagement's own d.deliverables
                    (already scoped to this Participant's own assignments by
                    getParticipantHomeView), never the full SEU list.
                    Governing Condition is free text here (stored on the
                    existing completionCriteria column) — not the structured
                    Pack-Definition rule. No evidence field, no origin label
                    (owner, final). %>
                <form method="POST" action="/aisworg/quickview/seus/<%= d.seu.id %>/obligations" class="d-flex flex-wrap gap-1 align-items-center mb-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="deliverableId" class="form-select form-select-sm" style="width:auto;" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% d.deliverables.forEach(function(item) { %>
                      <option value="<%= item.id %>"><%= item.name %></option>
                    <% }) %>
                  </select>
                  <select name="category" class="form-select form-select-sm" style="width:auto;">
                    <% (locals.obligationCategoryOptions || []).forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                  <input type="text" name="title" class="form-control form-control-sm" style="width:auto;" placeholder="Title" required>
                  <input type="text" name="description" class="form-control form-control-sm" style="width:auto;" placeholder="Description (optional)">
                  <select name="severity" class="form-select form-select-sm" style="width:auto;">
                    <% (locals.obligationSeverityOptions || []).forEach(function(sev) { %>
                      <option value="<%= sev %>" <%= sev === 'Medium' ? 'selected' : '' %>><%= sev %></option>
                    <% }) %>
                  </select>
                  <input type="text" name="completionCriteria" class="form-control form-control-sm" style="width:auto;" placeholder="Governing Condition (optional)">
                  <button type="submit" class="btn btn-sm btn-primary">Raise Obligation</button>
                </form>
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Severity</th><th>Status</th><th>Origin</th><th>Assigned</th></tr></thead>
                    <tbody>
                      <% if (d.obligations.length === 0) { %><tr><td colspan="6" class="text-muted small">None.</td></tr><% } %>
                      <% d.obligations.forEach(function(o) { %>
                        <tr>
                          <td class="small"><%= o.deliverableName %></td>
                          <td class="small"><%= o.obligation.title %></td>
                          <td class="small"><%= o.obligation.category %> &middot; <%= o.obligation.severity %></td>
                          <td><span class="state-badge state-<%= o.obligation.status.replace(/\s+/g, '-') %>"><%= o.obligation.status %></span></td>
                          <td class="small text-muted"><%= o.obligation.originating_entity_type || '—' %></td>
                          <td class="small text-muted"><%= o.obligation.assigned_entity_type || 'Unassigned' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-evidence" role="tabpanel">
                <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/evidence" class="d-flex flex-wrap gap-1 align-items-center mb-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="deliverableId" class="form-select form-select-sm" style="width:auto;" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% d.deliverables.forEach(function(item) { %>
                      <option value="<%= item.id %>"><%= item.name %></option>
                    <% }) %>
                  </select>
                  <select name="category" class="form-select form-select-sm" style="width:auto;">
                    <% ['Analytical Evidence','Validation Evidence','Operational Evidence','Review Evidence','Decision Evidence','External Evidence'].forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                  <input type="text" name="title" class="form-control form-control-sm" style="width:auto;" placeholder="Title" required>
                  <input type="text" name="source" class="form-control form-control-sm" style="width:auto;" placeholder="Source (optional)">
                  <button type="submit" class="btn btn-sm btn-primary">Collect Evidence</button>
                </form>
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Supports</th><th>Title</th><th>Category / Confidence</th><th>Status</th><th>Transition</th></tr></thead>
                    <tbody>
                      <% if (d.evidence.length === 0) { %><tr><td colspan="5" class="text-muted small">None.</td></tr><% } %>
                      <% d.evidence.forEach(function(e) { %>
                        <tr>
                          <td class="small"><%= e.relatedObjectLabels.join(', ') || '—' %></td>
                          <td class="small"><%= e.evidence.title %></td>
                          <td class="small"><%= e.evidence.category %> &middot; <%= e.evidence.confidence_level || 'unassessed' %></td>
                          <td><span class="state-badge state-<%= e.evidence.status %>"><%= e.evidence.status %></span></td>
                          <td>
                            <% if (e.possibleNextStates.length === 1) { %>
                              <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/evidence/<%= e.evidence.id %>/transition" class="mb-0">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="targetState" value="<%= e.possibleNextStates[0] %>">
                                <button type="submit" class="btn btn-sm btn-primary"><%= e.possibleNextStates[0] %></button>
                              </form>
                            <% } else if (e.possibleNextStates.length > 1) { %>
                              <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/evidence/<%= e.evidence.id %>/transition" class="d-flex align-items-center gap-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <select name="targetState" class="form-select form-select-sm" style="width:auto;">
                                  <% e.possibleNextStates.forEach(function(s) { %>
                                    <option value="<%= s %>"><%= s %></option>
                                  <% }) %>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                              </form>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-decisions" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.decisions.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.decisions.forEach(function(dec) { %>
                        <tr>
                          <td class="small"><%= dec.relatedObjectLabels.join(', ') || '—' %></td>
                          <td class="small"><%= dec.decision.title %></td>
                          <td class="small"><%= dec.decision.category %></td>
                          <td><span class="state-badge state-<%= dec.decision.status %>"><%= dec.decision.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-knowledge" role="tabpanel">
                <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/knowledge" class="d-flex flex-wrap gap-1 align-items-center mb-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="deliverableId" class="form-select form-select-sm" style="width:auto;" required>
                    <option value="" disabled selected>Deliverable&hellip;</option>
                    <% d.deliverables.forEach(function(item) { %>
                      <option value="<%= item.id %>"><%= item.name %></option>
                    <% }) %>
                  </select>
                  <select name="evidenceId" class="form-select form-select-sm" style="width:auto;">
                    <option value="">(no supporting Evidence)</option>
                    <% d.evidence.forEach(function(e) { %>
                      <option value="<%= e.evidence.id %>"><%= e.evidence.title %></option>
                    <% }) %>
                  </select>
                  <select name="category" class="form-select form-select-sm" style="width:auto;">
                    <% ['Architectural Knowledge','Domain Knowledge','Technical Knowledge','Operational Knowledge','Governance Knowledge','Process Knowledge'].forEach(function(cat) { %>
                      <option value="<%= cat %>"><%= cat %></option>
                    <% }) %>
                  </select>
                  <input type="text" name="title" class="form-control form-control-sm" style="width:auto;" placeholder="Title" required>
                  <select name="acquisitionScope" class="form-select form-select-sm" style="width:auto;">
                    <% ['SEU','Capability','Enterprise','Platform'].forEach(function(s) { %>
                      <option value="<%= s %>"><%= s %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-sm btn-primary">Observe Knowledge</button>
                </form>
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Scope</th><th>Status</th><th>Transition</th><th>Promote Scope</th></tr></thead>
                    <tbody>
                      <% if (d.knowledgeItems.length === 0) { %><tr><td colspan="6" class="text-muted small">None.</td></tr><% } %>
                      <% d.knowledgeItems.forEach(function(k) { %>
                        <tr>
                          <td class="small"><%= k.deliverableName %></td>
                          <td class="small"><%= k.knowledgeItem.title %></td>
                          <td class="small"><%= k.knowledgeItem.category %> &middot; <%= k.knowledgeItem.acquisition_scope %></td>
                          <td><span class="state-badge state-<%= k.knowledgeItem.status %>"><%= k.knowledgeItem.status %></span></td>
                          <td>
                            <% if (k.possibleNextStates.length === 1) { %>
                              <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/transition" class="mb-0">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="targetState" value="<%= k.possibleNextStates[0] %>">
                                <button type="submit" class="btn btn-sm btn-primary"><%= k.possibleNextStates[0] %></button>
                              </form>
                            <% } else if (k.possibleNextStates.length > 1) { %>
                              <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/transition" class="d-flex align-items-center gap-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <select name="targetState" class="form-select form-select-sm" style="width:auto;">
                                  <% k.possibleNextStates.forEach(function(s) { %>
                                    <option value="<%= s %>"><%= s %></option>
                                  <% }) %>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Transition</button>
                              </form>
                            <% } %>
                          </td>
                          <td>
                            <% if (k.possibleNextScopes.length > 0) { %>
                              <form method="POST" action="/aisworg/seu/seus/<%= d.seu.id %>/knowledge/<%= k.knowledgeItem.id %>/promote-scope" class="d-flex align-items-center gap-1">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <select name="targetScope" class="form-select form-select-sm" style="width:auto;">
                                  <% k.possibleNextScopes.forEach(function(s) { %>
                                    <option value="<%= s %>"><%= s %></option>
                                  <% }) %>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Promote</button>
                              </form>
                            <% } else { %>
                              <span class="text-muted small"><%= k.knowledgeItem.acquisition_scope === 'Platform' ? 'already Platform' : '—' %></span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-commands" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Command</th><th>Transition</th><th>Status</th><th>My Work Item</th></tr></thead>
                    <tbody>
                      <% if (d.commands.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.commands.forEach(function(cmd) { %>
                        <tr>
                          <td class="small"><%= cmd.entityLabel %><br><span class="text-muted" style="font-size:0.72rem;"><%= cmd.commandType %></span></td>
                          <td class="small"><%= cmd.fromState %> &rarr; <%= cmd.toState %></td>
                          <td><span class="state-badge state-<%= cmd.status %>"><%= cmd.status %></span></td>
                          <td class="small">
                            <% cmd.workItems.forEach(function(wi) { %>
                              <div class="mb-2">
                                <span class="state-badge state-<%= wi.status %>"><%= wi.status %></span><% if (wi.dispatchStrategy) { %> <span class="text-muted" style="font-size:0.7rem;">(<%= wi.dispatchStrategy %>)</span><% } %>
                                <% if (wi.executionContext) { %>
                                  <% var ec = wi.executionContext; %>
                                  <details style="font-size:0.72rem;" open>
                                    <summary class="text-muted">Instructions</summary>
                                    <div class="ps-2">
                                      <div><strong>Objective:</strong> <%= ec.engineeringObjective %></div>
                                      <% if (ec.service) { %><div><strong>Service:</strong> <%= ec.service.name %></div><% } %>
                                      <div><strong>Input location:</strong> <%= ec.inputLocation || '—' %></div>
                                      <div><strong>Output location:</strong> <%= ec.outputLocation || '—' %></div>
                                      <div><strong>Decisions:</strong> <%= ec.relevantDecisions.map(function(d2){ return d2.title + ' (' + d2.status + ')'; }).join(', ') || 'none' %></div>
                                      <div><strong>Evidence:</strong> <%= ec.supportingEvidence.map(function(e){ return e.title + ' (' + e.status + ')'; }).join(', ') || 'none' %></div>
                                      <div><strong>Knowledge:</strong> <%= ec.relevantKnowledge.map(function(k){ return k.title; }).join(', ') || 'none' %></div>
                                      <div><strong>Constraints:</strong> <%= ec.governingPolicies.map(function(p){ return p.name; }).join(', ') || 'none' %></div>
                                      <div><strong>Active Obligations:</strong> <%= ec.activeObligations.map(function(o){ return o.title + ' (' + o.status + ')'; }).join(', ') || 'none' %></div>
                                      <% if ((ec.applicableChecklists || []).length > 0) { %><div><strong>Checklist:</strong> <%= ec.applicableChecklists.map(function(c){ return c.statement; }).join('; ') %></div><% } %>
                                      <% if ((ec.engineeringCapital || []).length > 0) { %><div><strong>Engineering Capital:</strong> <%= ec.engineeringCapital.map(function(c){ return c.type ? (c.type + (c.url ? ': ' + c.url : '')) : (c.url || ''); }).join(', ') %></div><% } %>
                                      <% var pc = ec.profileConfiguration || {}; var pcEntries = Object.keys(pc).filter(function(k){ return pc[k] !== undefined && pc[k] !== null && pc[k] !== ''; }); %>
                                      <% if (pcEntries.length > 0) { %><div><strong>Profile:</strong> <%= pcEntries.map(function(k){ var v = pc[k]; return k + ': ' + (Array.isArray(v) ? v.join('/') : (typeof v === 'object' ? JSON.stringify(v) : v)); }).join(', ') %></div><% } %>
                                    </div>
                                  </details>
                                <% } %>
                                <% if (wi.status === 'Dispatched') { %>
                                  <form method="POST" action="/aisworg/quickview/work-items/<%= wi.id %>/complete" class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                    <select name="outcome" class="form-select form-select-sm" style="width:auto;">
                                      <option value="done">Done</option>
                                      <option value="failed">Failed</option>
                                      <option value="blocked">Blocked</option>
                                    </select>
                                    <input type="text" name="reference" class="form-control form-control-sm" style="width:auto;" placeholder="reference (optional)">
                                    <button type="submit" class="btn btn-sm btn-primary">Report Result</button>
                                  </form>
                                <% } %>
                              </div>
                            <% }) %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-external-interactions" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Type / Direction</th><th>Target System</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.externalInteractions.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.externalInteractions.forEach(function(ei) { %>
                        <tr>
                          <td class="small"><%= ei.deliverableName || '—' %></td>
                          <td class="small"><%= ei.interaction.interaction_type %> &middot; <%= ei.interaction.direction %></td>
                          <td class="small"><%= ei.interaction.target_system %></td>
                          <td><span class="state-badge state-<%= ei.interaction.status.replace(/\s+/g, '-') %>"><%= ei.interaction.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-events" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Type</th><th>Object</th><th>When</th></tr></thead>
                    <tbody>
                      <% if (d.events.length === 0) { %><tr><td colspan="3" class="text-muted small">None.</td></tr><% } %>
                      <% d.events.forEach(function(e) { %>
                        <tr>
                          <td class="small"><code><%= e.event_type %></code></td>
                          <td class="small text-muted"><%= e.originating_object_type %></td>
                          <td class="small text-muted"><%= new Date(e.occurred_at).toLocaleString() %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
