<%#
  The participant's own "My Work" content, shared by the participant home (/aisworg/quickview) and the Demo participant viewer.
  actionBase is empty on the participant home, where every form posts to its usual route as the logged-in user.
  In the Demo viewer actionBase is the viewer's path for the chosen participant, and every form posts to the viewer's routes.
%>
<%
  var _ab = locals.actionBase || '';
  var urlOf = {
    attentionItem: function (seuId) { return _ab ? _ab + '/seus/' + seuId + '/attention-items' : '/aisworg/quickview/seus/' + seuId + '/attention-items'; },
    decision: function (seuId) { return (_ab ? _ab + '/seus/' : '/aisworg/seu/seus/') + seuId + '/decisions'; },
    reportStatus: function (seuId) { return _ab ? _ab + '/seus/' + seuId + '/report-status' : '/aisworg/quickview/seus/' + seuId + '/report-status'; },
    evidence: function (seuId) { return (_ab ? _ab + '/seus/' : '/aisworg/seu/seus/') + seuId + '/evidence'; },
    knowledge: function (seuId) { return (_ab ? _ab + '/seus/' : '/aisworg/seu/seus/') + seuId + '/knowledge'; },
  };
%>
    <% var master = participantHome.master; %>
    <% if (!master) { %>
      <div class="section-card">
        <div class="p-3 text-muted small">No Participant identity is registered for your account yet.</div>
      </div>
    <% } else { %>
      <div class="section-card mb-4">
        <div class="section-header">My Participant Record</div>
        <div class="p-3">
          <dl class="row mb-0 small">
            <dt class="col-sm-2">Name</dt><dd class="col-sm-10"><%= master.display_name %></dd>
            <dt class="col-sm-2">Identifier</dt><dd class="col-sm-10 font-monospace"><%= master.id %></dd>
            <dt class="col-sm-2">Type</dt><dd class="col-sm-10"><%= master.type %></dd>
            <dt class="col-sm-2">Status</dt><dd class="col-sm-10"><span class="state-badge state-<%= master.is_active ? 'Active' : 'Inactive' %>"><%= master.is_active ? 'Active' : 'Inactive' %></span></dd>
          </dl>
        </div>
      </div>

      <h3 class="h5 text-dark fw-bold mb-3">My SEU Assignments</h3>
      <% if (participantHome.engagements.length === 0) { %>
        <div class="section-card">
          <div class="p-3 text-muted small">No SEU engagements yet.</div>
        </div>
  
    <% } %>

      <% participantHome.engagements.forEach(function(eng, idx) { %>
        <% var d = eng.detail; var prefix = 'p' + idx; %>
        <div class="section-card mb-4">
          <div class="d-flex justify-content-between align-items-start p-3 border-bottom">
            <div>
              <p class="text-muted small mb-1 font-monospace"><%= d.seu.id %></p>
              <h4 class="h6 text-dark fw-bold mb-0"><%= d.objectiveStatement %></h4>
            </div>
            <div class="text-end">
              <div><span class="state-badge state-<%= d.seu.lifecycle_state %>"><%= d.seu.lifecycle_state %></span></div>
              <div class="mt-1 small text-muted">My status: <span class="state-badge state-<%= eng.participant.state %>"><%= eng.participant.state %></span></div>
            </div>
          </div>

          <%
            var tabs = [
              { key: 'deliverables', label: 'Deliverables', sub: d.deliverables.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.deliverables.length + '</span>' : '' },
              { key: 'obligations', label: 'Obligations', sub: d.obligations.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.obligations.length + '</span>' : '' },
              { key: 'attention-items', label: 'Attention Items', sub: d.attentionItems.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.attentionItems.length + '</span>' : '' },
              { key: 'evidence', label: 'Evidence', sub: d.evidence.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.evidence.length + '</span>' : '' },
              { key: 'decisions', label: 'Decisions', sub: d.decisions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.decisions.length + '</span>' : '' },
              { key: 'knowledge', label: 'Knowledge', sub: d.knowledgeItems.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.knowledgeItems.length + '</span>' : '' },
              { key: 'commands', label: 'Command / Work Item', sub: d.commands.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.commands.length + '</span>' : '' },
              { key: 'external-interactions', label: 'External Interactions', sub: d.externalInteractions.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.externalInteractions.length + '</span>' : '' },
              { key: 'events', label: 'Events', sub: d.events.length ? '<span class="badge bg-secondary-subtle text-secondary">' + d.events.length + '</span>' : '' },
            ];
          %>

          <div class="d-flex flex-column flex-md-row gap-4 align-items-start p-3">
            <%- include('../partials/verticalTabs', { tabs: tabs, paneMode: true, paneIdPrefix: prefix, activePaneIndex: 0 }) %>

            <div class="tab-content flex-grow-1" style="min-width: 0;">

              <div class="tab-pane fade show active" id="<%= prefix %>-deliverables" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <% var viaAdapter = master.adapter != null; %>
                    <thead class="table-light"><tr><th>Deliverable</th><th>State</th><% if (!viaAdapter) { %><th>Actions</th><% } %></tr></thead>
                    <%
                      // What the adapter driven Participant produced, found by the id of the object each event came from.
                      var titleOf = {};
                      var descOf = {};
                      // A Knowledge event names no Deliverable in its payload, so the Knowledge row gives it.
                      var deliverableOfKnowledge = {};
                      d.knowledgeItems.forEach(function(x) { deliverableOfKnowledge[x.knowledgeItem.id] = x.knowledgeItem.deliverable_id; });
                      d.evidence.forEach(function(x) { titleOf[x.evidence.id] = x.evidence.title; descOf[x.evidence.id] = x.evidence.description; });
                      d.knowledgeItems.forEach(function(x) { titleOf[x.knowledgeItem.id] = x.knowledgeItem.title; });
                      d.decisions.forEach(function(x) { titleOf[x.decision.id] = x.decision.title; });
                      d.attentionItems.forEach(function(x) { titleOf[x.attentionItem.id] = x.attentionItem.title; });
                    %>
                    <tbody>
                      <% if (d.deliverables.length === 0) { %><tr><td colspan="<%= viaAdapter ? 2 : 3 %>" class="text-muted small">Nothing assigned to you yet.</td></tr><% } %>
                      <% d.deliverables.forEach(function(item) { %>
                        <tr>
                          <td class="small"><%= item.name %><br><span class="text-muted" style="font-size:0.72rem;"><% if (item.category) { %><%= item.category %> &middot; <% } %>Acquisition Scope: <%= item.acquisitionScope %></span></td>
                          <td><span class="state-badge state-<%= item.lifecycleState.replace(/\s+/g, '-') %>"><%= item.lifecycleState %></span></td>
                          <% if (!viaAdapter) { %>
                          <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#<%= prefix %>-actions-<%= item.id %>" aria-expanded="false">Actions</button>
                            <div class="collapse mt-1" id="<%= prefix %>-actions-<%= item.id %>">
                              <div class="d-flex flex-wrap gap-1">
                                <% [['attention', 'Raise Attention Item'], ['knowledge', 'Create Knowledge'], ['decision', 'Create Decision'], ['evidence', 'Provide Evidence'], ['status', 'Report Status']].forEach(function(a) { %>
                                  <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#<%= prefix %>-modal-<%= a[0] %>" data-deliverable-id="<%= item.id %>" data-deliverable-name="<%= item.name %>"><%= a[1] %></button>
                                <% }) %>
                              </div>
                            </div>
                          </td>
                          <% } %>
                        </tr>
                        <% if (viaAdapter) { %>
                          <% var done = d.actedEvents.filter(function(ev) { return ev.originating_object_id === item.id || deliverableOfKnowledge[ev.originating_object_id] === item.id || (ev.payload && ev.payload.relatedObjectId === item.id); }).reverse(); %>
                          <tr>
                            <td colspan="2" class="small bg-light">
                              <% if (done.length === 0) { %><div class="text-muted">Nothing recorded yet.</div><% } %>
                              <% done.forEach(function(ev) { %>
                                <% var what = ev.event_type.replace(/([a-z])([A-Z])/g, '$1 $2'); var title = titleOf[ev.originating_object_id]; var cat = ev.payload && ev.payload.category; var said = descOf[ev.originating_object_id]; %>
                                <% if (said) { %><div class="border-start border-3 ps-2 my-2" style="white-space: pre-wrap;"><%= said %></div><% } %>
                                <div><span class="text-muted" style="font-size:0.72rem;"><%= new Date(ev.occurred_at).toLocaleString() %></span> <%= what %><% if (title) { %>: &ldquo;<%= title %>&rdquo;<% } %><% if (cat) { %> <span class="text-muted">(<%= cat %>)</span><% } %>.</div>
                              <% }) %>
                            </td>
                          </tr>
                        <% } %>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-obligations" role="tabpanel">
                <p class="small text-muted mb-2">Obligations on your Deliverables are shown here. A Participant raises an Attention Item, not an Obligation.</p>
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Severity</th><th>Status</th><th>Origin</th><th>Assigned</th></tr></thead>
                    <tbody>
                      <% if (d.obligations.length === 0) { %><tr><td colspan="6" class="text-muted small">None.</td></tr><% } %>
                      <% d.obligations.forEach(function(o) { %>
                        <tr>
                          <td class="small"><%= o.deliverableName %></td>
                          <td class="small"><%= o.obligation.title %></td>
                          <td class="small"><%= o.obligation.category %> &middot; <%= o.obligation.severity %></td>
                          <td><span class="state-badge state-<%= o.obligation.status.replace(/\s+/g, '-') %>"><%= o.obligation.status %></span></td>
                          <td class="small text-muted"><%= o.obligation.originating_entity_type || '—' %></td>
                          <td class="small text-muted"><%= o.obligation.assigned_entity_type || 'Unassigned' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-attention-items" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Related to</th><th>Title</th><th>Category / Priority</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.attentionItems.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.attentionItems.forEach(function(a) {
                           var rel = d.deliverables.find(function(x) { return x.id === a.attentionItem.related_object_id; }); %>
                        <tr>
                          <td class="small"><%= rel ? rel.name : (a.attentionItem.related_object_type || '—') %></td>
                          <td class="small"><%= a.attentionItem.title %></td>
                          <td class="small"><%= a.attentionItem.category %> &middot; <%= a.attentionItem.priority %></td>
                          <td><span class="state-badge state-<%= a.attentionItem.status.replace(/\s+/g, '-') %>"><%= a.attentionItem.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-evidence" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Supports</th><th>Title</th><th>Category / Confidence</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.evidence.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.evidence.forEach(function(e) { %>
                        <tr>
                          <td class="small"><%= e.relatedObjectLabels.join(', ') || '—' %></td>
                          <td class="small"><%= e.evidence.title %></td>
                          <td class="small"><%= e.evidence.category %> &middot; <%= e.evidence.confidence_level || 'unassessed' %></td>
                          <td><span class="state-badge state-<%= e.evidence.status %>"><%= e.evidence.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-decisions" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.decisions.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.decisions.forEach(function(dec) { %>
                        <tr>
                          <td class="small"><%= dec.relatedObjectLabels.join(', ') || '—' %></td>
                          <td class="small"><%= dec.decision.title %></td>
                          <td class="small"><%= dec.decision.category %></td>
                          <td><span class="state-badge state-<%= dec.decision.status %>"><%= dec.decision.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-knowledge" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Title</th><th>Category / Scope</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.knowledgeItems.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.knowledgeItems.forEach(function(k) { %>
                        <tr>
                          <td class="small"><%= k.deliverableName %></td>
                          <td class="small"><%= k.knowledgeItem.title %></td>
                          <td class="small"><%= k.knowledgeItem.category %> &middot; <%= k.knowledgeItem.acquisition_scope %></td>
                          <td><span class="state-badge state-<%= k.knowledgeItem.status %>"><%= k.knowledgeItem.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-commands" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Command</th><th>Current State</th><th>Status</th><th>My Work Item</th></tr></thead>
                    <tbody>
                      <% if (d.commands.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.commands.forEach(function(cmd) { %>
                        <tr>
                          <td class="small"><%= cmd.entityLabel %><br><span class="text-muted" style="font-size:0.72rem;"><%= cmd.commandType %></span></td>
                          <td><% if (cmd.entityLifecycleState) { %><span class="state-badge state-<%= cmd.entityLifecycleState.replace(/\s+/g, '-') %>"><%= cmd.entityLifecycleState %></span><% } else { %><span class="text-muted small">&mdash;</span><% } %></td>
                          <td><span class="state-badge state-<%= cmd.status %>"><%= cmd.status %></span></td>
                          <td class="small">
                            <% cmd.workItems.forEach(function(wi) { %>
                              <div class="mb-2">
                                <span class="state-badge state-<%= wi.status %>"><%= wi.status %></span><% if (wi.dispatchStrategy) { %> <span class="text-muted" style="font-size:0.7rem;">(<%= wi.dispatchStrategy %>)</span><% } %>
                                <% if (wi.executionContextHtml) { %>
                                  <button type="button" class="btn btn-link btn-sm p-0 align-baseline" style="font-size:0.72rem;" data-bs-toggle="modal" data-bs-target="#executionContextModal" data-template="execution-context-<%= wi.id %>">Instructions</button>
                                  <template id="execution-context-<%= wi.id %>"><%- wi.executionContextHtml %></template>
                            
    <% } %>
                              </div>
                            <% }) %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-external-interactions" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light"><tr><th>Deliverable</th><th>Type / Direction</th><th>Target System</th><th>Status</th></tr></thead>
                    <tbody>
                      <% if (d.externalInteractions.length === 0) { %><tr><td colspan="4" class="text-muted small">None.</td></tr><% } %>
                      <% d.externalInteractions.forEach(function(ei) { %>
                        <tr>
                          <td class="small"><%= ei.deliverableName || '—' %></td>
                          <td class="small"><%= ei.interaction.interaction_type %> &middot; <%= ei.interaction.direction %></td>
                          <td class="small"><%= ei.interaction.target_system %></td>
                          <td><span class="state-badge state-<%= ei.interaction.status.replace(/\s+/g, '-') %>"><%= ei.interaction.status %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="tab-pane fade" id="<%= prefix %>-events" role="tabpanel">
                <div class="table-responsive">
                  <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Type</th><th>Object</th><th>When</th></tr></thead>
                    <tbody>
                      <% if (d.events.length === 0) { %><tr><td colspan="3" class="text-muted small">None.</td></tr><% } %>
                      <% d.events.forEach(function(e) { %>
                        <tr>
                          <td class="small"><code><%= e.event_type %></code></td>
                          <td class="small text-muted"><%= e.originating_object_type %></td>
                          <td class="small text-muted"><%= new Date(e.occurred_at).toLocaleString() %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
          </div>
        </div>

        <%# The action modals of this engagement. Each is its own partial under quickview/actions. %>
        <% var mid = function (k) { return prefix + '-modal-' + k; }; %>
        <% var relIds = function (e) { return e.relationships.map(function (r) { return r.related_object_id; }).join(' '); }; %>
        <% var actionLocals = { d: d, mid: mid, relIds: relIds, urlOf: urlOf, csrfToken: csrfToken, attentionCategoryOptions: locals.attentionCategoryOptions, attentionPriorityOptions: locals.attentionPriorityOptions, decisionCategoryOptions: locals.decisionCategoryOptions, alternativeStatusOptions: locals.alternativeStatusOptions }; %>
        <%- include('actions/_attention', actionLocals) %>
        <%- include('actions/_knowledge', actionLocals) %>
        <%- include('actions/_decision', actionLocals) %>
        <%- include('actions/_evidence', actionLocals) %>
        <%- include('actions/_status', actionLocals) %>
      <% }) %>
      <div class="modal fade" id="executionContextModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title mb-0">Instructions</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body small" id="executionContextModalBody"></div>
          </div>
        </div>
      </div>
      <script>
        (function () {
          var modalEl = document.getElementById('executionContextModal');
          if (!modalEl) return;
          modalEl.addEventListener('show.bs.modal', function (event) {
            var tpl = document.getElementById(event.relatedTarget.getAttribute('data-template'));
            var body = document.getElementById('executionContextModalBody');
            body.innerHTML = tpl ? tpl.innerHTML : '';
            body.querySelectorAll('table').forEach(function (t) { t.classList.add('table', 'table-sm', 'table-bordered', 'align-middle'); });
          });
        })();
      </script>

      <%- include('actions/_script') %>
    <% } %>
