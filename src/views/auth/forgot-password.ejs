<%- include('../partials/head') %>

<style>
  body { background: #f1f5f9; }
  .auth-card {
    max-width: 420px;
    margin: 80px auto;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    padding: 2.5rem 2rem;
  }
  .brand { text-align: center; margin-bottom: 1.75rem; }
  .brand h1 { font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0; }
  .form-control { border-radius: 8px; }
  .btn-primary  { border-radius: 8px; width: 100%; }
</style>

<main>
  <div class="auth-card">
    <div class="brand">
      <h1>📈 CapWise</h1>
    </div>
    <h5 class="mb-1">Forgot password?</h5>
    <p class="text-muted small mb-4">Enter your email and we'll send a reset link if an account exists.</p>

    <% if (locals.info) { %>
      <div class="alert alert-info py-2 small"><%= info %></div>
    <% } %>
    <% if (locals.error) { %>
      <div class="alert alert-danger py-2 small"><%= error %></div>
    <% } %>

    <!-- <form action="/finanaly/auth/forgot-password" method="POST"> -->
    <form action="/aisworg/auth/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-4">
        <label for="email" class="form-label small fw-semibold">Email</label>
        <input type="email" class="form-control" id="email" name="email" required autofocus autocomplete="email">
      </div>
      <button type="submit" class="btn btn-primary">Send reset link</button>
    </form>

    <div class="text-center mt-3">
      <!-- <a href="/finanaly/login" class="text-muted small">Back to sign in</a> -->
      <a href="/aisworg/login" class="text-muted small">Back to sign in</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
