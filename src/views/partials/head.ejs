<%- include('helpers') %>
<meta charset="UTF-8" />
<script>
// Demo bridge — enables /demo/auto-demo.html to navigate and spotlight elements on this page
;(function () {
  function up(type, data) { try { window.parent.postMessage(Object.assign({ type }, data || {}), '*'); } catch (_) {} }
  window.addEventListener('load', function () { up('DEMO_PAGE_READY'); });
  window.addEventListener('message', function (e) {
    if (!e.data || !e.data.type) return;
    if (e.data.type === 'DEMO_FIND_ELEMENT') {
      var el = document.querySelector(e.data.selector);
      if (!el) return;
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function () {
        var r = el.getBoundingClientRect();
        up('DEMO_ELEMENT_FOUND', { rect: { left: r.left, top: r.top, width: r.width, height: r.height } });
      }, 500);
    } else if (e.data.type === 'DEMO_CLICK') {
      var el = document.querySelector(e.data.selector);
      if (el) el.click();
    } else if (e.data.type === 'DEMO_WAIT_UNTIL') {
      var t = setInterval(function () {
        var el = document.querySelector(e.data.selector);
        if (el && (!e.data.text || el.textContent.includes(e.data.text))) { clearInterval(t); up('DEMO_WAIT_COMPLETE'); }
      }, 300);
    }
  });
})();
</script>
<meta name="csrf-token" content="<%= csrfToken %>">
<script>
  // Auto-inject CSRF token into every same-origin fetch with a state-changing method.
  // This covers all POST/PUT/DELETE/PATCH calls in the app without per-call changes.
  (function () {
    const _fetch = window.fetch;
    window.fetch = function (input, init = {}) {
      const method = (init.method || 'GET').toUpperCase();
      if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(method)) {
        const token = document.querySelector('meta[name="csrf-token"]')?.content;
        if (token) {
          init.headers = Object.assign({ 'X-CSRF-Token': token }, init.headers || {});
        }
      }
      return _fetch.call(this, input, init);
    };
  })();
</script>
