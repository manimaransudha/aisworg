  { key: 'verbs',       label: 'Work process',          sub: 'Verbs',                href: '/aisworg/seu/authority/verbs' },
  { key: 'mapping',     label: 'Mapping',               sub: 'Noun + allowed verbs', href: '/aisworg/seu/authority/mapping' },
  { key: 'definitions', label: 'Transition Definition', sub: 'From → To, per verb',  href: '/aisworg/seu/sdk/transition-definition-authoring' },
];
%>
