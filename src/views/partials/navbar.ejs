    <!-- <a class="navbar-brand logo fw-bold" href="/finanaly"><i class="bi bi-graph-up-arrow me-1"></i>SEU Studio</a> -->
    <a class="navbar-brand logo fw-bold" href="/aisworg"><i class="bi bi-graph-up-arrow me-1"></i>SEU Studio</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
