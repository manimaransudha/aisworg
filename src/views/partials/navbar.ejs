              <li><a class="dropdown-item <%= ['seu-objectives','seu-objectives-detail','seu-objectives-new'].includes(currentPage) ? 'active' : '' %>" href="/aisworg/seu/objectives">
                <i class="bi bi-bullseye me-2"></i>Objectives
              </a></li>
              <%# CR-009: Objective creation is contextual (Create Strategic root, or Add child from a node) on the Objectives tree, not a global navbar action. %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item <%= ['seu-seus','seu-seus-detail'].includes(currentPage) ? 'active' : '' %>" href="/aisworg/seu/seus">
                <i class="bi bi-diagram-3 me-2"></i>All SEUs
              </a></li>
              <%# CR-003: SEU commissioning is initiated from the Objectives screen (Commission SEU per Engineering, un-commissioned Objective), not a global navbar action. %>
              <li><a class="dropdown-item <%= currentPage === 'seu-services' ? 'active' : '' %>" href="/aisworg/seu/services">
                <i class="bi bi-hand-index-thumb me-2"></i>Services
              </a></li>
            </ul>
          </li>

          <!-- Governance & Telemetry dropdown — Attention, Telemetry, Engineering Capital -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= ['seu-telemetry','seu-attention','seu-knowledge-capital'].includes(currentPage) ? 'active' : '' %>"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Governance
            </a>
            <%# Commented out dropdown-menu-dark per rule:
            <ul class="dropdown-menu dropdown-menu-dark">
            %>
            <ul class="dropdown-menu shadow-sm border">
              <li><a class="dropdown-item <%= currentPage === 'seu-attention' ? 'active' : '' %>" href="/aisworg/seu/attention">
                <i class="bi bi-bell me-2"></i>Attention
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-telemetry' ? 'active' : '' %>" href="/aisworg/seu/telemetry">
                <i class="bi bi-activity me-2"></i>Telemetry
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-knowledge-capital' ? 'active' : '' %>" href="/aisworg/seu/knowledge/capital">
                <i class="bi bi-bank me-2"></i>Engineering Capital
              </a></li>
            </ul>
          </li>

          <!-- SDK / Authoring dropdown — Pack/Template/Profile/Transition Definition authoring, Schema Registry, Pack Registry -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= ['seu-packs','seu-templates','seu-profiles','seu-deliverable-definitions','seu-sdk-pack-authoring','seu-sdk-template-authoring','seu-sdk-profile-authoring','seu-sdk-transition-definition-authoring','seu-sdk-deliverable-authoring','seu-sdk-schema-registry','seu-sdk-ontology'].includes(currentPage) ? 'active' : '' %>"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              SDK / Authoring
            </a>
            <%# Commented out dropdown-menu-dark per rule:
            <ul class="dropdown-menu dropdown-menu-dark">
            %>
            <ul class="dropdown-menu shadow-sm border">
              <li><a class="dropdown-item <%= currentPage === 'seu-packs' ? 'active' : '' %>" href="/aisworg/seu/packs">
                <i class="bi bi-box-seam me-2"></i>Pack Registry
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-templates' ? 'active' : '' %>" href="/aisworg/seu/templates">
                <i class="bi bi-file-earmark-ruled me-2"></i>Template Registry
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-profiles' ? 'active' : '' %>" href="/aisworg/seu/profiles">
                <i class="bi bi-sliders me-2"></i>Profile Registry
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-deliverable-definitions' ? 'active' : '' %>" href="/aisworg/seu/deliverable-definitions">
                <i class="bi bi-box-seam me-2"></i>Deliverable Registry
              </a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-pack-authoring' ? 'active' : '' %>" href="/aisworg/seu/sdk/pack-authoring">
                <i class="bi bi-file-earmark-code me-2"></i>Pack Authoring
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-template-authoring' ? 'active' : '' %>" href="/aisworg/seu/sdk/template-authoring">
                <i class="bi bi-file-earmark-code me-2"></i>Template Authoring
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-profile-authoring' ? 'active' : '' %>" href="/aisworg/seu/sdk/profile-authoring">
                <i class="bi bi-file-earmark-code me-2"></i>Profile Authoring
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-transition-definition-authoring' ? 'active' : '' %>" href="/aisworg/seu/sdk/transition-definition-authoring">
                <i class="bi bi-file-earmark-code me-2"></i>Transition Definition Authoring
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-deliverable-authoring' ? 'active' : '' %>" href="/aisworg/seu/sdk/deliverable-authoring">
                <i class="bi bi-file-earmark-code me-2"></i>Deliverable Authoring
              </a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-sdk-schema-registry' ? 'active' : '' %>" href="/aisworg/seu/sdk/schema-registry">
                <i class="bi bi-braces me-2"></i>Schema Registry
              </a></li>
