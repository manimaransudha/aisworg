<%- include('loadingOverlay') %>

<!-- Back to Top -->
<button id="backToTop" title="Back to top"
  style="display:none;position:fixed;bottom:1.5rem;right:1.5rem;z-index:1050;
         width:2.4rem;height:2.4rem;border-radius:50%;border:none;
         background:#1e293b;color:#fff;font-size:1rem;line-height:1;
         box-shadow:0 2px 8px rgba(0,0,0,.25);cursor:pointer;
         transition:opacity .2s,transform .2s;opacity:.85;"
  onmouseover="this.style.opacity='1';this.style.transform='translateY(-2px)'"
  onmouseout="this.style.opacity='.85';this.style.transform=''"
  onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <i class="bi bi-chevron-up"></i>
</button>
<script>
(function(){
  const btn = document.getElementById('backToTop');
  window.addEventListener('scroll', function(){
    btn.style.display = window.scrollY > 300 ? 'flex' : 'none';
  }, { passive: true });
  btn.style.alignItems = 'center';
  btn.style.justifyContent = 'center';
})();
</script>

<% if (locals.session?.flash) { %>
  <% const _nf = locals.session.flash; delete locals.session.flash; %>
  <div class="container-fluid px-0">
    <div class="alert alert-<%= _nf.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show mb-0 rounded-0 border-0 border-bottom py-2" role="alert" style="font-size:0.84rem;">
      <div class="container d-flex align-items-center gap-2">
        <i class="bi bi-<%= _nf.type === 'error' ? 'exclamation-circle-fill text-danger' : 'check-circle-fill text-success' %> me-1"></i>
        <%= _nf.message %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>
