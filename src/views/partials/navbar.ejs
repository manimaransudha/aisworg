        <% } /* isGeneral */ %>


        <% if (_isGeneral) { %>
          <!-- Badge model (Phase 10): the identity's name and the Platform-layer
               badge(s) it holds (req.session.user.platformBadges — cached at
               login, design doc §10). Tenant Admin/Engineering badges aren't
               shown here since those are deliberately not session-cached
               (scoped per-request, live-queried instead). -->
          <% const _platformBadges = _u?.platformBadges || []; %>
          <li class="nav-item d-none d-lg-flex align-items-center small me-2">
            <%# Commented out low contrast text-white-50 per rule:
            <span class="me-2 text-white-50">_u?.name || _u?.email</span>
            %>
            <span class="me-2 text-secondary font-weight-medium"><%= _u?.name || _u?.email %></span>
            <% if (_platformBadges.length > 0) { %>
              <% _platformBadges.forEach(function(b) { %>
                <span class="badge bg-secondary-subtle text-dark-emphasis me-1" style="font-weight:600;"><%= b %></span>
              <% }) %>
            <% } %>
          </li>

          <!-- CR-001 — dev-only "Act As" switcher. Rendered ONLY when
               res.locals.devActAs is populated, which happens exclusively for
               the single god identity in a non-production env with the feature
               not switched off (see src/dev/actAs.js). Never present in prod. -->
          <% if (locals.devActAs) { %>
            <% const _da = locals.devActAs;
               const _curBadge = _da.current.badgeType || 'root';
               const _curTenant = _da.current.tenantId; %>
            <li class="nav-item dropdown me-2">
              <a class="nav-link dropdown-toggle text-warning" href="#" role="button"
                 data-bs-toggle="dropdown" aria-expanded="false" title="Dev: act as tenant/badge">
                <i class="bi bi-incognito me-1"></i>Act as:
                <span class="badge bg-warning text-dark ms-1"><%= _curBadge %></span>
              </a>
              <%# Commented out dropdown-menu-dark per rule:
              <div class="dropdown-menu dropdown-menu-dark dropdown-menu-end p-3" style="min-width:20rem;">
              %>
              <div class="dropdown-menu dropdown-menu-end p-3 shadow-sm border" style="min-width:20rem;">
                <div class="small text-warning-emphasis mb-2">
                  <i class="bi bi-exclamation-triangle me-1"></i>Dev impersonation (god user only)
                </div>
                <form method="POST" action="/aisworg/seu/dev/act-as">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                  <label class="form-label small mb-1">Tenant</label>
                  <!-- Changing tenant re-submits so the badge list repopulates
                       for that tenant's vocabulary. -->
                  <select name="tenantId" class="form-select form-select-sm mb-2" onchange="this.form.submit()">
                    <option value="" <%= !_curTenant ? 'selected' : '' %>>— default tenant —</option>
                    <% _da.tenants.forEach(function(t) { %>
                      <option value="<%= t.id %>" <%= _curTenant === t.id ? 'selected' : '' %>><%= t.name %> (<%= t.code %>)</option>
                    <% }) %>
                  </select>
                  <label class="form-label small mb-1">Badge</label>
                  <select name="badgeType" class="form-select form-select-sm mb-2">
                    <option value="root" <%= _curBadge === 'root' ? 'selected' : '' %>>root — full access (reset)</option>
                    <% _da.badgeTypes.forEach(function(bt) { if (bt.code === 'root') return; %>
                      <option value="<%= bt.code %>" <%= _curBadge === bt.code ? 'selected' : '' %>><%= bt.name %> (<%= bt.code %> · <%= bt.scope_kind %>)</option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-sm btn-warning w-100">Apply</button>
                </form>
                <form method="POST" action="/aisworg/seu/dev/act-as/reset" class="mt-2">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Reset to root</button>
                </form>
              </div>
            </li>
          <% } %>

          <!-- Settings / user menu -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= ['settings','stocks','stockListManager','user-management','seu-identity','seu-events'].includes(currentPage) ? 'active' : '' %>"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Settings">
              <% if (_u?.avatar_url) { %>
                <img src="<%= _u.avatar_url %>" width="24" height="24"
                     class="rounded-circle me-1" alt="" style="object-fit:cover;">
              <% } else { %>
                <i class="bi bi-person-circle"></i>
              <% } %>
            </a>
            <%# Commented out dropdown-menu-dark per rule:
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
            %>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border">
              <li class="dropdown-header d-lg-none">
                <%= _u?.name || _u?.email %><% if (_platformBadges.length > 0) { %> &middot; <%= _platformBadges.join(', ') %><% } %>
              </li>
              <li><a class="dropdown-item <%= currentPage === 'seu-identity' ? 'active' : '' %>" href="/aisworg/seu/identity">
                <i class="bi bi-person-badge me-2"></i>Identity Management
              </a></li>
              <% if (_isSuper) { %>
              <li><a class="dropdown-item <%= currentPage === 'settings' ? 'active' : '' %>"href="/aisworg/settings">
                <i class="bi bi-gear me-2"></i>Settings
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'user-management' ? 'active' : '' %>"href="/aisworg/auth/users">
                <i class="bi bi-people me-2"></i>Users
              </a></li>
              <li><a class="dropdown-item <%= currentPage === 'seu-events' ? 'active' : '' %>" href="/aisworg/seu/events">
                <i class="bi bi-broadcast me-2"></i>Event Bus
              </a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/aisworg/auth/logout">
                <i class="bi bi-box-arrow-right me-2"></i>Sign out
              </a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item">
            <!-- <a class="nav-link" href="/finanaly/login">Sign in</a> -->
            <a class="nav-link" href="/aisworg/login">Sign in</a>
          </li>
        <% } %>

      </ul>
    </div>
  </div>
</nav>

<%- include('loadingOverlay') %>

<!-- Back to Top -->
<button id="backToTop" title="Back to top"
  style="display:none;position:fixed;bottom:1.5rem;right:1.5rem;z-index:1050;
         width:2.4rem;height:2.4rem;border-radius:50%;border:none;
         background:#4f46e5;color:#fff;font-size:1rem;line-height:1;
         box-shadow:0 2px 8px rgba(79,70,229,.3);cursor:pointer;
         transition:opacity .2s,transform .2s;opacity:.85;"
  onmouseover="this.style.opacity='1';this.style.transform='translateY(-2px)'"
  onmouseout="this.style.opacity='.85';this.style.transform=''"
  onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <i class="bi bi-chevron-up"></i>
</button>
<script>
(function(){
  const btn = document.getElementById('backToTop');
  window.addEventListener('scroll', function(){
    btn.style.display = window.scrollY > 300 ? 'flex' : 'none';
  }, { passive: true });
  btn.style.alignItems = 'center';
  btn.style.justifyContent = 'center';
})();
</script>

<% if (locals.session?.flash) { %>
  <% const _nf = locals.session.flash; delete locals.session.flash; %>
  <div class="container-fluid px-0">
    <div class="alert alert-<%= _nf.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show mb-0 rounded-0 border-0 border-bottom py-2" role="alert" style="font-size:0.84rem;">
      <div class="container d-flex align-items-center gap-2">
        <i class="bi bi-<%= _nf.type === 'error' ? 'exclamation-circle-fill text-danger' : 'check-circle-fill text-success' %> me-1"></i>
        <%= _nf.message %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>
