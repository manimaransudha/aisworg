<div id="loading-overlay" class="loading-overlay" style="display: none;">
    <div class="loading-content">
        <div class="loader-spinner"></div>
        <div class="loading-text">
            Processing Analysis... <span id="loading-timer">0</span>s
        </div>
        <div class="loading-subtext">This may take a few seconds depending on the data volume.</div>
    </div>
</div>

<style>
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 15, 0.9);
    backdrop-filter: blur(12px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
    color: #ffffff;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

.loading-content {
    text-align: center;
    padding: 40px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

.loader-spinner {
    width: 70px;
    height: 70px;
    border: 4px solid rgba(52, 152, 219, 0.1);
    border-top: 4px solid #3498db;
    border-radius: 50%;
    animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    margin: 0 auto 30px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.loading-text {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.7) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.loading-subtext {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
}

#loading-timer {
    color: #3498db;
    font-variant-numeric: tabular-nums;
    font-weight: 800;
}
</style>

<script>
    (function() {
        let timerInterval;
        const overlay = document.getElementById('loading-overlay');
        const timerSpan = document.getElementById('loading-timer');

        window.showLoadingOverlay = function() {
            if (!overlay) return;
            overlay.style.display = 'flex';
            document.body.style.overflow = 'hidden'; // Prevent scrolling
            
            let seconds = 0;
            timerSpan.textContent = seconds;
            
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                seconds++;
                timerSpan.textContent = seconds;
            }, 1000);
        };

        window.hideLoadingOverlay = function() {
            if (!overlay) return;
            overlay.style.display = 'none';
            document.body.style.overflow = ''; 
            if (timerInterval) clearInterval(timerInterval);
        };

        // Listen for form submissions
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const action = form.getAttribute('action') || '';
            const isSyncAction = action.includes('sync-prices') || 
                               action.includes('sync-market-indices') || 
                               action.includes('/sync') ||
                               action.includes('sync-financials') ||
                               action.includes('/trace?force=true');

            if (isSyncAction) {
                window.showLoadingOverlay();
            }
        });

        // Listen for special sync triggers
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.sync-trigger-btn');
            if (btn) {
                window.showLoadingOverlay();
            }
        });
    })();
</script>
